<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]Dashboard</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * {
            font-family: 'Inter', sans-serif;
           
        }
        
        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 270px;
            background: #080808;
            padding: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: transform 0.3s ease;
            box-shadow: 4px 0 20px rgba(0,0,0,0.15);
        }

        .sidebar-brand {
            padding: 24px 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .sidebar-brand .brand-icon {
                width: 44px;
                height: 44px;
                background: linear-gradient(135deg, #6366f1, #8b5cf6);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: white;
            }

        .logo-box {
            width: 44px;
            height: 44px;
            background: #f40027;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            clip-path: polygon(0 0, 77% 0, 100% 25%, 100% 100%, 20% 100%, 0 75%);
            font-size: 17px;
        }
            .sidebar-brand h3 {
                color: white;
                font-weight: 700;
                font-size: 1.25rem;
                margin: 0;
            }

                .sidebar-brand h3 span {
                    color: red;
                }

        .sidebar-nav {
            flex: 1;
            padding: 20px 16px;
            overflow-y: auto;
        }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 12px 16px;
                border-radius: 12px;
                color: rgba(255,255,255,0.6);
                text-decoration: none;
                font-weight: 500;
                font-size: 0.9rem;
                transition: all 0.2s;
                margin-bottom: 2px;
                position: relative;
            }

                .sidebar-nav .nav-link:hover {
                    background: rgba(255,255,255,0.06);
                    color: white;
                }

                .sidebar-nav .nav-link.active {
                    background: rgba(99,102,241,0.2);
                    color: white;
                }

                    .sidebar-nav .nav-link.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 8px;
                        bottom: 8px;
                        width: 3px;
                        background: #6366f1;
                        border-radius: 0 4px 4px 0;
                    }

                .sidebar-nav .nav-link i {
                    font-size: 1.2rem;
                    width: 24px;
                    text-align: center;
                }

            .sidebar-nav .badge-nav {
                margin-left: auto;
                background: rgba(239,68,68,0.8);
                color: white;
                font-size: 0.65rem;
                padding: 2px 10px;
                border-radius: 40px;
            }

                .sidebar-nav .badge-nav.success {
                    background: rgba(34,197,94,0.7);
                }

        .sidebar-footer {
            padding: 16px 16px 20px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

            .sidebar-footer .logout-btn {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 12px 16px;
                border-radius: 12px;
                color: rgba(255,255,255,0.5);
                text-decoration: none;
                font-weight: 500;
                width: 100%;
                border: none;
                background: transparent;
                cursor: pointer;
            }

                .sidebar-footer .logout-btn:hover {
                    background: rgba(239,68,68,0.15);
                    color: #f87171;
                }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            margin-left: 270px;
            min-height: 100vh;
        }

        /* ===== TOP HEADER ===== */
        .top-header {
            background: #080808;
            padding: 18px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            color:#fff;
            backdrop-filter: blur(8px);
        }

            .top-header .page-title h4 {
                font-weight: 500;
                margin: 0;
                color: #fff;
               
            }

            .top-header .page-title small {
                color: #64748b;
                font-size: 0.8rem;
            }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .user-profile .notif-btn {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                border: 1px solid #e8edf5;
                background: #f8fafc;
                display: flex;
                align-items: center;
                justify-content: center;
                color: red;
                position: relative;
                text-decoration: none;
            }

                .user-profile .notif-btn .dot {
                    position: absolute;
                    top: 8px;
                    right: 8px;
                    width: 8px;
                    height: 8px;
                    background: #ef4444;
                    border-radius: 50%;
                    border: 2px solid white;
                }

            .user-profile .user-info {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 4px 16px 4px 4px;
                border-radius: 60px;
                background: #f8fafc;
                border: 1px solid #e8edf5;
                text-decoration: none;
                color: red;
            }

                .user-profile .user-info img {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    object-fit: cover;
                }

                .user-profile .user-info .name {
                    font-weight: 600;
                    font-size: 0.9rem;
                }

                .user-profile .user-info .role {
                    font-size: 0.7rem;
                    color: #64748b;
                }

        .toggle-sidebar {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #0f172a;
            padding: 4px 8px;
            border-radius: 8px;
        }

            .toggle-sidebar:hover {
                background: #f1f5f9;
            }

        /* ===== CARDS ===== */
        .card-premium {
            background: white;
            border: none;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 2px 12px rgba(0,0,0,0.03);
            transition: all 0.25s ease;
            height: 100%;
        }

            .card-premium:hover {
                box-shadow: 0 12px 32px -8px rgba(0,0,0,0.08);
                transform: translateY(-2px);
            }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .bg-soft-indigo {
            background: #eef2ff;
            color: #4f46e5;
        }

        .bg-soft-emerald {
            background: #ecfdf5;
            color: #059669;
        }

        .bg-soft-amber {
            background: #fffbeb;
            color: #d97706;
        }

        .bg-soft-rose {
            background: #fdf2f2;
            color: #dc2626;
        }

        .stat-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .stat-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #64748b;
        }

        .badge-soft {
            padding: 5px 14px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.7rem;
        }

        .badge-soft-success {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-soft-warning {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-soft-danger {
            background: #fee2e2;
            color: #991b1b;
        }

        .badge-soft-blue {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-soft-purple {
            background: #ede9fe;
            color: #5b21b6;
        }

        .list-item {
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .list-item:last-child {
                border-bottom: none;
            }

        .chart-bars {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            height: 110px;
            margin: 14px 0 8px;
        }

        .chart-bar {
            flex: 1;
            border-radius: 10px 10px 4px 4px;
            background: linear-gradient(180deg, #6366f1, #a78bfa);
            min-height: 20px;
            opacity: 0.85;
            transition: 0.3s;
        }

            .chart-bar:hover {
                opacity: 1;
            }

        .chart-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 999;
        }

            .sidebar-overlay.show {
                display: block;
            }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .toggle-sidebar {
                display: block;
            }

            .top-header {
                padding: 12px 20px;
            }

            .page-content {
                padding: 20px;
            }
        }

        @@media (max-width: 576px) {
            .top-header .page-title small {
                display: none;
            }

            .stat-number {
                font-size: 1.4rem;
            }

            .card-premium {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>

    <!-- Overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ===== SIDEBAR (Fixed) ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="logo-box"><i class="bi bi-lightning-fill"></i></div>
            <h3>Admin<span>Hub</span></h3>
        </div>
        <nav class="sidebar-nav">
            <!-- Dashboard Link -->
            <a asp-controller="Admin" asp-action="Index" class="nav-link active">
                <i class="bi bi-house-fill"></i> Dashboard
            </a>
           
            <!-- Other Links -->
            <a asp-action="Career" class="nav-link"> <i class="bi bi-person-badge"></i> Career <span class="badge-nav">3</span> </a>
            <a asp-action="Blog" class="nav-link"> <i class="bi bi-journal-text"></i> Blog </a>
            <a asp-action="Projects" class="nav-link"> <i class="bi bi-folder"></i> Project </a>
            <a asp-action="Contact" class="nav-link"> <i class="bi bi-envelope"></i> Contact </a>
        </nav>
        <div class="sidebar-footer">
            <form asp-controller="Home"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>

            </form>
        </div>
    </aside>

    <!-- ===== MAIN WRAPPER ===== -->
    <div class="main-content">
        <!-- Top Header -->
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button class="toggle-sidebar" id="toggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="page-title">
                    <h4>Heyy Admin</h4>
                    <small>Welcome you!!</small>
                </div>
            </div>
            <div class="user-profile">
                <a href="#" class="notif-btn">
                    <i class="bi bi-bell"></i>
                    <span class="dot"></span>
                </a>
                <a href="#" class="user-info">
                    <img src="https://www.shutterstock.com/image-photo/smile-office-laptop-business-man-260nw-2417739665.jpg" class="img" alt="Profile" />
                    <div class="details">
                        <div class="name">Access Authority</div>
                        <div class="role">Admin</div>
                    </div>
                    
                </a>
            </div>
        </header>

        <!-- Content Area (YAHAN PAGE KA CONTENT AAYEGA) -->
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar Toggle Logic
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleBtn = document.getElementById('toggleSidebar');

        function openSidebar() {
            sidebar.classList.add('open');
            overlay.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeSidebar() {
            sidebar.classList.remove('open');
            overlay.classList.remove('show');
            document.body.style.overflow = '';
        }

        toggleBtn.addEventListener('click', openSidebar);
        overlay.addEventListener('click', closeSidebar);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });
        window.addEventListener('resize', () => { if (window.innerWidth > 992) closeSidebar(); });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>