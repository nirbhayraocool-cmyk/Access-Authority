<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Access Authority</title>
     
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
     
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link href="~/style.css" rel="stylesheet" />
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg aa-navbar fixed-top">

            <div class="container px-5">

                <!-- LOGO -->

                <a class="navbar-brand d-flex align-items-center gap-2" asp-action="Index">

                    <span class="logo-box">
                        <i class="bi bi-lightning-fill"></i>
                    </span>

                    <span class="logo-text">
                        Access<span>Authority</span>
                    </span>

                </a>

                <!-- MOBILE BUTTON -->

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <!-- MENU -->

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <!-- SERVICES -->

                        <li class="nav-item dropdown aa-mega">

                            <a class="nav-link nav-link-custom dropdown-toggle" asp-action="Services" data-bs-toggle="dropdown">
                                Services
                            </a>

                            <div class="aa-dropdown">
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-globe2"></i></div>
                                            <div>
                                                <a asp-action="webDevlopment" style="text-decoration:none">
                                                    <h6 class="text-dark">Web Development</h6>
                                                    <p>Custom websites & web apps</p>
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-diagram-3"></i></div>
                                            <div>
                                                <a asp-action="ERPDevlopment" style="text-decoration:none">
                                                    <h6 class="text-dark">ERP Development</h6>
                                                    <p>Enterprise resource planning</p>
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-code-slash"></i></div>
                                            <div>
                                                <a asp-action="CustomSoftware" style="text-decoration:none">
                                                    <h6 class="text-dark">Custom Software</h6>
                                                    <p>Tailored business solutions</p>
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-phone"></i></div>
                                            <div>
                                                <a asp-action="MobileApps" style="text-decoration:none">
                                                    <h6 class="text-dark">Mobile Apps</h6>
                                                    <p>iOS & Android development</p>
                                                </a>
                                               
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-bezier2"></i></div>
                                            <div>
                                                <a asp-action="UIUXDisign" style="text-decoration:none">
                                                    <h6 class="text-dark">UI/UX Design</h6>
                                                    <p>Research-driven interfaces</p>
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="aa-item">
                                            <div class="aa-icon"><i class="bi bi-camera-video"></i></div>
                                            <div>
                                                <a asp-action="VideoProduction" style="text-decoration:none">
                                                    <h6 class="text-dark">Video Production</h6>
                                                    <p>Marketing & training videos</p>
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </li>

                        <!-- Projects -->

                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-action="Portfolio">Projects</a>
                        </li>

                        <!-- COMPANY -->

                        <li class="nav-item dropdown aa-company">

                            <a class="nav-link nav-link-custom dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                Company
                            </a>

                            <div class="aa-company-dropdown">
                                <a asp-action="AboutUs" class="aa-company-item">
                                    <div class="aa-company-icon"><i class="bi bi-building"></i></div>
                                    <span>About Us</span>
                                </a>
                                <a asp-action="Team" class="aa-company-item">
                                    <div class="aa-company-icon"><i class="bi bi-people-fill"></i></div>
                                    <span>Our Team</span>
                                </a>
                                <a asp-action="Career" class="aa-company-item">
                                    <div class="aa-company-icon"><i class="bi bi-briefcase-fill"></i></div>
                                    <span>Careers</span>
                                </a>
                            </div>

                        </li>

                        <!-- PRODUCTS -->

                        <li class="nav-item dropdown aa-product">

                            <a class="nav-link nav-link-custom dropdown-toggle"
                               asp-action="product"
                               data-bs-toggle="dropdown">

                                Products

                            </a>


                            <div class="aa-product-dropdown">

                                <a asp-action="ERPDevlopment" class="aa-product-item">
                                    <div class="aa-product-icon">
                                        <i class="bi bi-box-seam-fill"></i>
                                    </div>
                                    <span>AccessERP™</span>
                                </a>

                                <a asp-action="CustomSoftware" class="aa-product-item">
                                    <div class="aa-product-icon">
                                        <i class="bi bi-chat-square-text-fill"></i>
                                    </div>
                                    <span>AccessCRM™</span>
                                </a>

                                <a asp-action="Projects" class="aa-product-item">
                                    <div class="aa-product-icon">
                                        <i class="bi bi-cpu-fill"></i>
                                    </div>
                                    <span>AccessAI™</span>
                                </a>

                            </div>

                        </li>


                        <!-- BLOG -->

                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-action="Blog" >Blog</a>
                        </li>

                        <!-- CONTACT -->

                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-action="Contact">Contact</a>
                        </li>

                        <!-- CONSULTATION -->

                        <li class="nav-item ms-lg-3">
                            <a href="tel:+918874196809" class="btn consult-btn">
                                FREE CONSULTATION
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>
    <div class="">
        
            @RenderBody()
        
    </div>

    <!-- =========================================
         WHATSAPP
    ========================================= -->

    <a href="https://wa.me/918874196809"
       class="project-whatsapp"
       target="_blank"
       aria-label="Chat on WhatsApp">

        <i class="bi bi-whatsapp"></i>

    </a>

    <!--  FOOTER-->

    <footer class="bg-dark text-white pt-5 pb-3 ">
        <div class="container px-4">

            <div class="row g-4">

                <!-- LEFT -->

                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand" >
                        <div >
                            <a asp-action="Index" style="text-decoration:none;color:white">Access&nbsp;<span>Authority</span></a>
                        </div>
                    </div>
                    <p class="footer-desc mt-2 ">
                        Building digital authority through smart technology. We help businesses transform, scale, and
                        lead in their markets.
                    </p>
                    <div class="mt-2">

                        <a href="https://www.instagram.com/" style="text-decoration:none">
                                <span class="badge bg-secondary text-light" style="font-size: 11px; opacity: 0.8; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; ">
                                    <i class="bi bi-instagram"></i>
                                </span>
                            </a>

                        <a href="https://www.linkedin.com/" class="social-link" style="text-decoration:none">
                            <span class="badge bg-secondary text-light" style="font-size: 11px; opacity: 0.8; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; ">
                                <i class="bi bi-linkedin"></i>
                            </span>
                        </a>
                        <a href="https://www.facebook.com/" style="text-decoration:none">
                            <span class="badge bg-secondary text-light" style="font-size: 11px; opacity: 0.8; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; ">
                                <i class="bi bi-facebook"></i>
                            </span>
                        </a>

                        <a href="https://x.com/" class="social-link" style="text-decoration:none">
                            <span class="badge bg-secondary text-light" style="font-size: 11px; opacity: 0.8; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px;">
                                <i class="bi bi-twitter-x"></i>
                            </span>
                        </a>
                        <div class="mt-3">
                            <a asp-action="LogIn" class="admin-login-link">
                                <i class="bi bi-shield-lock"></i>
                                <span>Admin Login</span>
                            </a>
                        </div>
                        </div>
                </div>

                <!-- SERVICES -->

                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-heading">SERVICES</h6>
                    <ul class="footer-list">
                        <li><a asp-action="webDevlopment">Web Development</a></li>
                        <li><a asp-action="ERPDevelopment">ERP Development</a></li>
                        <li><a asp-action="CustomSoftware">Custom Software</a></li>
                        <li><a asp-action="MobileApps">Mobile Apps</a></li>
                        <li><a asp-action="UIUXDisign">UI/UX Design</a></li>
                        <li><a asp-action="VideoProduction">Video Production</a></li>
                    </ul>
                </div>

                <!-- COMPANY -->

                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-heading">COMPANY</h6>
                    <ul class="footer-list">
                        <li><a asp-action="AboutUs">About Us</a></li>
                        <li><a asp-action="Projects">Projects</a></li>
                        <li><a asp-action="Blog">Blog</a></li>
                        <li><a asp-action="Career">Careers</a></li>
                        <li><a asp-action="Contact">Contact</a></li>
                    </ul>
                </div>

                <!-- CONTACT + MAP -->

                <div class="col-lg-4 col-md-6">
                    <h6 class="footer-heading">CONTACT</h6>
                    <div class="contact-item">
                        <i class="bi bi-geo-alt"></i> Uttar Pradesh, India
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-envelope"></i> hello@accessauthority.com
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-phone"></i> +91 8874196809
                    </div>

                    <div class="map-placeholder">
                        <iframe src="https://www.google.com/maps/embed?pb=YOUR_MAP_EMBED_CODE"
                                
                                style="border:0;height:100%;width:100%"
                                allowfullscreen=""
                                loading="lazy">
                        </iframe>
                        <div style="font-weight: 200; color: rgba(255,255,255,0.8);">Infinity Tower, Kanpur</div>
                        <div class="map-text">Map data ©2026 Terms Report a map error</div>
                    </div>

                </div>

            </div>

            <!-- BOTTOM -->

            <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center">
                <span>© 2026 Access Authority. All rights reserved.</span>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-action="Policy">Privacy Policy</a>
                    <a asp-action="Services">Terms of Service</a>
                    <a asp-action="Contact">Contact</a>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="cert-badge">SSL SECURED</span>
                    <span class="cert-badge">GDPR READY</span>
                    <span class="cert-badge">ISO 9001</span>
                </div>
            </div>

        </div>
    </footer>
    <script src="~/slide.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"> </script>
    
</body>
</html>
