@{
    Layout = "_Layout1";
}

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
   
    #editor-container .ql-editor {
        min-height: 200px;
        background-color: #212529;
        color: #e0e0e0;
    }

    #editor-container .ql-toolbar {
        background-color: #1c1c1c;
        border-color: #2a2a2a;
        border-radius: 0.375rem 0.375rem 0 0;
    }

    #editor-container .ql-container {
        border-color: #2a2a2a;
        border-radius: 0 0 0.375rem 0.375rem;
    }

    #editor-container .ql-stroke {
        stroke: #e0e0e0;
    }

    #editor-container .ql-fill {
        fill: #e0e0e0;
    }

    #editor-container .ql-picker {
        color: #e0e0e0;
    }

    #editor-container .ql-picker-options {
        background-color: #1c1c1c;
        border-color: #2a2a2a;
    }

    #editor-container .ql-picker-item:hover,
    #editor-container .ql-picker-item.ql-selected {
        background-color: #2a2a2a;
    }

    #editor-container .ql-editor.ql-blank::before {
        color: #6c757d;
        font-style: italic;
    }

    #editor-container .ql-editor p {
        color: #e0e0e0;
    }
    /* Fix link input in the modal */
    .ql-snow .ql-tooltip input[type=text] {
        background-color: #2a2a2a;
        color: #e0e0e0;
        border: 1px solid #2a2a2a;
    }
</style>
<body class="bg-dark">
<div class="card bg-dark text-white border-secondary rounded-3 p-4">

    <div class="card-body p-0">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>
            <h4 class="fw-bold mb-1 text-danger">
                <i class="bi bi-pencil-square text-primary me-2"></i>
                Create New Blog Post
            </h4>

            <p class="text-secondary mb-0">
                Fill in the details below and publish your article.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Blog"
           class="btn btn-outline-light px-3 py-2">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Blogs
        </a>

    </div>

</div>
    <form id="blogForm"
          asp-controller="Admin"
          asp-action="CreateBlog"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        
        <div class="mb-3">
            <label for="title" class="form-label text-light-emphasis">Post Title *</label>
            <input type="text"
                   class="form-control bg-dark text-white border-secondary"
                   id="title"
                   name="Title"
                   placeholder="Enter blog title..."
                   required />
        </div>

        <!-- Category + Status -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="category" class="form-label text-light-emphasis">Category *</label>
                <select class="form-select bg-dark text-white border-secondary"
                        id="category"
                        name="Category"
                        required>
                    <option value="" disabled selected>Choose…</option>
                    <option value=".net technology">.NET DEVELOPER</option>
                    <option value="java technology">JAVA FULLSTACK </option>
                    <option value="mern technology">MERN STACK</option>
                    <option value="next js ">NEXT JS</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="status" class="form-label text-light-emphasis">Status</label>
                <select class="form-select bg-dark text-white border-secondary"
                        id="status"
                        name="Status">
                    <option value="draft" >Draft</option>
                    <option value="published"selected>Published</option>
                    <option value="pending">Pending</option>
                </select>
            </div>
        </div>

        <!-- Featured Image -->
        <div class="mb-3">
            <label for="image" class="form-label text-light-emphasis">Featured Image</label>
            <input type="file"
                   class="form-control bg-dark text-white border-secondary"
                   id="image"
                   name="image"
                   accept="image/*" />
        </div>

        <!-- ====== QUILL EDITOR (replaces Summernote textarea) ====== -->
        <div class="mb-3">
            <label class="form-label text-light-emphasis">Content *</label>
            <div id="editor-container" class="border border-secondary rounded">
               
            </div>
            <input type="hidden" id="content" name="Content" />
        </div>

        <!-- Tags -->
        <div class="mb-3">
            <label for="tags" class="form-label text-light-emphasis">Tags</label>
            <input type="text"
                   class="form-control bg-dark text-white border-secondary"
                   id="tags"
                   name="Tags"
                   placeholder="AI, music, tutorial (comma separated)" />
        </div>

        <!-- Buttons -->
        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top border-secondary">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg"></i> Publish
            </button>
            <button type="button" class="btn btn-outline-secondary px-4" onclick="saveDraft()">
                <i class="bi bi-save"></i> Draft
            </button>
            <button type="reset" class="btn btn-outline-danger px-4">
                <i class="bi bi-arrow-counterclockwise"></i> Clear
            </button>
        </div>

    </form>
</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var quill = new Quill('#editor-container', {
            theme: 'snow',

            placeholder: 'Write your blog content here…',

            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                    [{ 'font': [] }],
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'script': 'sub' }, { 'script': 'super' }],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'indent': '-1' }, { 'indent': '+1' }],
                    [{ 'align': [] }],
                    [{ 'direction': 'rtl' }],
                    ['link', 'image', 'video'],
                    ['clean']
                ]
            }
        });

        window.quill = quill;

        // ==========================
        // FORM SUBMIT
        // ==========================

        document.getElementById('blogForm').addEventListener('submit', function (e) {

            const title = document.getElementById('title').value.trim();
            const content = quill.root.innerHTML;

            if (!title) {
                e.preventDefault();
                alert('Please enter blog title.');
                return;
            }

            if (!content || content === '<p><br></p>') {
                e.preventDefault();
                alert('Please enter blog content.');
                return;
            }

            // Quill content hidden input me save hoga
            document.getElementById('content').value = content;

            console.log("Title:", title);
            console.log("Content:", content);

        });

    });


    // ==========================
    // DRAFT
    // ==========================

    function saveDraft() {

        const title = document.getElementById('title').value.trim();
        const content = window.quill.root.innerHTML;

        if (!title) {
            alert('Please enter blog title.');
            return;
        }

        if (!content || content === '<p><br></p>') {
            alert('Please enter blog content.');
            return;
        }

        document.getElementById('content').value = content;
        document.getElementById('status').value = 'draft';

        document.getElementById('blogForm').submit();
    }
</script>