@model List<Access_Authority.Models.Project>

@{
    ViewData["Title"] = "Projects";
    Layout = "_Layout1";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalProjects = ViewBag.TotalProjects ?? (Model?.Count ?? 0);
}

<style>
    /* =========================================
           PROJECT PAGE
        ========================================= */
    .projects-page {
        min-height: 100vh;
        color: #fff;
        padding: 30px;
        width: 100%;
        box-sizing: border-box;
    }

    /* =========================================
           HEADER
        ========================================= */
    .projects-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .projects-heading h2 {
        margin: 0;
        color: #E0A458;
        font-size: 30px;
        font-weight: 700;
    }

    .projects-heading p {
        margin: 7px 0 0;
        color: #858c98;
        font-size: 14px;
    }

    /* =========================================
           ADD PROJECT
        ========================================= */
    .btn-add-project {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        background: #E0A458;
        color: #10131A;
        border: 1px solid #E0A458;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
    }

        .btn-add-project:hover {
            background: transparent;
            color: #E0A458;
        }

    /* =========================================
           COUNT
        ========================================= */
    .project-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #8d95a3;
        font-size: 13px;
        margin-bottom: 15px;
    }

        .project-count strong {
            color: #E0A458;
        }

    /* =========================================
           TABLE CARD
        ========================================= */
    .project-table-card {
        width: 100%;
        background: #171B24;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 12px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .project-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    /* =========================================
           TABLE (desktop)
        ========================================= */
    .project-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
        table-layout: auto;
    }

        .project-table thead {
            background: #1D222C;
        }

        .project-table th {
            padding: 14px 10px;
            color: #E0A458;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,.08);
            text-align: left;
            white-space: nowrap;
        }

        .project-table td {
            padding: 14px 10px;
            color: #c3c8d0;
            font-size: 13px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            vertical-align: middle;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .project-table tbody tr {
            transition: .2s;
        }

            .project-table tbody tr:hover {
                background: #1C212B;
            }

            .project-table tbody tr:last-child td {
                border-bottom: none;
            }

        /* COLUMN SPECIFIC */
        .project-table th:nth-child(1),
        .project-table td:nth-child(1) {
            width: 45px;
            text-align: center;
        }

        .project-table th:nth-child(2),
        .project-table td:nth-child(2) {
            width: 90px;
            text-align: center;
        }

        .project-table td:nth-child(3) {
            min-width: 140px;
        }

        .project-table td:nth-child(5) {
            min-width: 180px;
        }

        .project-table th:last-child,
        .project-table td:last-child {
            text-align: center;
            width: 90px;
        }

    /* =========================================
           IMAGE
        ========================================= */
    .project-image {
        width: 60px;
        height: 42px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,.08);
        display: block;
        margin: auto;
    }

    .project-image-placeholder {
        width: 60px;
        height: 42px;
        border-radius: 6px;
        background: #10131A;
        color: #626a77;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
    }

    /* =========================================
           TITLE
        ========================================= */
    .project-title {
        color: #fff;
        font-weight: 600;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    /* =========================================
           CATEGORY
        ========================================= */
    .category-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: rgba(224,164,88,.10);
        color: #E0A458;
        border: 1px solid rgba(224,164,88,.18);
        font-size: 11px;
        white-space: nowrap;
    }

    /* =========================================
           DESCRIPTION
        ========================================= */
    .description-text {
        color: #9299a5;
        line-height: 1.45;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    /* =========================================
           ACTION BUTTONS
        ========================================= */
    .btn-project-view,
    .btn-project-delete {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        transition: .25s;
        padding: 0;
        cursor: pointer;
        box-sizing: border-box;
        font-size: 14px;
        vertical-align: middle;
        line-height: 1;
        flex-shrink: 0;
    }

    .btn-project-view {
        color: #E0A458;
        border: 1px solid rgba(224,164,88,.35);
        background: rgba(224,164,88,.08);
        text-decoration: none;
    }

        .btn-project-view:hover {
            background: #E0A458;
            color: #10131A;
        }

    .btn-project-delete {
        color: #C6614E;
        border: 1px solid rgba(198,97,78,.35);
        background: rgba(198,97,78,.08);
    }

        .btn-project-delete:hover {
            background: #C6614E;
            color: #fff;
        }

    .project-table td:last-child {
        white-space: nowrap;
        vertical-align: middle !important;
    }

        .project-table td:last-child .action-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            vertical-align: middle;
        }

        .project-table td:last-child form {
            display: inline-flex;
            align-items: center;
            margin: 0;
            padding: 0;
            vertical-align: middle;
        }

        .project-table td:last-child .btn-project-view,
        .project-table td:last-child .btn-project-delete {
            margin: 0;
        }

    /* =========================================
           PAGINATION
        ========================================= */
    .project-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 20px;
        background: #171B24;
        border-top: 1px solid rgba(255,255,255,.06);
        flex-wrap: wrap;
    }

    .pagination-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 6px;
        border: 1px solid rgba(224,164,88,.25);
        background: rgba(224,164,88,.06);
        color: #c3c8d0;
        text-decoration: none;
        font-size: 13px;
        transition: .25s;
        box-sizing: border-box;
    }

        .pagination-btn:hover {
            background: #E0A458;
            border-color: #E0A458;
            color: #10131A;
        }

        .pagination-btn.active {
            background: #E0A458;
            border-color: #E0A458;
            color: #10131A;
            font-weight: 700;
        }

    /* =========================================
           EMPTY
        ========================================= */
    .empty-projects {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-projects-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: rgba(224,164,88,.08);
        color: #E0A458;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .empty-projects h4 {
        color: #fff;
        font-size: 20px;
        margin-bottom: 8px;
    }

    .empty-projects p {
        color: #777f8d;
        margin-bottom: 22px;
    }

    /* =========================================
           MOBILE — CARD LAYOUT
        ========================================= */
    @@media (max-width: 768px) {

        .projects-page {
            padding: 15px;
        }

        .projects-heading h2 {
            font-size: 24px;
        }

        .projects-heading p {
            font-size: 13px;
        }

        .btn-add-project {
            width: 100%;
            justify-content: center;
        }

        .project-table-wrapper {
            overflow: visible;
        }

        .project-table-card {
            background: transparent;
            border: none;
            border-radius: 0;
        }

        .project-table thead {
            display: none;
        }

        .project-table,
        .project-table tbody {
            display: block;
            width: 100%;
        }
            /* Each row = card */
            .project-table tbody tr {
                display: flex !important;
                flex-wrap: wrap !important;
                background: #1f1f1f !important;
                border: 1px solid #2a2a2a !important;
                border-radius: 12px !important;
                margin: 0 0 14px 0 !important;
                padding: 0 !important;
                overflow: hidden !important;
                box-shadow: 0 2px 8px rgba(0,0,0,0.3) !important;
            }
                /* Default td = info row */
                .project-table tbody tr td {
                    display: flex !important;
                    justify-content: space-between !important;
                    align-items: center !important;
                    width: 100% !important;
                    padding: 10px 16px !important;
                    margin: 0 !important;
                    border: none !important;
                    border-bottom: 1px solid rgba(255,255,255,0.06) !important;
                    text-align: right !important;
                    font-size: 13px !important;
                    line-height: 1.45 !important;
                    min-height: 44px !important;
                    background: transparent !important;
                    color: #c8c8c8 !important;
                    box-sizing: border-box !important;
                    word-break: break-word !important;
                    overflow-wrap: anywhere !important;
                }
                    /* Hide serial */
                    .project-table tbody tr td:nth-child(1) {
                        display: none !important;
                    }
                    /* Image cell */
                    .project-table tbody tr td:nth-child(2) {
                        flex: 0 0 118px !important;
                        width: 118px !important;
                        padding: 16px 0 16px 16px !important;
                        background: rgba(224,164,88,0.08) !important;
                        border-bottom: none !important;
                        justify-content: center !important;
                        align-items: center !important;
                        min-height: auto !important;
                        text-align: center !important;
                    }

                        .project-table tbody tr td:nth-child(2)::before {
                            display: none !important;
                        }

                        .project-table tbody tr td:nth-child(2) .project-image,
                        .project-table tbody tr td:nth-child(2) .project-image-placeholder {
                            width: 88px !important;
                            height: 88px !important;
                            border-radius: 12px !important;
                            margin: 0 !important;
                            object-fit: cover !important;
                            border: 1px solid rgba(255,255,255,.08) !important;
                        }

                        .project-table tbody tr td:nth-child(2) .project-image-placeholder {
                            font-size: 28px !important;
                        }
                    /* Title cell */
                    .project-table tbody tr td:nth-child(3) {
                        flex: 1 1 calc(100% - 118px) !important;
                        width: calc(100% - 118px) !important;
                        padding: 18px 16px 18px 14px !important;
                        background: rgba(224,164,88,0.08) !important;
                        border-bottom: 1px solid #2a2a2a !important;
                        text-align: left !important;
                        justify-content: flex-start !important;
                        align-items: center !important;
                        min-height: auto !important;
                    }

                        .project-table tbody tr td:nth-child(3)::before {
                            display: none !important;
                        }

                        .project-table tbody tr td:nth-child(3) .project-title {
                            font-size: 16px !important;
                            font-weight: 700 !important;
                            color: #fff !important;
                            line-height: 1.35 !important;
                        }
                    /* data-label */
                    .project-table tbody tr td[data-label]::before {
                        content: attr(data-label) !important;
                        font-size: 10.5px !important;
                        font-weight: 700 !important;
                        color: #E0A458 !important;
                        text-transform: uppercase !important;
                        letter-spacing: 0.7px !important;
                        text-align: left !important;
                        flex-shrink: 0 !important;
                        margin-right: 12px !important;
                    }

        .description-text {
            font-size: 12.5px !important;
            color: #c8c8c8 !important;
            line-height: 1.4 !important;
            text-align: right !important;
            max-width: 65% !important;
            margin-left: auto !important;
        }

        .category-badge {
            font-size: 11px !important;
            padding: 4px 10px !important;
        }
        /* Action cell — centered */
        .project-table tbody tr td:nth-child(8) {
            flex: 0 0 100% !important;
            width: 100% !important;
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 10px !important;
            padding: 12px 16px !important;
            background: rgba(0,0,0,0.2) !important;
            border-top: 1px solid #2a2a2a !important;
            border-bottom: none !important;
            min-height: auto !important;
            white-space: nowrap !important;
        }

            .project-table tbody tr td:nth-child(8)::before {
                display: none !important;
            }

            .project-table tbody tr td:nth-child(8) .action-wrapper {
                display: flex !important;
                gap: 10px !important;
                align-items: center !important;
                justify-content: center !important;
                width: auto !important;
            }

                .project-table tbody tr td:nth-child(8) .action-wrapper > a,
                .project-table tbody tr td:nth-child(8) .action-wrapper > form {
                    flex: 0 0 auto !important;
                    width: auto !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    display: inline-flex !important;
                    align-items: center !important;
                }

            .project-table tbody tr td:nth-child(8) .btn-project-view,
            .project-table tbody tr td:nth-child(8) .btn-project-delete {
                width: auto !important;
                min-width: 82px !important;
                height: 38px !important;
                padding: 0 12px !important;
                gap: 5px !important;
                font-size: 13px !important;
                font-weight: 600 !important;
                border-radius: 8px !important;
                margin: 0 !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
            }

                .project-table tbody tr td:nth-child(8) .btn-project-view::after {
                    content: 'View';
                    margin-left: 4px;
                }

                .project-table tbody tr td:nth-child(8) .btn-project-delete::after {
                    content: 'Delete';
                    margin-left: 4px;
                }
        /* Pagination */
        .project-pagination {
            padding: 16px 8px;
            gap: 5px;
            background: #171B24;
            border-radius: 12px;
            margin-top: 8px;
        }

        .pagination-btn {
            min-width: 34px;
            height: 34px;
            font-size: 12px;
            padding: 0 10px;
        }
    }

    /* =========================================
           EXTRA SMALL (<= 400px)
        ========================================= */
    @@media (max-width: 400px) {
        .projects-page {
            padding: 10px;
        }

        .project-table tbody tr {
            margin-bottom: 10px;
        }

            .project-table tbody tr td {
                padding: 9px 12px !important;
                font-size: 12px !important;
            }
                /* Image cell */
                .project-table tbody tr td:nth-child(2) {
                    flex: 0 0 100px !important;
                    width: 100px !important;
                    padding: 14px 0 14px 12px !important;
                }

                    .project-table tbody tr td:nth-child(2) .project-image,
                    .project-table tbody tr td:nth-child(2) .project-image-placeholder {
                        width: 76px !important;
                        height: 76px !important;
                    }

                    .project-table tbody tr td:nth-child(2) .project-image-placeholder {
                        font-size: 24px !important;
                    }
                /* Title cell */
                .project-table tbody tr td:nth-child(3) {
                    flex: 1 1 calc(100% - 100px) !important;
                    width: calc(100% - 100px) !important;
                    padding: 16px 12px 16px 10px !important;
                }

                    .project-table tbody tr td:nth-child(3) .project-title {
                        font-size: 15px !important;
                    }

                .project-table tbody tr td[data-label]::before {
                    font-size: 10px !important;
                }

        .description-text {
            font-size: 11.5px !important;
            max-width: 60% !important;
        }
        /* Action cell */
        .project-table tbody tr td:nth-child(8) {
            justify-content: center !important;
            gap: 8px !important;
            padding: 10px 12px !important;
        }

            .project-table tbody tr td:nth-child(8) .action-wrapper {
                justify-content: center !important;
                width: auto !important;
            }

            .project-table tbody tr td:nth-child(8) .btn-project-view,
            .project-table tbody tr td:nth-child(8) .btn-project-delete {
                min-width: 74px !important;
                height: 36px !important;
                font-size: 12px !important;
                padding: 0 10px !important;
            }

        .pagination-btn {
            min-width: 30px;
            height: 30px;
            font-size: 11px;
            padding: 0 8px;
        }
    }
</style>
<body class="bg-dark">
<div class="projects-page">

    <!-- =========================================
         HEADER
    ========================================= -->
    <div class="projects-header">
        <div class="projects-heading">
            <h2>Projects</h2>
            <p>Manage your projects and case studies</p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateProject"
           class="btn-add-project">
            <i class="bi bi-plus-lg"></i>
            Add Project
        </a>
    </div>

    <!-- =========================================
         COUNT
    ========================================= -->
    <div class="project-count">
        <i class="bi bi-folder2-open"></i>
        Total Projects:
        <strong>@totalProjects</strong>
    </div>

    <!-- =========================================
         TABLE
    ========================================= -->
    <div class="project-table-card">

        @if (Model != null && Model.Any())
        {
            <div class="project-table-wrapper">
                <table class="project-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Project</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Client</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int serialNo = (currentPage - 1) * pageSize + 1;
                        }

                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>@serialNo</td>

                                <!-- IMAGE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(project.HeroImage))
                                    {
                                        <img src="@project.HeroImage"
                                             alt="@project.Title"
                                             class="project-image" />
                                    }
                                    else
                                    {
                                        <div class="project-image-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>

                                <!-- PROJECT TITLE -->
                                <td>
                                    <div class="project-title">@project.Title</div>
                                </td>

                                <!-- CATEGORY -->
                                <td data-label="Category">
                                    <span class="category-badge">
                                        @(string.IsNullOrWhiteSpace(project.Category) ? "-" : project.Category)
                                    </span>
                                </td>

                                <!-- DESCRIPTION -->
                                <td data-label="Description">
                                    <div class="description-text">
                                        @if (!string.IsNullOrWhiteSpace(project.ShortDescription))
                                        {
                                            if (project.ShortDescription.Length > 90)
                                            {
                                                @project.ShortDescription.Substring(0, 90)
                                                <span>...</span>
                                            }
                                            else
                                            {
                                                @project.ShortDescription
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </div>
                                </td>

                                <!-- CLIENT -->
                                <td data-label="Client">
                                    @(string.IsNullOrWhiteSpace(project.Client) ? "-" : project.Client)
                                </td>

                                <!-- CREATED -->
                                <td data-label="Created">
                                    @project.CreatedDate.ToString("dd-MM-yyyy")
                                </td>

                                <!-- ACTION -->
                                <td>
                                    <div class="action-wrapper">

                                        <!-- VIEW -->
                                        <a asp-controller="Home"
                                           asp-action="ProjectDetail"
                                           asp-route-id="@project.Id"
                                           class="btn-project-view"
                                           title="View Project">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <!-- DELETE -->
                                        <form asp-controller="Admin"
                                              asp-action="DeleteProject"
                                              asp-route-id="@project.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn-project-delete"
                                                    title="Delete Project">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>

                            serialNo++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <div class="project-pagination">
                    @if (currentPage > 1)
                    {
                        <a asp-controller="Admin"
                           asp-action="Projects"
                           asp-route-page="@(currentPage - 1)"
                           class="pagination-btn">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </a>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="pagination-btn active">@i</span>
                        }
                        else
                        {
                            <a asp-controller="Admin"
                               asp-action="Projects"
                               asp-route-page="@i"
                               class="pagination-btn">@i</a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-controller="Admin"
                           asp-action="Projects"
                           asp-route-page="@(currentPage + 1)"
                           class="pagination-btn">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <!-- EMPTY -->
            <div class="empty-projects">
                <div class="empty-projects-icon">
                    <i class="bi bi-folder-x"></i>
                </div>
                <h4>No Projects Found</h4>
                <p>There are currently no projects available in the database.</p>
                <a asp-controller="Admin"
                   asp-action="CreateProject"
                   class="btn-add-project">
                    <i class="bi bi-plus-lg"></i>
                    Add Your First Project
                </a>
            </div>
        }
    </div>
</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["Success"]',
            confirmButtonColor: '#E0A458',
            background: '#171B24',
            color: '#fff'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: '@TempData["Error"]',
            confirmButtonColor: '#C6614E',
            background: '#171B24',
            color: '#fff'
        });
    </script>
}