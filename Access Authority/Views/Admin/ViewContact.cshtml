@model Access_Authority.Models.ContactViewModel

@{
    Layout = "_Layout1";
}

<style>
    /* =========================================
           CONTACT DETAIL PAGE
        ========================================= */
    .contact-view-page {
        padding: 30px;
        width: 100%;
        box-sizing: border-box;
    }

    .contact-view-card {
        background: #171B24;
        border: 1px solid #2a2a2a;
        border-radius: 12px;
        overflow: hidden;
        color: #c8c8c8;
    }

    /* HEADER */
    .contact-view-header {
        padding: 18px 24px;
        border-bottom: 1px solid #2a2a2a;
        background: #1D222C;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .contact-view-header h4 {
            color: #E0A458;
            font-weight: 700;
            margin: 0;
            font-size: 20px;
        }

    /* BODY */
    .contact-view-body {
        padding: 24px;
    }

    /* LABELS */
    .contact-view-label {
        display: block;
        color: #E0A458;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 8px;
    }

    /* DETAILS BOX */
    .contact-detail {
        padding: 12px 15px;
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 14px;
        word-break: break-word;
        overflow-wrap: anywhere;
        line-height: 1.5;
        min-height: 46px;
        display: flex;
        align-items: center;
    }

    /* MESSAGE BOX */
    .contact-message {
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        padding: 14px 16px;
        line-height: 1.6;
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 14px;
        word-break: break-word;
        overflow-wrap: anywhere;
        min-height: 60px;
    }

    /* BACK BUTTON */
    .contact-view-actions {
        display: flex;
        justify-content: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #2a2a2a;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 24px;
        background: transparent;
        color: #E0A458;
        border: 1px solid rgba(224,164,88,.35);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: .25s;
        min-width: 140px;
        cursor: pointer;
    }

        .btn-back:hover {
            background: #E0A458;
            color: #10131A;
            border-color: #E0A458;
        }

    /* =========================================
           TABLET (<= 991px)
        ========================================= */
    @@media (max-width: 991px) {
        .contact-view-page {
            padding: 20px;
        }
    }

    /* =========================================
           MOBILE (<= 767px) — CARD WITH LABEL LEFT, VALUE RIGHT
        ========================================= */
    @@media (max-width: 767px) {

        .contact-view-page {
            padding: 12px;
        }

        .contact-view-card {
            background: transparent;
            border: none;
            border-radius: 0;
        }
        /* Header — standalone gold banner */
        .contact-view-header {
            padding: 14px 16px;
            background: rgba(224,164,88,0.08);
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            margin-bottom: 14px;
        }

            .contact-view-header h4 {
                font-size: 17px;
            }
        /* Body — single card with rows */
        .contact-view-body {
            padding: 0;
            background: #1f1f1f;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            overflow: hidden;
        }
            /* Reset row */
            .contact-view-body .row {
                display: block;
                margin: 0 !important;
                --bs-gutter-x: 0;
                --bs-gutter-y: 0;
            }
            /* Each col = a row */
            .contact-view-body .col-md-6,
            .contact-view-body .col-12 {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-between !important;
                align-items: center !important;
                gap: 12px !important;
                width: 100% !important;
                max-width: 100% !important;
                flex: 0 0 100% !important;
                padding: 12px 16px !important;
                margin: 0 !important;
                border-bottom: 1px solid rgba(255,255,255,0.06) !important;
                min-height: 48px;
                box-sizing: border-box;
            }
            /* Last row - no border */
            .contact-view-body .row > div:last-child {
                border-bottom: none !important;
            }
            /* Project details row — block layout */
            .contact-view-body .col-12 {
                display: block !important;
            }
        /* Label — left side, gold, uppercase */
        .contact-view-label {
            color: #E0A458 !important;
            font-size: 10.5px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.7px !important;
            margin: 0 !important;
            padding: 0 !important;
            text-align: left !important;
            flex-shrink: 0 !important;
            white-space: nowrap;
        }
        /* Value — right side, white */
        .contact-detail {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
            min-height: auto !important;
            font-size: 13.5px !important;
            color: #fff !important;
            text-align: right !important;
            justify-content: flex-end !important;
            flex: 1 1 auto !important;
            word-break: break-word;
            overflow-wrap: anywhere;
            line-height: 1.45;
        }
        /* Project details — full width, boxed */
        .contact-view-body .col-12 .contact-view-label {
            display: block;
            margin-bottom: 8px !important;
        }

        .contact-message {
            padding: 12px 14px !important;
            font-size: 13.5px !important;
            border-radius: 8px !important;
            min-height: 70px !important;
            background: rgba(255,255,255,0.03) !important;
            border: 1px solid #2a2a2a !important;
            text-align: left !important;
            margin-top: 4px;
        }
        /* Back button — centered */
        .contact-view-actions {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #2a2a2a;
            justify-content: center;
        }

        .btn-back {
            width: auto;
            min-width: 140px;
            height: 40px;
            font-size: 13.5px;
            padding: 0 20px;
            border-radius: 8px;
        }
    }

    /* =========================================
           EXTRA SMALL (<= 400px)
        ========================================= */
    @@media (max-width: 400px) {
        .contact-view-page {
            padding: 8px;
        }

        .contact-view-header {
            padding: 12px 14px;
        }

            .contact-view-header h4 {
                font-size: 16px;
            }

        .contact-view-body .col-md-6,
        .contact-view-body .col-12 {
            padding: 11px 14px !important;
            min-height: 44px;
        }

        .contact-view-label {
            font-size: 10px !important;
        }

        .contact-detail {
            font-size: 13px !important;
        }

        .contact-message {
            padding: 11px 12px !important;
            font-size: 13px !important;
            min-height: 60px !important;
        }

        .btn-back {
            min-width: 130px;
            height: 38px;
            font-size: 13px;
        }
    }
</style>

<body class="bg-dark">
    <div class="contact-view-page">

        <div class="contact-view-card">

            <!-- HEADER -->
            <div class="contact-view-header">
                <h4>
                    <i class="bi bi-envelope-open-fill"></i>
                    Contact Message
                </h4>
            </div>

            <!-- BODY -->
            <div class="contact-view-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="contact-view-label">Full Name</label>
                        <div class="contact-detail">
                            @Model.FullName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="contact-view-label">Email Address</label>
                        <div class="contact-detail">
                            @Model.Email
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="contact-view-label">Phone Number</label>
                        <div class="contact-detail">
                            @Model.Phone
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="contact-view-label">Service Interest</label>
                        <div class="contact-detail">
                            @Model.ServiceInterest
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="contact-view-label">Project Details</label>
                        <div class="contact-message">
                            @Model.ProjectDetails
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="contact-view-label">Privacy Accepted</label>
                        <div class="contact-detail">
                            @(Model.PrivacyAccepted ? "Yes" : "No")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="contact-view-label">Submitted On</label>
                        <div class="contact-detail">
                            @Model.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                        </div>
                    </div>

                </div>

                <!-- BACK BUTTON (centered) -->
                <div class="contact-view-actions">
                    <a asp-controller="Admin"
                       asp-action="Contact"
                       class="btn-back">
                        <i class="bi bi-arrow-left"></i>
                        Back to Contacts
                    </a>
                </div>

            </div>

        </div>

    </div>
</body>