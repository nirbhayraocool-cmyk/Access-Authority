@model Access_Authority.Models.DashboardViewModel

@{
    Layout = "_Layout1";
}

<style>
    :root {
        --bg: #10131A;
        --surface: #171B24;
        --surface-2: #1F2430;
        --border: #2A3040;
        --text: #E8E6DE;
        --text-dim: #9096A6;
        --accent: #E0A458;
        --accent-soft: #3A3221;
        --accent2: #5B8C87;
        --danger: #C6614E;
        --danger-soft: #3A2420;
        --radius-sm: 6px;
        --radius-md: 10px;
        --font-display: 'Fraunces', serif;
        --font-body: 'Inter', sans-serif;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        min-height: 100vh;
    }

    /* ================= DASHBOARD ================= */

    .admpnl-admin-app {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 2px 1fr;
    }

    /* ================= SIDEBAR ================= */

    

    .admpnl-sidebar-logo {
        font-family: var(--font-display);
        font-size: 19px;
        padding: 0 8px 26px;
        color: var(--text);
    }

        .admpnl-sidebar-logo span {
            color: var(--accent);
        }

    .admpnl-nav-menu {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .admpnl-nav-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 10px 12px;
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background .12s ease, color .12s ease;
    }

        .admpnl-nav-item:hover {
            background: var(--surface-2);
            color: var(--text);
        }

        .admpnl-nav-item.active {
            background: var(--accent-soft);
            color: var(--accent);
        }

        .admpnl-nav-item .admpnl-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            opacity: .7;
            flex-shrink: 0;
        }

    .admpnl-sidebar-bottom {
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid var(--border);
    }

    .admpnl-user-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        font-size: 13.5px;
        color: var(--text-dim);
    }

    .admpnl-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--surface-2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        color: var(--accent);
        font-size: 14px;
    }

    /* ================= MAIN ================= */

    .admpnl-main {
        padding: 36px 44px;
        overflow-y: auto;
        min-width: 0;
    }

    .admpnl-page-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 14px;
    }

        .admpnl-page-head h2 {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 27px;
            margin: 0 0 4px;
        }

        .admpnl-page-head p {
            margin: 0;
            color: var(--text-dim);
            font-size: 14px;
        }

    /* ================= BUTTONS ================= */

    .admpnl-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: var(--radius-sm);
        padding: 11px 18px;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: transform .12s ease, opacity .12s ease;
    }

        .admpnl-btn:active {
            transform: scale(.98);
        }

    .admpnl-btn-primary {
        background: var(--accent);
        color: #1A1408;
    }

        .admpnl-btn-primary:hover {
            opacity: .92;
        }

    .admpnl-btn-ghost {
        background: transparent;
        color: var(--text-dim);
        border: 1px solid var(--border);
    }

        .admpnl-btn-ghost:hover {
            color: var(--text);
            border-color: var(--text-dim);
        }

    .admpnl-btn-danger {
        background: var(--danger-soft);
        color: var(--danger);
    }

    /* ================= STATISTICS ================= */

    .admpnl-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 34px;
    }

    .admpnl-stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 20px;
    }

        .admpnl-stat-card.accent {
            border-color: rgba(224, 164, 88, .35);
        }

        .admpnl-stat-card .admpnl-num {
            font-family: var(--font-display);
            font-size: 32px;
            font-weight: 600;
        }

        .admpnl-stat-card.accent .admpnl-num {
            color: var(--accent);
        }

        .admpnl-stat-card .admpnl-label {
            color: var(--text-dim);
            font-size: 13.5px;
            margin-top: 4px;
        }

    /* ================= PANEL ================= */

    .admpnl-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 24px;
        margin-bottom: 24px;
    }

    .admpnl-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .admpnl-panel-head h3 {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 18px;
            margin: 0;
        }

    /* ================= RECENT ACTIVITY ================= */

    .admpnl-list-recent {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .admpnl-list-recent li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 13px 0;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
            gap: 15px;
        }

            .admpnl-list-recent li:last-child {
                border-bottom: none;
            }

        .admpnl-list-recent .admpnl-meta {
            color: var(--text-dim);
            font-size: 12.5px;
        }

    /* ================= TOOLBAR ================= */

    .admpnl-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .admpnl-search-box {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 10px 13px;
        color: var(--text);
        font-size: 13.5px;
        min-width: 260px;
        outline: none;
    }

        .admpnl-search-box:focus {
            border-color: var(--accent);
        }

    /* ================= CARDS ================= */

    .admpnl-card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .admpnl-item-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 19px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 0;
    }

        .admpnl-item-card h4 {
            margin: 0;
            font-size: 15.5px;
            font-weight: 600;
            line-height: 1.35;
        }

        .admpnl-item-card .admpnl-excerpt {
            color: var(--text-dim);
            font-size: 13.5px;
            line-height: 1.5;
            flex: 1;
        }

        .admpnl-item-card .admpnl-row-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-dim);
        }

    .admpnl-thumb {
        width: 100%;
        height: 130px;
        object-fit: cover;
        border-radius: 8px;
        margin: -3px 0 2px;
    }

    /* ================= TAGS ================= */

    .admpnl-tag {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
    }

        .admpnl-tag.published,
        .admpnl-tag.open {
            background: rgba(91, 140, 135, .16);
            color: var(--accent2);
        }

        .admpnl-tag.draft,
        .admpnl-tag.read {
            background: var(--surface-2);
            color: var(--text-dim);
            border: 1px solid var(--border);
        }

        .admpnl-tag.closed {
            background: rgba(198, 97, 78, .14);
            color: var(--danger);
        }

        .admpnl-tag.new {
            background: var(--accent-soft);
            color: var(--accent);
        }

    /* ================= ACTIONS ================= */

    .admpnl-card-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .admpnl-icon-btn {
        background: var(--surface-2);
        border: 1px solid var(--border);
        color: var(--text-dim);
        border-radius: var(--radius-sm);
        padding: 7px 12px;
        font-size: 12.5px;
        cursor: pointer;
        font-family: var(--font-body);
        font-weight: 500;
    }

        .admpnl-icon-btn:hover {
            color: var(--text);
            border-color: var(--text-dim);
        }

        .admpnl-icon-btn.danger:hover {
            color: var(--danger);
            border-color: var(--danger);
        }

    /* ================= CONTACT ================= */

    .admpnl-msg-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
    }

        .admpnl-msg-row:last-child {
            border-bottom: none;
        }

        .admpnl-msg-row .admpnl-who {
            font-weight: 600;
            font-size: 14.5px;
        }

        .admpnl-msg-row .admpnl-email {
            color: var(--text-dim);
            font-size: 12.5px;
            margin-top: 2px;
        }

        .admpnl-msg-row .admpnl-body {
            color: var(--text);
            font-size: 13.5px;
            margin-top: 8px;
            line-height: 1.5;
            max-width: 650px;
        }

        .admpnl-msg-row .admpnl-side {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            min-width: 110px;
        }

    /* ================= EMPTY ================= */

    .admpnl-empty-state {
        text-align: center;
        padding: 50px 20px;
        color: var(--text-dim);
    }

        .admpnl-empty-state .admpnl-glyph {
            font-family: var(--font-display);
            font-size: 34px;
            color: var(--accent);
            margin-bottom: 10px;
        }

        .admpnl-empty-state p {
            margin: 0;
            font-size: 14px;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1100px) {

        .admpnl-stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .admpnl-card-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 820px) {

        .admpnl-admin-app {
            grid-template-columns: 1fr;
        }

        .admpnl-sidebar {
            position: relative;
            min-height: auto;
            height: auto;
            flex-direction: row;
            overflow-x: auto;
            padding: 14px 16px;
            align-items: center;
            gap: 6px;
        }

        .admpnl-sidebar-logo {
            display: none;
        }

        .admpnl-nav-menu {
            flex-direction: row;
            gap: 6px;
        }

        .admpnl-nav-item {
            white-space: nowrap;
        }

        .admpnl-sidebar-bottom {
            display: none;
        }

        .admpnl-main {
            padding: 24px 20px;
        }
    }

    @@media (max-width: 600px) {

        .admpnl-stat-grid {
            grid-template-columns: 1fr;
        }

        .admpnl-card-grid {
            grid-template-columns: 1fr;
        }

        .admpnl-main {
            padding: 20px 15px;
        }

        .admpnl-page-head h2 {
            font-size: 24px;
        }

        .admpnl-search-box {
            width: 100%;
            min-width: 0;
        }

        .admpnl-msg-row {
            flex-direction: column;
        }

            .admpnl-msg-row .admpnl-side {
                align-items: flex-start;
            }
    }
</style>


<div class="admpnl-admin-app">

    <!-- ================= SIDEBAR ================= -->

    <aside class="admpnl-sidebar">

       
    </aside>


    <!-- ================= MAIN ================= -->

    <main class="admpnl-main">

        <!-- PAGE HEADER -->

        <div class="admpnl-page-head">

            <div>

                <h2>
                    Dashboard
                </h2>

                <p>
                    Teeno sections ka ek nazar mein status.
                </p>

            </div>

        </div>


        <!-- ================= dynamic ================= -->
        <div class="admpnl-stat-grid">

            <div class="admpnl-stat-card accent">

                <div class="admpnl-num">
                    @Model.TotalBlogs
                </div>

                <div class="admpnl-label">
                    Blog posts
                </div>

            </div>


            <div class="admpnl-stat-card">

                <div class="admpnl-num">
                    @Model.TotalContacts
                </div>

                <div class="admpnl-label">
                    Contact messages
                </div>

            </div>


            <div class="admpnl-stat-card">

                <div class="admpnl-num">
                    @Model.TotalContacts
                </div>

                <div class="admpnl-label">
                    Total enquiries
                </div>

            </div>


            <div class="admpnl-stat-card">

                <div class="admpnl-num">
                    @Model.OpenPositions
                </div>

                <div class="admpnl-label">
                    Open positions
                </div>

            </div>

        </div>


        <!-- ================= RECENT ACTIVITY ================= -->

        <div class="admpnl-panel">

            <div class="admpnl-panel-head">

                <h3>
                    Latest activity
                </h3>

            </div>


            <ul class="admpnl-list-recent">

                @if (Model.LatestActivities.Any())
                {
                    foreach (var activity in Model.LatestActivities)
                    {
                        <li>

                            <span>
                                @activity.Title
                            </span>

                            <span class="admpnl-meta">
                                @activity.Status ·
                                @activity.Date.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                        </li>
                    }
                }
                else
                {
                    <li>
                        <span>
                            No recent activity found.
                        </span>

                        <span class="admpnl-meta">
                            —
                        </span>
                    </li>
                }

            </ul>

        </div>


@*         <!-- ================= BLOG PREVIEW ================= -->

        <div class="admpnl-page-head">

            <div>

                <h2>
                    Blog
                </h2>

                <p>
                    Latest blog posts.
                </p>

            </div>

            <a href="@Url.Action("Blog", "Admin")"
               class="admpnl-btn admpnl-btn-primary">
                + Manage Blog
            </a>

        </div>


        <div class="admpnl-card-grid">

            @if (Model.LatestBlogs.Any())
            {
                foreach (var blog in Model.LatestBlogs)
                {
                    <div class="admpnl-item-card">

                        <span class="admpnl-tag @(blog.Status?.ToLower() == "published" ? "published" : "draft")">
                            @blog.Status
                        </span>

                        <h4>
                            @blog.Title
                        </h4>

                        <div style="color:var(--text-dim);font-size:12.5px">
                            Access Authority
                        </div>

                        <div class="admpnl-excerpt">
                            @{
                                var content = blog.Content ?? "";
                                var shortContent = content.Length > 140
                                ? content.Substring(0, 140) + "..."
                                : content;
                            }

                            @shortContent
                        </div>

                        <div class="admpnl-row-meta">

                            <span>
                                @blog.Category
                            </span>

                            <span>
                                @blog.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                            </span>

                        </div>

                        <div class="admpnl-card-actions">

                            <a href="@Url.Action("ViewBlog", "Admin", new { id = blog.Id })"
                               class="admpnl-icon-btn">
                                View
                            </a>

                            <a href="@Url.Action("EditBlog", "Admin", new { id = blog.Id })"
                               class="admpnl-icon-btn">
                                Edit
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="admpnl-empty-state" style="grid-column:1/-1">

                    <div class="admpnl-glyph">
                        B
                    </div>

                    <p>
                        No blog posts available.
                    </p>

                </div>
            }

        </div>


        <!-- ================= CONTACT ================= -->

        <div class="admpnl-page-head" style="margin-top:40px">

            <div>

                <h2>
                    Contact messages
                </h2>

                <p>
                    Website se aayi latest enquiries.
                </p>

            </div>

            <a href="@Url.Action("Contact", "Admin")"
               class="admpnl-btn admpnl-btn-primary">
                View all
            </a>

        </div>


        <div class="admpnl-panel">

            @if (Model.LatestContacts.Any())
            {
                foreach (var contact in Model.LatestContacts)
                {
                    <div class="admpnl-msg-row">

                        <div>

                            <div class="admpnl-who">
                                @contact.FullName
                            </div>

                            <div class="admpnl-email">
                                @contact.Email ·
                                @contact.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </div>

                            <div class="admpnl-body">

                                @{
                                    var message = contact.ProjectDetails ?? "";
                                    var shortMessage = message.Length > 180
                                    ? message.Substring(0, 180) + "..."
                                    : message;
                                }

                                @shortMessage

                            </div>

                        </div>

                        <div class="admpnl-side">

                            <span class="admpnl-tag new">
                                New
                            </span>

                            <a href="@Url.Action("ViewContact", "Admin", new { id = contact.Id })"
                               class="admpnl-icon-btn">
                                View
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="admpnl-empty-state">

                    <div class="admpnl-glyph">
                        C
                    </div>

                    <p>
                        No contact messages available.
                    </p>

                </div>
            }

        </div>


        <!-- ================= CAREER ================= -->

        <div class="admpnl-page-head" style="margin-top:40px">

            <div>

                <h2>
                    Career
                </h2>

                <p>
                    Current job openings.
                </p>

            </div>

            <a href="@Url.Action("Career", "Admin")"
               class="admpnl-btn admpnl-btn-primary">
                Manage Career
            </a>

        </div>


        <div class="admpnl-card-grid">

            @if (Model.LatestPositions.Any())
            {
                foreach (var position in Model.LatestPositions)
                {
                    <div class="admpnl-item-card">

                        <h4>
                            @position.JobTitle
                        </h4>

                        <div class="admpnl-excerpt">

                            @if (!string.IsNullOrWhiteSpace(position.Location))
                            {
                                @position.Location
                            }

                            @if (!string.IsNullOrWhiteSpace(position.Type))
                            {
                                <span>
                                    · @position.Type
                                </span>
                            }

                        </div>

                        <div class="admpnl-row-meta">

                            @{
                                var statusClass =
                                position.Status?.Equals("Open", StringComparison.OrdinalIgnoreCase) == true
                                ? "open"
                                : "closed";
                            }

                            <span class="admpnl-tag @statusClass">
                                @position.Status
                            </span>

                            <span>
                                @position.PostedDate.ToLocalTime().ToString("dd MMM yyyy")
                            </span>

                        </div>

                        <div class="admpnl-card-actions">

                            <a href="@Url.Action("Career", "Admin")"
                               class="admpnl-icon-btn">
                                View
                            </a>

                            <a href="@Url.Action("EditPosition", "Admin", new { id = position.Id })"
                               class="admpnl-icon-btn">
                                Edit
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="admpnl-empty-state" style="grid-column:1/-1">

                    <div class="admpnl-glyph">
                        C
                    </div>

                    <p>
                        No career positions available.
                    </p>

                </div>
            }

        </div>

    </main>

</div> *@