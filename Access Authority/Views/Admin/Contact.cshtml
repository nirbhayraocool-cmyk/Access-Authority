@model IEnumerable<Access_Authority.Models.ContactViewModel>

@{
    Layout = "_Layout1";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalContacts = ViewBag.TotalContacts ?? (Model?.Count() ?? 0);
}

<style>
    /* ============================================
           THEME COLORS (Dashboard Gold Theme)
        ============================================ */

    .contact-table {
        font-size: 12px !important;
    }

        .contact-table th,
        .contact-table td {
            color: white !important;
            background-color: #212529 !important;
            vertical-align: middle;
        }

        .contact-table th {
            color: #E0A458 !important;
        }

    .btn-project-view,
    .btn-project-delete {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        transition: .25s;
        padding: 0;
        cursor: pointer;
        box-sizing: border-box;
        font-size: 14px;
        vertical-align: middle;
        line-height: 1;
        flex-shrink: 0;
    }

    /* VIEW */
    .btn-project-view {
        color: #E0A458;
        border: 1px solid rgba(224,164,88,.35);
        background: rgba(224,164,88,.08);
        text-decoration: none;
    }

        .btn-project-view:hover {
            background: #E0A458;
            color: #10131A;
        }

    /* DELETE */
    .btn-project-delete {
        color: #C6614E;
        border: 1px solid rgba(198,97,78,.35);
        background: rgba(198,97,78,.08);
    }

        .btn-project-delete:hover {
            background: #C6614E;
            color: #fff;
        }

    /* Action cell — inline with gap (desktop) */
    .contact-table td:last-child {
        white-space: nowrap;
        text-align: center;
        vertical-align: middle !important;
    }

        .contact-table td:last-child .action-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            vertical-align: middle;
        }

        .contact-table td:last-child form {
            display: inline-flex;
            align-items: center;
            margin: 0;
            padding: 0;
            vertical-align: middle;
        }

    /* PAGINATION */
    .contact-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 20px 0;
        flex-wrap: wrap;
    }

    .pagination-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 6px;
        border: 1px solid rgba(224,164,88,.25);
        background: rgba(224,164,88,.06);
        color: #c3c8d0;
        text-decoration: none;
        font-size: 13px;
        transition: .25s;
        box-sizing: border-box;
    }

        .pagination-btn:hover {
            background: #E0A458;
            border-color: #E0A458;
            color: #10131A;
        }

        .pagination-btn.active {
            background: #E0A458;
            border-color: #E0A458;
            color: #10131A;
            font-weight: 700;
        }

        .pagination-btn.disabled {
            opacity: .45;
            pointer-events: none;
        }

    /* ============================================
           TABLET (<= 991px)
        ============================================ */
    @@media (max-width: 991px) {
        .container.px-5 {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }
    }

    /* ============================================
           MOBILE (<= 767px)
        ============================================ */
    @@media (max-width: 767px) {

        .container.px-5 {
            padding-left: 12px !important;
            padding-right: 12px !important;
            padding-top: 20px !important;
        }

        .mb-4.d-flex.justify-content-between.align-items-center {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 8px !important;
        }

            .mb-4.d-flex.justify-content-between.align-items-center h3 {
                font-size: 20px !important;
            }
        /* ============================================
               TABLE -> CARDS
            ============================================ */
        .table-responsive {
            overflow-x: visible !important;
        }

            .table-responsive > table {
                display: block !important;
                width: 100% !important;
                border: none !important;
                background: transparent !important;
            }

                .table-responsive > table > thead {
                    display: none !important;
                }

                .table-responsive > table > tbody {
                    display: block !important;
                    width: 100% !important;
                }
                    /* Each row = a card */
                    .table-responsive > table > tbody > tr {
                        display: block !important;
                        width: 100% !important;
                        background: #1f1f1f !important;
                        border: 1px solid #2a2a2a !important;
                        border-radius: 12px !important;
                        margin: 0 0 14px 0 !important;
                        padding: 0 !important;
                        overflow: hidden !important;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.3) !important;
                    }

                        .table-responsive > table > tbody > tr:last-child {
                            margin-bottom: 0 !important;
                        }
                        /* Each td = a row inside card */
                        .table-responsive > table > tbody > tr > td {
                            display: flex !important;
                            justify-content: space-between !important;
                            align-items: center !important;
                            width: 100% !important;
                            padding: 10px 16px !important;
                            margin: 0 !important;
                            border: none !important;
                            border-bottom: 1px solid rgba(255,255,255,0.06) !important;
                            text-align: right !important;
                            font-size: 13px !important;
                            line-height: 1.45 !important;
                            vertical-align: middle !important;
                            word-break: break-word !important;
                            overflow-wrap: anywhere !important;
                            min-height: 44px !important;
                            background-color: #1f1f1f !important;
                            color: #c8c8c8 !important;
                        }

                            .table-responsive > table > tbody > tr > td:last-child {
                                border-bottom: none !important;
                            }
                            /* data-label via ::before */
                            .table-responsive > table > tbody > tr > td[data-label]::before {
                                content: attr(data-label) !important;
                                font-size: 10.5px !important;
                                font-weight: 700 !important;
                                color: #E0A458 !important;
                                text-transform: uppercase !important;
                                letter-spacing: 0.7px !important;
                                text-align: left !important;
                                flex-shrink: 0 !important;
                                margin-right: 12px !important;
                            }
                            /* Hide serial number */
                            .table-responsive > table > tbody > tr > td:first-child {
                                display: none !important;
                            }
                            /* ============================================
               Full Name = FIRST INFO ROW (label left, value right)
            ============================================ */
                            .table-responsive > table > tbody > tr > td:nth-child(2) {
                                display: flex !important;
                                justify-content: space-between !important;
                                align-items: center !important;
                                padding: 10px 16px !important;
                                background: rgba(224,164,88,0.08) !important;
                                font-size: 14px !important;
                                font-weight: 600 !important;
                                color: #fff !important;
                                text-align: right !important;
                                border-bottom: 1px solid #2a2a2a !important;
                                min-height: 44px !important;
                                line-height: 1.45 !important;
                            }

                                .table-responsive > table > tbody > tr > td:nth-child(2)::before {
                                    content: attr(data-label) !important;
                                    display: inline !important;
                                    font-size: 10.5px !important;
                                    color: #E0A458 !important;
                                    letter-spacing: 0.7px !important;
                                    font-weight: 700 !important;
                                    text-transform: uppercase !important;
                                    flex-shrink: 0 !important;
                                    margin-right: 12px !important;
                                }
                            /* Project details text */
                            .table-responsive > table > tbody > tr > td[data-label="Project Details"] {
                                align-items: flex-start !important;
                            }
                            /* ============================================
               Action cell — buttons CENTER me
            ============================================ */
                            .table-responsive > table > tbody > tr > td:last-child {
                                display: flex !important;
                                flex-direction: row !important;
                                flex-wrap: nowrap !important;
                                align-items: center !important;
                                justify-content: center !important;
                                gap: 10px !important;
                                padding: 12px 16px !important;
                                background: rgba(0,0,0,0.25) !important;
                                border-top: 1px solid #2a2a2a !important;
                                min-height: auto !important;
                                white-space: nowrap !important;
                            }

                                .table-responsive > table > tbody > tr > td:last-child::before {
                                    display: none !important;
                                }

                                .table-responsive > table > tbody > tr > td:last-child .action-wrap {
                                    display: flex !important;
                                    gap: 10px !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                    width: auto !important;
                                }

                                .table-responsive > table > tbody > tr > td:last-child > a,
                                .table-responsive > table > tbody > tr > td:last-child > form {
                                    flex: 0 0 auto !important;
                                    width: auto !important;
                                    margin: 0 !important;
                                    padding: 0 !important;
                                    display: inline-flex !important;
                                    align-items: center !important;
                                }
                                /* Dono buttons same size */
                                .table-responsive > table > tbody > tr > td:last-child .btn-project-view,
                                .table-responsive > table > tbody > tr > td:last-child .btn-project-delete {
                                    width: auto !important;
                                    min-width: 82px !important;
                                    height: 38px !important;
                                    display: inline-flex !important;
                                    align-items: center !important;
                                    justify-content: center !important;
                                    font-size: 13px !important;
                                    font-weight: 600 !important;
                                    border-radius: 8px !important;
                                    padding: 0 12px !important;
                                    gap: 5px !important;
                                    margin: 0 !important;
                                }
                                    /* Text labels */
                                    .table-responsive > table > tbody > tr > td:last-child .btn-project-view::after {
                                        content: 'View';
                                        margin-left: 4px;
                                    }

                                    .table-responsive > table > tbody > tr > td:last-child .btn-project-delete::after {
                                        content: 'Delete';
                                        margin-left: 4px;
                                    }
        /* Pagination */
        .contact-pagination {
            padding: 16px 0 !important;
            gap: 5px !important;
        }

        .pagination-btn {
            min-width: 34px !important;
            height: 34px !important;
            font-size: 12px !important;
            padding: 0 10px !important;
        }

        .contact-pagination .pagination-btn:first-child,
        .contact-pagination .pagination-btn:last-child {
            padding: 0 12px !important;
        }
    }

    /* ============================================
           EXTRA SMALL (<= 400px)
        ============================================ */
    @@media (max-width: 400px) {
        .container.px-5 {
            padding-left: 8px !important;
            padding-right: 8px !important;
        }

        .mb-4.d-flex.justify-content-between.align-items-center h3 {
            font-size: 18px !important;
        }

        .table-responsive > table > tbody > tr > td {
            padding: 9px 12px !important;
            font-size: 12px !important;
        }

            .table-responsive > table > tbody > tr > td:nth-child(2) {
                padding: 10px 12px !important;
                font-size: 13px !important;
            }

            .table-responsive > table > tbody > tr > td[data-label]::before {
                font-size: 10px !important;
            }
            /* Action cell compact — still centered */
            .table-responsive > table > tbody > tr > td:last-child {
                gap: 8px !important;
                padding: 10px 12px !important;
                justify-content: center !important;
            }

                .table-responsive > table > tbody > tr > td:last-child .action-wrap {
                    justify-content: center !important;
                }

                .table-responsive > table > tbody > tr > td:last-child .btn-project-view,
                .table-responsive > table > tbody > tr > td:last-child .btn-project-delete {
                    min-width: 74px !important;
                    height: 36px !important;
                    font-size: 12px !important;
                    padding: 0 10px !important;
                }

        .pagination-btn {
            min-width: 30px !important;
            height: 30px !important;
            font-size: 11px !important;
            padding: 0 8px !important;
        }
    }
</style>

<body class="bg-dark">

    <div class="container px-5 pt-5 bg-dark">

        <!-- ================= CONTACT HEADING ================= -->

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h3 style="color: #E0A458;">Contact messages</h3>
                <p class="text-secondary mb-0">Website se aayi latest enquiries.</p>
            </div>
            <span class="text-secondary small">
                Total: <strong class="text-white">@totalContacts</strong>
            </span>
        </div>


        <!-- ================= CONTACT TABLE ================= -->

        <div class="row">
            <div class="table-responsive">

                <table class="table table-bordered table-dark contact-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Service</th>
                            <th>Project Details</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int serialNo = (currentPage - 1) * pageSize + 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@serialNo</td>

                                    <td data-label="Full Name">@item.FullName</td>
                                    <td data-label="Email">@item.Email</td>
                                    <td data-label="Phone">@item.Phone</td>
                                    <td data-label="Service">@item.ServiceInterest</td>
                                    <td data-label="Project Details">@item.ProjectDetails</td>

                                    <td data-label="Date">
                                        @item.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                                    </td>

                                    <td>
                                        <div class="action-wrap">

                                            <!-- VIEW BUTTON -->
                                            <a asp-controller="Admin"
                                               asp-action="ViewContact"
                                               asp-route-id="@item.Id"
                                               class="btn-project-view"
                                               title="View">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            <!-- DELETE FORM -->
                                            <form asp-controller="Admin"
                                                  asp-action="DeleteContact"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirmDelete(this);">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn-project-delete"
                                                        title="Delete">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>

                                </tr>

                                serialNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-secondary">
                                    No contact messages found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>


        <!-- ================= PAGINATION ================= -->
        @if (totalPages > 1)
        {
            <div class="contact-pagination">

                <!-- PREVIOUS -->
                @if (currentPage > 1)
                {
                    <a asp-controller="Admin"
                       asp-action="Contact"
                       asp-route-page="@(currentPage - 1)"
                       class="pagination-btn">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                }
                else
                {
                    <span class="pagination-btn disabled">
                        <i class="bi bi-chevron-left"></i> Previous
                    </span>
                }


                <!-- PAGE NUMBERS -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="pagination-btn active">@i</span>
                    }
                    else
                    {
                        <a asp-controller="Admin"
                           asp-action="Contact"
                           asp-route-page="@i"
                           class="pagination-btn">@i</a>
                    }
                }


                <!-- NEXT -->
                @if (currentPage < totalPages)
                {
                    <a asp-controller="Admin"
                       asp-action="Contact"
                       asp-route-page="@(currentPage + 1)"
                       class="pagination-btn">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="pagination-btn disabled">
                        Next <i class="bi bi-chevron-right"></i>
                    </span>
                }

            </div>
        }

    </div>


    <!-- ================= SWEET ALERT 2 ================= -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- ================= DELETE CONFIRMATION ================= -->

    <script>
        function confirmDelete(form) {
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#E0A458",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });

            return false;
        }
    </script>


    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                title: "Deleted!",
                text: "@TempData["Success"]",
                icon: "success",
                confirmButtonText: "OK",
                confirmButtonColor: "#E0A458"
            });
        </script>
    }

</body>