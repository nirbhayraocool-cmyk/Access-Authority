@model List<Access_Authority.Models.Project>

@{
    ViewData["Title"] = "Project";
}
<style>

    /* =========================================================
           ACCESS AUTHORITY Project PAGE
           ========================================================= */

    .portfolio-page {
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #111;
    }

    /* =========================================================
           HERO
           ========================================================= */

    .portfolio-hero {
        background: #0d0b0c;
        padding: 22px 0 42px;
        border-right: 2px solid #e50920;
    }

    .portfolio-container {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .portfolio-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #ed102b;
    }

        .portfolio-breadcrumb i {
            font-size: 10px;
        }

    .portfolio-hero h1 {
        margin: 0;
        max-width: 700px;
        font-size: 42px;
        line-height: 1.15;
        font-weight: 800;
        color: #ffffff;
    }

        .portfolio-hero h1 span {
            color: #ed102b;
        }

    .portfolio-hero-description {
        max-width: 590px;
        margin: 12px 0 0;
        color: #969399;
        font-size: 15px;
        line-height: 1.7;
    }

    /* =========================================================
           HERO STATS
           ========================================================= */

    .portfolio-stats {
        display: flex;
        align-items: flex-start;
        gap: 58px;
        max-width: 600px;
        margin-top: 25px;
        padding-top: 21px;
        border-top: 1px solid #282326;
    }

    .portfolio-stat {
        min-width: 80px;
    }

    .portfolio-stat-number {
        display: block;
        color: #ffffff;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.2;
    }

    .portfolio-stat-label {
        display: block;
        margin-top: 4px;
        color: #777278;
        font-size: 10px;
        line-height: 1.4;
    }


    /* =========================================================
           SECTION HEADING
           ========================================================= */

    .portfolio-section {
        padding: 40px 0 48px;
        background: #ffffff;
    }

    .portfolio-section-heading {
        text-align: center;
        margin-bottom: 31px;
    }

        .portfolio-section-heading h2 {
            margin: 0;
            font-size: 31px;
            font-weight: 800;
            line-height: 1.2;
            color: #101010;
        }

            .portfolio-section-heading h2 span {
                color: #ed102b;
            }

        .portfolio-section-heading p {
            margin: 6px 0 0;
            color: #252525;
            font-size: 13px;
        }


    /* =========================================================
           PROJECT GRID
           ========================================================= */

    .portfolio-project-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
    }

    .portfolio-project-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dedede;
        transition: all .3s ease;
    }

        .portfolio-project-card:hover {
            transform: translateY(-5px);
            border-color: #ed102b;
            box-shadow: 0 12px 30px rgba(0, 0, 0, .10);
        }

    .portfolio-project-image {
        position: relative;
        height: 180px;
        overflow: hidden;
        background: #ddd;
    }

        .portfolio-project-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .portfolio-project-card:hover .portfolio-project-image img {
        transform: scale(1.05);
    }

    .portfolio-category {
        position: absolute;
        top: 11px;
        left: 11px;
        z-index: 2;
        padding: 5px 10px;
        background: #ed102b;
        color: #ffffff;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .5px;
    }

    .portfolio-project-content {
        padding: 18px 18px 19px;
    }

        .portfolio-project-content h3 {
            margin: 0 0 8px;
            color: #111111;
            font-size: 19px;
            font-weight: 800;
            line-height: 1.25;
        }

        .portfolio-project-content p {
            margin: 0 0 15px;
            color: #666666;
            font-size: 12px;
            line-height: 1.65;
            /* Maximum 3 lines */
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            /* Same description area height */
            height: calc(12px * 1.65 * 3);
        }

    .portfolio-metrics {
        display: flex;
        gap: 12px;
        margin-bottom: 17px;
        padding-top: 13px;
        border-top: 1px solid #eeeeee;
    }

    .portfolio-metric {
        flex: 1;
        color: #111111;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.4;
    }

        .portfolio-metric i {
            margin-right: 4px;
            color: #ed102b;
        }

    .portfolio-case-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #ed102b;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: all .25s ease;
    }

        .portfolio-case-link:hover {
            color: #b90018;
            gap: 10px;
        }


    /* =========================================================
           TESTIMONIALS
           ========================================================= */

    .portfolio-testimonials {
        padding: 36px 0 40px;
        background: #f7f7f7;
    }

    .portfolio-testimonial-heading {
        text-align: center;
        margin-bottom: 31px;
    }

    .portfolio-testimonial-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #ed102b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

        .portfolio-testimonial-label::before {
            content: "";
            width: 17px;
            height: 2px;
            background: #ed102b;
        }

    .portfolio-testimonial-heading h2 {
        margin: 0;
        color: #111111;
        font-size: 31px;
        font-weight: 800;
    }

        .portfolio-testimonial-heading h2 span {
            color: #ed102b;
        }

    .portfolio-testimonial-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        background: #ffffff;
    }

    .portfolio-testimonial {
        padding: 23px 25px;
    }

        .portfolio-testimonial + .portfolio-testimonial {
            border-left: 1px solid #eeeeee;
        }

    .portfolio-stars {
        margin-bottom: 10px;
        color: #f39a00;
        font-size: 14px;
        letter-spacing: 1px;
    }

    .portfolio-testimonial-text {
        margin: 0 0 17px;
        color: #555555;
        font-size: 12px;
        font-style: italic;
        line-height: 1.75;
    }

    .portfolio-client {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .portfolio-client-image {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        object-fit: cover;
    }

    .portfolio-client-name {
        margin: 0 0 2px;
        color: #111111;
        font-size: 12px;
        font-weight: 800;
    }

    .portfolio-client-role {
        margin: 0;
        color: #555555;
        font-size: 10px;
    }


    /* =========================================================
           FINAL CTA
           ========================================================= */

    .portfolio-cta {
        position: relative;
        overflow: hidden;
        padding: 51px 20px 50px;
        background: #0d0d0d;
        text-align: center;
        border-right: 2px solid #ed102b;
    }

        .portfolio-cta::before {
            content: "";
            position: absolute;
            top: -100px;
            left: 50%;
            width: 300px;
            height: 300px;
            transform: translateX(-50%);
            background: rgba(237, 16, 43, .07);
            border-radius: 50%;
            filter: blur(35px);
        }

    .portfolio-cta-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        margin-bottom: 14px;
        color: #ed102b;
        font-size: 28px;
    }

    .portfolio-cta h2 {
        position: relative;
        margin: 0;
        color: #ffffff;
        font-size: 31px;
        font-weight: 800;
    }

        .portfolio-cta h2 span {
            color: #ed102b;
        }

    .portfolio-cta p {
        position: relative;
        max-width: 560px;
        margin: 10px auto 20px;
        color: #888888;
        font-size: 13px;
        line-height: 1.7;
    }

    .portfolio-cta-buttons {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }

    .portfolio-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 19px;
        background: #ed102b;
        color: #ffffff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: all .25s ease;
    }

        .portfolio-btn-primary:hover {
            background: #c9001d;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .portfolio-btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        border: 1px solid #444444;
        color: #ffffff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: all .25s ease;
    }

        .portfolio-btn-secondary:hover {
            color: #ffffff;
            border-color: #ed102b;
            background: rgba(237, 16, 43, .08);
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991px) {

        .portfolio-container {
            max-width: 900px;
        }

        .portfolio-project-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .portfolio-project-image {
            height: 190px;
        }
    }


    @@media (max-width: 767px) {

        .portfolio-hero {
            padding: 25px 0 35px;
        }

            .portfolio-hero h1 {
                font-size: 32px;
            }

        .portfolio-hero-description {
            font-size: 13px;
        }

        .portfolio-stats {
            gap: 25px;
        }

        .portfolio-stat-number {
            font-size: 19px;
        }

        .portfolio-section {
            padding: 35px 0;
        }

        .portfolio-section-heading h2,
        .portfolio-testimonial-heading h2,
        .portfolio-cta h2 {
            font-size: 27px;
        }

        .portfolio-project-grid {
            grid-template-columns: 1fr;
        }

        .portfolio-project-image {
            height: 210px;
        }

        .portfolio-testimonial-grid {
            grid-template-columns: 1fr;
        }

        .portfolio-testimonial + .portfolio-testimonial {
            border-left: none;
            border-top: 1px solid #eeeeee;
        }

        .portfolio-cta-buttons {
            flex-direction: column;
        }

        .portfolio-btn-primary,
        .portfolio-btn-secondary {
            width: 190px;
            justify-content: center;
        }
    }


    @@media (max-width: 480px) {

        .portfolio-container {
            padding: 0 16px;
        }

        .portfolio-hero h1 {
            font-size: 28px;
        }

        .portfolio-stats {
            gap: 18px;
        }

        .portfolio-stat-label {
            font-size: 9px;
        }

        .portfolio-project-content h3 {
            font-size: 18px;
        }

        .portfolio-project-image {
            height: 190px;
        }

        .portfolio-testimonial {
            padding: 20px;
        }
    }

</style>


<div class="portfolio-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="portfolio-hero">

        <div class="portfolio-container">

            <div class="portfolio-breadcrumb">
                <span>HOME</span>
                <i class="bi bi-chevron-right"></i>
                <span>Projects</span>
            </div>

            <h1>
                Projects That
                <span>Deliver Results</span>
            </h1>

            <p class="portfolio-hero-description">
                A selection of our best work across industries — from healthcare
                to fintech, we build solutions that drive real impact.
            </p>

            @* <div class="portfolio-stats">

                <div class="portfolio-stat">
                    <span class="portfolio-stat-number">100+</span>
                    <span class="portfolio-stat-label">
                        Projects Delivered
                    </span>
                </div>

                <div class="portfolio-stat">
                    <span class="portfolio-stat-number">98%</span>
                    <span class="portfolio-stat-label">
                        Client Satisfaction
                    </span>
                </div>

                <div class="portfolio-stat">
                    <span class="portfolio-stat-number">12+</span>
                    <span class="portfolio-stat-label">
                        Industries Served
                    </span>
                </div>

            </div> *@

        </div>

    </section>


    <!-- =====================================================
         FEATURED PROJECTS
         ===================================================== -->

    <section class="portfolio-section">

        <div class="portfolio-container">

            <div class="portfolio-section-heading">

                <h2>
                    Featured <span>Projects</span>
                </h2>

                <p>
                    Each project represents our commitment to quality and innovation
                </p>

            </div>


            <div class="portfolio-project-grid">


                <!-- PROJECT 1 -->
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var project in Model)
                    {
                        <article class="portfolio-project-card">

                            <div class="portfolio-project-image">

                                <img src="@project.HeroImage" alt="@project.Title">

                                <span class="portfolio-category">
                                    @project.Category
                                </span>

                            </div>

                            <div class="portfolio-project-content">

                                <h3>
                                    @project.Title
                                </h3>

                                <p>
                                    @project.ShortDescription
                                </p>

                                <div class="portfolio-metrics">

                                    @if (!string.IsNullOrEmpty(project.Metric1Value))
                                    {
                                        <div class="portfolio-metric">
                                            <i class="bi @project.Metric1Icon"></i>
                                            @project.Metric1Value @project.Metric1Label
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(project.Metric2Value))
                                    {
                                        <div class="portfolio-metric">
                                            <i class="bi @project.Metric2Icon"></i>
                                            @project.Metric2Value @project.Metric2Label
                                        </div>
                                    }

                                </div>

                                <a asp-controller="Home"
                                   asp-action="ProjectDetail"
                                   asp-route-id="@project.Id"
                                   class="portfolio-case-link">
                                    View Case Study
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <p style="text-align:center; grid-column: 1 / -1; color:#666;">
                        No projects added yet. Add projects from the admin dashboard.
                    </p>
                }

            </div>

        </div>

    </section>


    <!-- =====================================================
         TESTIMONIALS
         ===================================================== -->

    <section class="portfolio-testimonials">

        <div class="portfolio-container">

            <div class="portfolio-testimonial-heading">

                <div class="portfolio-testimonial-label">
                    WHAT OUR CLIENTS SAY
                </div>

                <h2>
                    Trusted by <span>Industry Leaders</span>
                </h2>

            </div>


            <div class="portfolio-testimonial-grid">


                <!-- TESTIMONIAL 1 -->

                <div class="portfolio-testimonial">

                    <div class="portfolio-stars">
                        ★★★★★
                    </div>

                    <p class="portfolio-testimonial-text">
                        "Access Authority delivered a game-changing solution
                        for our hospital. The platform is robust, intuitive,
                        and has transformed how we operate."
                    </p>

                    <div class="portfolio-client">

                        <img src="https://randomuser.me/api/portraits/men/32.jpg"
                             alt="Client"
                             class="portfolio-client-image">

                        <div>
                            <p class="portfolio-client-name">
                                Dr. Rajesh Kumar
                            </p>

                            <p class="portfolio-client-role">
                                CEO, HealthSync Hospital Chain
                            </p>
                        </div>

                    </div>

                </div>


                <!-- TESTIMONIAL 2 -->

                <div class="portfolio-testimonial">

                    <div class="portfolio-stars">
                        ★★★★★
                    </div>

                    <p class="portfolio-testimonial-text">
                        "The FinVault platform has been a cornerstone of our
                        digital transformation. Reliable, secure, and
                        feature-rich — exactly what we needed."
                    </p>

                    <div class="portfolio-client">

                        <img src="https://randomuser.me/api/portraits/women/63.jpg"
                             alt="Client"
                             class="portfolio-client-image">

                        <div>
                            <p class="portfolio-client-name">
                                Priya Sharma
                            </p>

                            <p class="portfolio-client-role">
                                CTO, FinVault Solutions
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL CTA
         ===================================================== -->

    <section class="portfolio-cta">

        <div class="portfolio-cta-icon">
            <i class="bi bi-rocket-takeoff-fill"></i>
        </div>

        <h2>
            Ready to Build Your
            <span>Next Project?</span>
        </h2>

        <p>
            We'd love to help you build something great.
            Let's talk about your vision and turn it into reality.
        </p>

        <div class="portfolio-cta-buttons">

            <a asp-controller="Home"
               asp-action="FreeConsultation"
               class="portfolio-btn-primary">

                <i class="bi bi-arrow-right"></i>
                Start Your Project

            </a>

            <a asp-controller="Home"
               asp-action="Services"
               class="portfolio-btn-secondary">

                <i class="bi bi-gear-fill"></i>
                Explore Services

            </a>

        </div>

    </section>

</div>