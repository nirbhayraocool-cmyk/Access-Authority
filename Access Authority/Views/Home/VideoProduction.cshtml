@{
    ViewData["Title"] = "Video Production";
}

<style>

    /* =====================================================
           BREADCRUMB
        ===================================================== */

    .breadcrumb-section {
        background: #0d0d0d;
        height: 50px;
        display: flex;
        align-items: center;
    }

    .breadcrumb {
        margin: 0;
    }

    .breadcrumb-item {
        font-size: 14px;
    }

        .breadcrumb-item a {
            color: #fff;
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: #ed001c;
            font-weight: 600;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: #fff;
        }


    /* =====================================================
           HERO
        ===================================================== */

    .hero {
       
        background: radial-gradient( circle at 78% 45%, rgba(237, 0, 28, 0.14), transparent 35% ), linear-gradient( 110deg, #080808 0%, #12090b 55%, #0d0d0d 100% );
        color: #fff;
        padding: 65px 0 70px;
        position: relative;
        overflow: hidden;
    }

        .hero::after {
            content: "";
            position: absolute;
            right: -100px;
            bottom: -160px;
            width: 420px;
            height: 420px;
            border: 1px solid rgba(237,0,28,.18);
            border-radius: 50%;
        }

    .hero-icon {
        width: 70px;
        height: 70px;
        background: #20090d;
        display: flex;
        align-items: center;
        justify-content: center;
        clip-path: polygon( 0 0, 82% 0, 100% 20%, 100% 100%, 20% 100%, 0 80% );
    }

        .hero-icon i {
            color: #ed001c;
            font-size: 31px;
        }

    .hero h1 {
        font-size: 55px;
        font-weight: 700;
        margin-top: 20px;
        line-height: 1.1;
    }

        .hero h1 span {
            color: #ed001c;
        }

    .hero-description {
        color: #9b9b9b;
        font-size: 18px;
        line-height: 1.7;
        max-width: 680px;
        margin-top: 16px;
    }

    .hero-buttons {
        margin-top: 28px;
    }

    .consultation-btn {
        background: #ed001c;
        color: #fff;
        border: none;
        padding: 14px 27px;
        font-weight: 600;
        clip-path: polygon( 0 0, 94% 0, 100% 20%, 100% 100%, 6% 100%, 0 80% );
        transition: .3s ease;
    }

        .consultation-btn:hover {
            background: #c90018;
            color: #fff;
            transform: translateY(-2px);
        }

    .work-btn {
        background: transparent;
        color: #fff;
        border: 1px solid #4b4b4b;
        padding: 13px 25px;
        transition: .3s ease;
    }

        .work-btn:hover {
            border-color: #ed001c;
            color: #ed001c;
        }


    /* =====================================================
           COMMON
        ===================================================== */

    .section {
        padding: 90px 0;
    }

    .section-title-small {
        color: #ed001c;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .section-title {
        font-size: 38px;
        font-weight: 700;
        line-height: 1.15;
        color: #111;
    }

    .section-text {
        color: #666;
        font-size: 15px;
        line-height: 1.2;
    }


    /* =====================================================
           WHAT WE CREATE
        ===================================================== */

    .what-we-create {
        background: #fff;
    }

    .video-main-image {
        width: 100%;
        height: 450px;
        object-fit: cover;
        display: block;
        border-radius: 4px;
        filter: brightness(.88);
    }

    .video-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .video-play {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 72px;
        height: 72px;
        background: #ed001c;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        box-shadow: 0 10px 30px rgba(0,0,0,.30);
        transition: .35s ease;
    }

    .video-image-wrapper:hover .video-play {
        transform: translate(-50%, -50%) scale(1.12);
        box-shadow: 0 15px 40px rgba(237,0,28,.35);
    }

    .video-list {
        list-style: none;
        padding: 0;
        margin-top: 25px;
    }

        .video-list li {
            margin-bottom: 16px;
            color: #333;
            font-size: 15px;
            font-weight: 500;
        }

        .video-list i {
            color: #ed001c;
            margin-right: 9px;
        }

    .video-stat {
        margin-top: 30px;
        border-left: 3px solid #ed001c;
        padding-left: 18px;
    }

        .video-stat strong {
            font-size: 24px;
            color: #111;
        }

        .video-stat span {
            display: block;
            color: #777;
            font-size: 13px;
            margin-top: 3px;
        }

    .what-we-create .section-title {
        font-size: 34px;
        font-weight: 650;
        line-height: 1.2;
    }

    .what-we-create .section-text {
        font-size: 15px;
        font-weight: 400;
        line-height: 1.7;
    }

    .what-we-create .video-list li {
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 13px;
    }

    .what-we-create .video-stat strong {
        font-size: 17px;
        font-weight: 600;
    }

    .what-we-create .video-stat span {
        font-size: 12px;
    }

    /* =====================================================
           DIVIDER
        ===================================================== */

    .red-divider {
        text-align: center;
        color: #ed001c;
        letter-spacing: 7px;
        font-size: 12px;
        margin: 0 auto;
        padding: 5px 0;
    }


    /* =====================================================
           VIDEO TYPES
        ===================================================== */

    .video-types {
        background: #f7f7f7;
    }

    .video-card {
        background: #fff;
        border: 1px solid #e4e4e4;
        padding: 30px;
        height: 100%;
        border-radius:10px;
        position: relative;
        overflow: hidden;
        transition: all .35s ease;
    }

        .video-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 3px;
            background: #ed001c;
            transition: width .35s ease;
        }

        .video-card:hover {
            transform: translateY(-8px);
            border-color: #ed001c;
            box-shadow: 0 15px 35px rgba(0,0,0,.10);
        }

            .video-card:hover::before {
                width: 100%;
            }

    .video-card-icon {
        width: 55px;
        height: 55px;
        background: #fff0f2;
        color: #ed001c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        border: 1px solid #f4d4d8;
        transition: all .35s ease;
    }

    .video-card:hover .video-card-icon {
        background: #ed001c;
        color: #fff;
        transform: rotate(-5deg) scale(1.08);
        box-shadow: 0 8px 20px rgba(237,0,28,.25);
    }

    .video-card h4 {
        margin-top: 24px;
        font-size: 20px;
        font-weight: 700;
        color: #111;
        transition: .3s ease;
    }

    .video-card:hover h4 {
        color: #ed001c;
    }

    .video-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin-top: 10px;
        margin-bottom: 0;
    }


    /* =====================================================
           MARKETING + TRAINING
        ===================================================== */

    .purpose-section {
        background: #fff;
    }

    .purpose-box {
        height: 100%;
        padding: 35px;
        border: 1px solid #dedede;
        position: relative;
        border-radius:10px;
        overflow: hidden;
        transition: all .35s ease;
    }

        .purpose-box::after {
            content: "";
            position: absolute;
            right: -35px;
            bottom: -35px;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            border: 1px solid #f2d0d4;
            transition: .4s ease;
        }

        .purpose-box:hover {
            border-color: #ed001c;
            transform: translateY(-7px);
            box-shadow: 0 15px 35px rgba(0,0,0,.08);
        }

            .purpose-box:hover::after {
                transform: scale(1.7);
                border-color: #ed001c;
            }

    .purpose-label {
        color: #ed001c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .purpose-box h3 {
        color: #111;
        font-size: 27px;
        font-weight: 700;
        margin-top: 12px;
    }

    .purpose-box p {
        color: #666;
        font-size: 15px;
        line-height: 1.8;
        margin-top: 14px;
    }

    .purpose-list {
        padding: 0;
        margin: 22px 0 0;
        list-style: none;
    }

        .purpose-list li {
            color: #333;
            font-size: 14px;
            margin-bottom: 13px;
        }

        .purpose-list i {
            color: #ed001c;
            margin-right: 8px;
        }


    /* =====================================================
           PRODUCTION PROCESS
        ===================================================== */

    .process-section {
        background: #f7f7f7;
    }

    .process-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        min-height: 245px;
        padding: 28px 24px;
        border-radius: 10px;
        position: relative;
        overflow: hidden;
        transition: all .35s ease;
    }

        .process-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 3px;
            width: 0;
            background: #ed001c;
            transition: .35s ease;
        }

        .process-card:hover {
            border-color: #ed001c;
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,.10);
        }

            .process-card:hover::before {
                width: 100%;
            }

    .process-number {
        font-size: 12px;
        color: #ed001c;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .process-icon {
        width: 50px;
        height: 50px;
        background: #fff0f2;
        color: #ed001c;
        display: flex;
        align-items: center;
        justify-content: center;
        float: right;
        font-size: 21px;
        transition: .35s ease;
    }

    .process-card:hover .process-icon {
        background: #ed001c;
        color: #fff;
        transform: rotate(-5deg) scale(1.08);
    }

    .process-card h4 {
        clear: both;
        margin-top: 48px;
        color: #111;
        font-size: 19px;
        font-weight: 700;
    }

    .process-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin-top: 10px;
    }


    /* =====================================================
           VIDEO TOOLKIT
        ===================================================== */

    .toolkit-section {
        background: #fff;
        padding: 80px 0;
    }

    .tool-box {
        height: 115px;
        background: #fff;
        border: 1px solid #e2e2e2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 20px;
        font-weight: 600;
        border-radius: 10px;
        color: #222;
        position: relative;
        overflow: hidden;
        transition: all .35s ease;
    }

        .tool-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 3px;
            background: #ed001c;
            transition: .35s ease;
        }

        .tool-box:hover {
            border-color: #ed001c;
            transform: translateY(-7px);
            box-shadow: 0 15px 30px rgba(0,0,0,.08);
        }

            .tool-box:hover::before {
                width: 100%;
            }

    .tool-icon {
        width: 48px;
        height: 48px;
        background: #fff0f2;
        color: #ed001c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        transition: .35s ease;
    }

    .tool-box:hover .tool-icon {
        background: #ed001c;
        color: #fff;
        transform: rotate(-5deg) scale(1.1);
    }

    .tool-box span {
        transition: .3s ease;
    }

    .tool-box:hover span {
        color: #ed001c;
    }


    /* =====================================================
           WHY CHOOSE US
        ===================================================== */

    .why-section {
        background: #fff !important;
        background-color: #fff !important;
        color: #111;
        position: relative;
        z-index: 1;
    }

    .why-box {
        height: 100%;
        min-height: 225px;
        padding: 28px 24px;
        border-radius: 10px;
        border: 1px solid #dedede;
        background: #fff;
        position: relative;
        overflow: hidden;
        transition: all .35s ease;
    }

        .why-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 3px;
            background: #ed001c;
            transition: .35s ease;
        }

        .why-box:hover {
            transform: translateY(-8px);
            border-color: #ed001c;
            box-shadow: 0 15px 35px rgba(0,0,0,.10);
        }

            .why-box:hover::before {
                width: 100%;
            }

    .why-icon {
        width: 52px;
        height: 52px;
        background: #fff0f2;
        color: #ed001c;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #f2d2d6;
        font-size: 21px;
        transition: all .35s ease;
    }

    .why-box:hover .why-icon {
        background: #ed001c;
        color: #fff;
        border-color: #ed001c;
        transform: translateY(-4px) rotate(-5deg) scale(1.08);
        box-shadow: 0 8px 18px rgba(237,0,28,.25);
    }

    .why-box h4 {
        font-size: 19px;
        font-weight: 700;
        color: #111;
        margin-top: 20px;
        transition: .3s ease;
    }

    .why-box:hover h4 {
        color: #ed001c;
    }

    .why-box p {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin: 9px 0 0;
    }


    /* =====================================================
           TESTIMONIAL
        ===================================================== */

    .testimonial {
        background: white;
        color: #141313;
        padding: 70px 8%;
        text-align: center;
        border-top: 2px solid #141313;
    }

    .testimonial-text {
        color: #0e0101;
        font-size: 18px;
        line-height: 1.8;
        font-style: italic;
        max-width: 900px;
        margin: 0 auto;
    }

    .profile {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 30px;
    }

        .profile img {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            margin-right: 15px;
            object-fit: cover;
        }

    .profile-name {
        font-weight: 700;
        text-align: left;
    }

    .profile-role {
        color: #666;
        font-size: 13px;
        text-align: left;
        margin-top: 3px;
    }


    /* =====================================================
           CTA
        ===================================================== */

    .cta-section {
        background: #0d0d0d;
        padding: 85px 0;
        color: #fff;
        text-align: center;
    }

        .cta-section h2 {
            font-size: 42px;
            font-weight: 700;
        }

        .cta-section p {
            color: #999;
            font-size: 17px;
            margin-top: 12px;
        }


    /* =====================================================
           WHATSAPP
        ===================================================== */

    .whatsapp {
        position: fixed;
        right: 27px;
        bottom: 25px;
        width: 49px;
        height: 49px;
        background: #20d366;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 25px;
        z-index: 1000;
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
        text-decoration: none;
    }


    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media(max-width: 991px) {

        .hero h1 {
            font-size: 45px;
        }

        .video-main-image {
            margin-top: 40px;
        }

        .section {
            padding: 70px 0;
        }

        .cta-section h2 {
            font-size: 36px;
        }
    }


    @@media(max-width: 576px) {

        .hero {
            padding: 45px 0 55px;
        }

            .hero h1 {
                font-size: 38px;
            }

        .hero-description {
            font-size: 16px;
        }

        .consultation-btn,
        .work-btn {
            margin-bottom: 10px;
        }

        .section {
            padding: 60px 0;
        }

        .section-title {
            font-size: 31px;
        }

        .video-main-image {
            height: 300px;
        }

        .video-play {
            width: 60px;
            height: 60px;
            font-size: 22px;
        }

        .cta-section h2 {
            font-size: 31px;
        }

        .testimonial {
            padding: 50px 20px;
        }

        .testimonial-text {
            font-size: 16px;
        }
    }

</style>


<!-- =====================================================
     HERO
===================================================== -->

<section class="hero">

    <div class="container px-5">

        @* <div class="hero-icon">
            <i class="bi bi-camera-reels-fill"></i>
        </div> *@

        <h1>
            Video <span>Production</span>
        </h1>

        <p class="hero-description">
            Marketing and training videos that turn your message
            into clear, engaging, and memorable visual experiences
            for customers, employees, and audiences.
        </p>

        <div class="d-flex flex-wrap gap-2 hero-buttons">

            <a href="mailto:nirbhayraocool@gmail.com" class="btn consultation-btn">
                <i class="bi bi-play-circle-fill"></i>
                &nbsp; Start a Video Project
            </a>

            <a href="#video-types" class="btn work-btn">
                <i class="bi bi-arrow-down"></i>
                Explore Our Videos
            </a>

        </div>

    </div>

</section>


<!-- =====================================================
     WHAT WE DO
===================================================== -->

<section class="section what-we-create">

    <div class="container px-5">

        <div class="row align-items-center">

           

            <!-- RIGHT CONTENT -->

            <div class="col-lg-6 ps-lg-5">

                <div class="section-title-small">
                    Visual Storytelling
                </div>

                <h2 class="section-title mt-3">
                    Videos That
                    <span style="color:#ed001c;">
                        Communicate
                    </span>
                </h2>

