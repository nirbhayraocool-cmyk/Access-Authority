                    We create purpose-driven videos for marketing,
                    corporate communication, product promotion,
                    employee training, and digital learning.
                </p>


                <ul class="video-list">

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Marketing & promotional videos
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Employee training & onboarding
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Corporate & explainer videos
                    </li>

                </ul>


                <div class="video-stat">

                    <strong>
                        Story + Strategy + Visuals
                    </strong>

                    <span>
                        Everything your video needs to make an impact.
                    </span>

                </div>

            </div>
            <!-- LEFT IMAGE -->

            <div class="col-lg-6">

                <div class="video-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=1000&q=85&auto=format&fit=crop"
                         class="video-main-image"
                         alt="Professional Video Production">

                    @*   <div class="video-play">
                        <i class="bi bi-play-fill"></i>
                    </div> *@

                </div>

            </div>


        </div>

    </div>

</section>


