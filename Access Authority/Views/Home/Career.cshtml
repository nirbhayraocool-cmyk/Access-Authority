<section class="page-hero-custom bg-black">
    <div class="container px-5">
        
            <div class="">
                <div class="breadcrumb-custom">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Career</span>
                </div>

                <h1 class="text-danger">Build Your Career With Us</h1>

                <p>
                    Join Access Authority and become part of a team
                    that builds innovative digital solutions.Access Authority
                    and become part of a team
                </p>
            </div>

    </div>
</section>
<section class="services-section">

    <div class="container px-5 pt-5">

        <div class="row g-4">

            @if (careerPositions != null && careerPositions.Any())
            {
                foreach (var job in careerPositions)
                {
                    <div class="col-xl-4 col-lg-6">

                        <div class="card-premium">

                            <div class="job-card-inner">

                                <!-- TOP -->
                                <div class="job-card-top">

                                    <span class="job-location-badge">

                                        @if (!string.IsNullOrEmpty(job.Location))
                                        {
                                            if (job.Location.ToLower().Contains("remote"))
                                            {
                                                <i class="bi bi-wifi"></i>
                                                @:Remote
                                            }
                                            else
                                            {
                                                <i class="bi bi-geo-alt-fill"></i>
                                                @job.Location
                                            }
                                        }
                                        else
                                        {
                                            <i class="bi bi-geo-alt-fill"></i>
                                            @:Location
                                        }

                                    </span>

                                    <span class="job-posted-date">

                                        <i class="bi bi-calendar3"></i>

                                        @job.PostedDate.ToString("MMM dd, yyyy")

                                    </span>

                                </div>


                                <!-- JOB TITLE -->

                                <h5 class="job-card-title">

                                    @job.JobTitle

                                </h5>


                                <!-- DESCRIPTION -->

                                <p class="job-card-description">

                                    <i class="bi bi-briefcase-fill"></i>

                                    @job.Description

                                </p>


                                <!-- JOB META -->

                                <div class="job-meta-wrapper">

                                    @if (!string.IsNullOrEmpty(job.Type))
                                    {
                                        <span class="job-meta-badge type">

                                            <i class="bi bi-clock-history"></i>

                                            @job.Type

                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(job.Status))
                                    {
                                        <span class="job-meta-badge status">

                                            <i class="bi bi-check-circle-fill"></i>

                                            @job.Status

                                        </span>
                                    }

                                </div>


                                <!-- BOTTOM -->

                                <div class="job-card-bottom">

                                    <div class="job-open-info">

                                        <div class="job-open-icon">

                                            <i class="bi bi-person-workspace"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                Open Position
                                            </strong>

                                            <span>
                                                Join our team
                                            </span>

                                        </div>

                                    </div>


                                    <!-- APPLY -->

                                    <button type="button"
                                            class="btn btn-danger btn-sm rounded-pill career-apply-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#careerApplyModal"
                                            data-job-id="@job.Id"
                                            data-job-title="@job.JobTitle">

                                        Apply

                                        <i class="bi bi-arrow-right-short"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="text-center py-5">

                        <i class="bi bi-briefcase fs-1 text-secondary"></i>

                        <h5 class="mt-3">
                            No Open Positions
                        </h5>

                        <p class="text-secondary">
                            There are currently no open positions available.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- CAREER APPLY MODAL -->
   
    <div class="modal fade career-apply-modal"
         id="careerApplyModal"
         tabindex="-1"
         aria-labelledby="careerApplyModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content career-modal-content">

                <div class="modal-header career-modal-header">

                    <h5 class="modal-title"
                        id="careerApplyModalLabel">

                        <i class="bi bi-person-plus text-danger me-2"></i>
                        Career Application

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <form asp-controller="Home"
                      asp-action="Career"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()


                    <div class="modal-body career-modal-body">

                        <!-- SELECTED JOB -->

                        <div class="career-selected-job mb-4">

                            <label class="form-label">
                                Applying For
                            </label>

                            <input type="text"
                                   id="careerSelectedJob"
                                   class="form-control"
                                   value=""
                                   readonly />

                        </div>


                        <div class="row g-3">

                            <input type="hidden"
                                   asp-for="CareerPositionId"
                                   id="careerPositionId" />

                            <!-- Full Name -->

                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label">

                                    Full Name *

                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter full name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Email -->

                            <div class="col-md-6">

                                <label asp-for="EmailAddress"
                                       class="form-label">

                                    Email Address *

                                </label>

                                <input asp-for="EmailAddress"
                                       type="email"
                                       class="form-control"
                                       placeholder="example@gmail.com" />

                                <span asp-validation-for="EmailAddress"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Phone -->

                            <div class="col-md-6">

                                <label asp-for="PhoneNumber"
                                       class="form-label">

                                    Phone Number *

                                </label>

                                <input asp-for="PhoneNumber"
                                       type="tel"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- LinkedIn -->

                            <div class="col-md-6">

                                <label asp-for="LinkedInProfile"
                                       class="form-label">

                                    LinkedIn Profile

                                </label>

                                <input asp-for="LinkedInProfile"
                                       type="url"
                                       class="form-control"
                                       placeholder="https://linkedin.com/in/username" />

                                <span asp-validation-for="LinkedInProfile"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Resume -->

                            <div class="col-md-12">

                                <label asp-for="Resume"
                                       class="form-label">

                                    Resume *

                                </label>

                                <input asp-for="Resume"
                                       type="file"
                                       class="form-control"
                                       accept=".pdf,.doc,.docx" />

                                <small class="text-secondary">
                                    Allowed files: PDF, DOC, DOCX
                                </small>

                                <span asp-validation-for="Resume"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- MODAL FOOTER -->

                    <div class="modal-footer career-modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-check-lg"></i>
                            Save Application

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


