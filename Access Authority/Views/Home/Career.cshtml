<!-- =====================================================
     CAREER PAGE JS
     COMPLETELY ISOLATED FROM LAYOUT JS
===================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        "use strict";

        (function () {

            /*
             * ================================================
             * CAREER APPLY BUTTONS
             * ================================================
             */

            const careerApplyButtons =
                document.querySelectorAll(".career-apply-btn");

            const careerJobInput =
                document.getElementById("careerSelectedJob");


            const careerPositionIdInput =
               document.getElementById("careerPositionId");

            const careerModal =
                document.getElementById("careerApplyModal");


            /*
             * ================================================
             * SET SELECTED JOB
             * ================================================
             */

                careerApplyButtons.forEach(function (careerButton) {
                  careerButton.addEventListener("click", function () {

             const careerJobTitle =
                this.getAttribute("data-job-title");

            const careerJobId =
                this.getAttribute("data-job-id");

            if (careerJobInput) {
                careerJobInput.value =
                    careerJobTitle || "";
            }

            if (careerPositionIdInput) {
                careerPositionIdInput.value =
                    careerJobId || "";
            }
              });
                });

            /*
             * ================================================
             * RESET MODAL AFTER CLOSE
             * ================================================
             */

            if (careerModal) {

                careerModal.addEventListener(
                    "hidden.bs.modal",
                    function () {

                        if (careerJobInput) {

                            careerJobInput.value = "";

                        }

                    }
                );

            }

        })();

    });

</script>

