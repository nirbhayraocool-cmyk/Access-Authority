
@model Access_Authority.Models.CareerViewModel
@{
    var careerPositions = ViewBag.CareerPositions
        as List<Access_Authority.Models.CareerPosition>;
}
@{
    ViewData["Title"] = "Career";
}

<style>

    /* ===== TEAM PAGE HERO ===== */

    .page-hero-custom {
        background: #f7f7f7;
        padding: 55px 0 40px;
        border-bottom: 1px solid #e8e8e8;
    }
    /* Breadcrumb */

    .breadcrumb-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 16px;
    }

        .breadcrumb-custom a {
            color: #d62828;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s ease;
        }

            .breadcrumb-custom a:hover {
                color: #a91f1f;
            }

        .breadcrumb-custom span {
            color: #777;
            font-weight: 500;
        }
    /* Heading */

    .page-hero-custom h1 {
        font-size: 46px;
        line-height: 1.2;
        font-weight: 800;
        color: #171717;
        margin-bottom: 12px;
    }
    /* Description */

    .page-hero-custom p {
        max-width: 700px;
        font-size: 16px;
        line-height: 1.7;
        color: #666;
        margin-bottom: 0;
    }
    /* Responsive */

    @@media (max-width: 767px) {
        .page-hero-custom {
            padding: 45px 0 35px;
        }

            .page-hero-custom h1 {
                font-size: 36px;
            }

            .page-hero-custom p {
                font-size: 15px;
            }
    }
    /* =====================================================
           PAGE HERO
        ===================================================== */

    .page-hero-custom {
        background: #f7f7f7;
        padding: 55px 0 40px;
        border-bottom: 1px solid #eaeaea;
    }

        /* .page-hero-custom .breadcrumb-custom {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.8px;
            color: #999;
            margin-bottom: 14px;
        }

            .page-hero-custom .breadcrumb-custom a {
                color: #fff;
                text-decoration: none;
                transition: color 0.2s;
            } */

                .page-hero-custom .breadcrumb-custom a:hover {
                    color: #ed0026;
                }

            .page-hero-custom .breadcrumb-custom .separator {
                color: #ccc;
                margin: 0 8px;
            }

            .page-hero-custom .breadcrumb-custom .active {
                color: #ed0026;
            }

        .page-hero-custom h1 {
            font-size: 38px;
            font-weight: 800;
            color: #fff;
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

            .page-hero-custom h1 span {
                color: #ed0026;
            }

        .page-hero-custom .subtitle {
            font-size: 14px;
            color: #555;
            margin: 0;
            max-width: 520px;
            line-height: 1.6;
        }


    /* =====================================================
           MINI STATS
        ===================================================== */

    .mini-stats-custom {
        background: #0b0b0b;
        color: #fff;
        padding: 22px 0;
        border-bottom: 1px solid #202020;
    }

        .mini-stats-custom .stat-block {
            border-right: 1px solid #292929;
            padding: 5px 15px;
            text-align: center;
        }

            .mini-stats-custom .stat-block:last-child {
                border-right: none;
            }

        .mini-stats-custom .stat-number {
            color: #ed0026;
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

            .mini-stats-custom .stat-number .suffix {
                color: #ed0026;
            }

        .mini-stats-custom .stat-label {
            color: #686868;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.8px;
            margin-top: 5px;
        }


    /* =====================================================
           PORTFOLIO CARDS
        ===================================================== */

    .portfolio-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .portfolio-card:hover {
            border-color: #ed0026;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
            transform: translateY(-4px);
        }

        .portfolio-card .portfolio-image {
            height: 220px;
            position: relative;
            overflow: hidden;
            background: #f0f0f0;
        }

            .portfolio-card .portfolio-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .portfolio-card:hover .portfolio-image img {
            transform: scale(1.05);
        }

        .portfolio-card .portfolio-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: #ed0026;
            color: #fff;
            padding: 4px 12px;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .portfolio-card .portfolio-body {
            padding: 20px 22px 22px;
        }

        .portfolio-card .portfolio-industry {
            color: #ed0026;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .portfolio-card h3 {
            font-size: 17px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
        }

        .portfolio-card .portfolio-desc {
            font-size: 12px;
            color: #555;
            line-height: 1.6;
            margin: 0 0 14px 0;
        }

        .portfolio-card .portfolio-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding: 12px 0;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
            margin-bottom: 14px;
        }

            .portfolio-card .portfolio-stats div {
                display: flex;
                flex-direction: column;
            }

            .portfolio-card .portfolio-stats strong {
                color: #ed0026;
                font-size: 18px;
                font-weight: 700;
                line-height: 1.2;
            }

            .portfolio-card .portfolio-stats span {
                color: #777;
                font-size: 8px;
                font-weight: 600;
                letter-spacing: 0.3px;
                text-transform: uppercase;
            }

        .portfolio-card .portfolio-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #111;
            font-size: 10px;
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s;
        }

            .portfolio-card .portfolio-link i {
                color: #ed0026;
                font-size: 12px;
                transition: transform 0.2s;
            }

            .portfolio-card .portfolio-link:hover {
                color: #ed0026;
            }

                .portfolio-card .portfolio-link:hover i {
                    transform: translateX(4px);
                }


    /* =====================================================
           TESTIMONIAL
        ===================================================== */

    .testimonial-enhanced {
        background: #f7f7f7;
        padding: 38px 42px;
        border-left: 4px solid #ed0026;
        border-radius: 2px;
        transition: box-shadow 0.3s ease;
    }

        .testimonial-enhanced:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        }

        .testimonial-enhanced .quote-icon {
            font-size: 42px;
            color: #ed0026;
            opacity: 0.12;
            line-height: 1;
            margin-bottom: 4px;
        }

        .testimonial-enhanced blockquote {
            font-size: 17px;
            font-weight: 400;
            color: #111;
            line-height: 1.7;
            margin: 0 0 18px 0;
        }

        .testimonial-enhanced .client-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #ed0026;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .testimonial-enhanced .client-name {
            font-size: 14px;
            font-weight: 700;
            color: #111;
            margin: 0;
        }

        .testimonial-enhanced .client-title {
            font-size: 12px;
            color: #777;
            margin: 0;
        }


    /* =====================================================
           BADGE STYLES
        ===================================================== */

    .badge-soft {
        padding: 5px 14px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.7rem;
        display: inline-block;
    }

    .badge-soft-success {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-soft-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-soft-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-soft-blue {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-soft-purple {
        background: #ede9fe;
        color: #5b21b6;
    }

    .badge-soft-info {
        background: #cffafe;
        color: #0e7490;
    }


    /* =====================================================
       CAREER OPEN POSITIONS - PREMIUM JOB CARDS
    ===================================================== */

    .card-premium {
        position: relative;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 0;
        overflow: hidden;
        height: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
    }

        .card-premium::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: #ed0026;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .card-premium:hover {
            border-color: #ed0026;
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
        }

            .card-premium:hover::before {
                transform: scaleX(1);
            }


    /* CARD INNER CONTENT */

    .job-card-inner {
        padding: 24px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }


    /* TOP ROW */

    .job-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .job-location-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff1f2;
        color: #ed0026;
        border: 1px solid #ffd6db;
        border-radius: 50px;
        padding: 6px 12px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .3px;
    }

        .job-location-badge i {
            font-size: 11px;
        }

    .job-posted-date {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #8a8a8a;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

        .job-posted-date i {
            color: #ed0026;
        }


    /* TITLE */

    .job-card-title {
        font-size: 20px;
        font-weight: 750;
        color: #111;
        line-height: 1.35;
        margin: 0 0 10px;
    }

        .job-card-title:hover {
            color: #ed0026;
        }


    /* DESCRIPTION */

    .job-card-description {
        color: #666;
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 18px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .job-card-description i {
            color: #ed0026;
            margin-right: 5px;
        }


    /* JOB META */

    .job-meta-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 20px;
    }

    .job-meta-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .2px;
    }

        .job-meta-badge.type {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .job-meta-badge.status {
            background: #ecfdf5;
            color: #047857;
        }

        .job-meta-badge i {
            font-size: 10px;
        }


    /* BOTTOM */

    .job-card-bottom {
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid #eeeeee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .job-open-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .job-open-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #fff1f2;
        color: #ed0026;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .job-open-info strong {
        display: block;
        color: #222;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
    }

    .job-open-info span {
        display: block;
        color: #999;
        font-size: 9px;
        margin-top: 3px;
    }


    /* APPLY BUTTON */

    .career-apply-btn {
        border: none !important;
        background: #ed0026 !important;
        font-size: 10px !important;
        font-weight: 700 !important;
        padding: 9px 17px !important;
        box-shadow: none !important;
        transition: all .25s ease !important;
    }

        .career-apply-btn:hover {
            background: #c90020 !important;
            transform: translateX(2px);
            box-shadow: 0 6px 15px rgba(237, 0, 38, .18) !important;
        }

        .career-apply-btn i {
            font-size: 14px;
            vertical-align: middle;
        }


    /* RESPONSIVE */

    @@media (max-width: 991px) {

        .job-card-inner {
            padding: 21px;
        }

        .job-card-title {
            font-size: 18px;
        }
    }

    @@media (max-width: 575px) {

        .job-card-inner {
            padding: 18px;
        }

        .job-card-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .job-posted-date {
            font-size: 9px;
        }

        .job-card-title {
            font-size: 17px;
        }

        .job-card-bottom {
            align-items: flex-start;
            flex-direction: column;
        }

        .career-apply-btn {
            width: 100%;
        }

        .job-open-info {
            width: 100%;
        }
    }
    /* =====================================================
           CAREER MODAL - UNIQUE / ISOLATED
           Layout ke modal CSS se conflict nahi karega
        ===================================================== */

    .career-apply-modal .career-modal-content {
        border-radius: 14px !important;
        border: none !important;
        overflow: hidden;
    }

    .career-apply-modal .career-modal-header {
        padding: 28px 32px 0 32px !important;
        border-bottom: none !important;
    }

    .career-apply-modal .career-modal-body {
        padding: 20px 32px 32px 32px !important;
    }

    .career-apply-modal .career-modal-footer {
        padding: 0 32px 28px 32px !important;
        border-top: none !important;
    }

    .career-apply-modal .career-selected-job {
        background: #f8f9fa;
        border-left: 4px solid #ed0026;
        padding: 12px 15px;
    }

        .career-apply-modal .career-selected-job .form-label {
            font-size: 11px;
            font-weight: 700;
            color: #777;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .career-apply-modal .career-selected-job input {
            border: none;
            background: transparent;
            padding: 0;
            font-weight: 700;
            color: #111;
            box-shadow: none !important;
        }

    .career-apply-modal .form-control {
        border-radius: 6px;
    }

        .career-apply-modal .form-control:focus {
            border-color: #ed0026;
            box-shadow: 0 0 0 0.15rem rgba(237, 0, 38, 0.15);
        }


    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 991px) {

        .page-hero-custom h1 {
            font-size: 30px;
        }

        .mini-stats-custom .stat-block {
            border-right: none;
            padding: 5px 8px;
        }

        .portfolio-card .portfolio-image {
            height: 200px;
        }

        .testimonial-enhanced {
            padding: 25px 20px;
        }
    }


    @@media (max-width: 575px) {

        .page-hero-custom {
            padding: 35px 0 25px;
        }

            .page-hero-custom h1 {
                font-size: 24px;
            }

            .page-hero-custom .subtitle {
                font-size: 12px;
            }

        .mini-stats-custom .stat-number {
            font-size: 22px;
        }

        .testimonial-enhanced blockquote {
            font-size: 14px;
        }

        .portfolio-card .portfolio-image {
            height: 180px;
        }

        .portfolio-card .portfolio-stats {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 576px) {

        .career-apply-modal .career-modal-header {
            padding: 20px 18px 0 18px !important;
        }

        .career-apply-modal .career-modal-body {
            padding: 18px !important;
        }

        .career-apply-modal .career-modal-footer {
            padding: 0 18px 20px 18px !important;
        }
    }

</style>
