                </div>

            </div>


            <!-- REACT -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="technology-box">

                    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a7/React-icon.svg"
                         class="img-fluid"
