    document.addEventListener("DOMContentLoaded", function () {

        const faqItems = document.querySelectorAll(".aa-faq-item");

        faqItems.forEach(function (item) {

            const question = item.querySelector(".aa-faq-question");
            const answer = item.querySelector(".aa-faq-answer");

            if (!question || !answer) return;

            /* Initially closed */
            answer.style.maxHeight = "0";
            answer.style.overflow = "hidden";
            answer.style.transition = "max-height 0.35s ease, padding 0.35s ease, opacity 0.3s ease";
            answer.style.opacity = "0";
            answer.style.padding = "0 0";

            question.addEventListener("click", function () {

                const isOpen = item.classList.contains("open");

                /* Close ALL other open items (accordion behavior) */
                faqItems.forEach(function (other) {
                    if (other !== item) {
                        other.classList.remove("open");
                        const oQ = other.querySelector(".aa-faq-question");
                        const oA = other.querySelector(".aa-faq-answer");
                        if (oA) {
                            oA.style.maxHeight = "0";
                            oA.style.opacity = "0";
                            oA.style.padding = "0 0";
                        }
                        if (oQ) oQ.classList.remove("active");
                    }
                });

                /* Toggle current */
                if (isOpen) {

                    item.classList.remove("open");
                    question.classList.remove("active");
                    answer.style.maxHeight = "0";
                    answer.style.opacity = "0";
                    answer.style.padding = "0 0";

                } else {

                    item.classList.add("open");
                    question.classList.add("active");
                    answer.style.maxHeight = answer.scrollHeight + 40 + "px";
                    answer.style.opacity = "1";
                    answer.style.padding = "12px 0 4px 0";
                }

            });

        });

    });

</script>