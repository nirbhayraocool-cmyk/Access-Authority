<script>
    (function() {
      "use strict";

      const counters = document.querySelectorAll('.counter');
      let animationStarted = false;
      let observer = null;

      function startCounters() {
        if (animationStarted) return;
        animationStarted = true;

        counters.forEach(counter => {
          const target = parseInt(counter.getAttribute('data-target'), 10);
          if (isNaN(target) || target < 0) return;

          counter.innerText = '0';

          const duration = 1800;
          const startTime = performance.now();

          function easeOutCubic(t) {
            return 1 - Math.pow(1 - t, 3);
          }

          function updateCounter(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easedProgress = easeOutCubic(progress);
            const currentValue = Math.round(easedProgress * target);

            counter.innerText = currentValue;

            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              counter.innerText = target;
            }
          }

          requestAnimationFrame(updateCounter);
        });
      }

      const section = document.querySelector('.counter-section');
      if (!section) return;

      if (section.getBoundingClientRect().top < window.innerHeight) {
        startCounters();
      } else {
        observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !animationStarted) {
              startCounters();
              observer.disconnect();
            }
          });
        }, {
          threshold: 0.2,
          rootMargin: '0px'
        });

        observer.observe(section);
      }

      setTimeout(() => {
        if (!animationStarted) {
          startCounters();
          if (observer) observer.disconnect();
        }
      }, 3000);

    })();


        document.addEventListener("DOMContentLoaded", function () {

            const reviewTrack = document.getElementById("clientReviewTrack");
            const reviewCards = document.querySelectorAll(".client-review-card");
            const reviewDots = document.querySelectorAll(".client-review-dot");

            let currentReviewSlide = 0;

            function getReviewsPerSlide() {
                if (window.innerWidth <= 575) return 1;
                if (window.innerWidth <= 991) return 2;
                return 3;
            }

            function showReviewSlide(slideNumber) {

                const reviewsPerSlide = getReviewsPerSlide();
                const totalSlides = Math.ceil(reviewCards.length / reviewsPerSlide);

                if (slideNumber >= totalSlides) {
                    currentReviewSlide = 0;
                }

                if (slideNumber < 0) {
                    currentReviewSlide = totalSlides - 1;
                }

                const moveValue = currentReviewSlide * 100;

                reviewTrack.style.transform = `translateX(-${moveValue}%)`;

                reviewCards.forEach(function (card) {
                    card.classList.remove("active");
                });

                const activeCardIndex = currentReviewSlide * reviewsPerSlide;

                if (reviewCards[activeCardIndex]) {
                    reviewCards[activeCardIndex].classList.add("active");
                }

                reviewDots.forEach(function (dot) {
                    dot.classList.remove("active-review-dot");
                });

                if (reviewDots[currentReviewSlide]) {
                    reviewDots[currentReviewSlide].classList.add("active-review-dot");
                }
            }

            reviewDots.forEach(function (dot, index) {
                dot.addEventListener("click", function () {
                    currentReviewSlide = index;
                    showReviewSlide(currentReviewSlide);
                });
            });

            setInterval(function () {
                currentReviewSlide++;
                showReviewSlide(currentReviewSlide);
            }, 3000);

            window.addEventListener("resize", function () {
                currentReviewSlide = 0;
                showReviewSlide(currentReviewSlide);
            });

            showReviewSlide(0);
        });


        /* =================================================
           FEATURED PROJECTS — FILTER (SMART WIDTH)
        ================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            const filterButtons = document.querySelectorAll(".work-filter");
            const projectColumns = document.querySelectorAll(".work-showcase [data-category]");

            projectColumns.forEach(function (col) {
                col.dataset.originalClass = col.className;
            });

            filterButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    filterButtons.forEach(function (btn) {
                        btn.classList.remove("active");
                    });
                    this.classList.add("active");

                    const filter = this.getAttribute("data-filter");
                    const isNarrow = (filter === "mobile" || filter === "erp");

                    projectColumns.forEach(function (col) {

                        const match =
                            filter === "all" ||
                            col.getAttribute("data-category") === filter;

                        if (!match) {
                            col.style.display = "none";
                            col.classList.remove("filter-show");
                            return;
                        }

                        col.style.display = "";
                        col.classList.add("filter-show");

                        if (isNarrow) {
                            col.className = "col-lg-6 col-md-6 filter-show";
                        } else {
                            col.className = col.dataset.originalClass + " filter-show";
                        }

                    });

                });

            });

        });


