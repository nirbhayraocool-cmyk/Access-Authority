@model List<Access_Authority.Models.CreateBlog>
@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <div class="container hero-container px-5">

        <div id="heroContent">

            <div class="row align-items-center">


                <!--  LEFT -->

                <div class="col-lg-6 hero-left">


                    <!-- TRUSTED -->

                    <div class="trusted-badge mb-4">

                        <span class="trusted-dot"></span>

                        TRUSTED BY

                        <span class="counter"
                              data-target="100"
                              id="businessCounter">

                            0

                        </span>+

                        BUSINESSES

                    </div>



                    <!-- HEADING -->

                    <h1 class="hero-heading"
                        id="heroTitle">

                        Build Your Digital

                        <span>Authority</span>

                    </h1>



                    <!-- DESCRIPTION -->

                    <p class="hero-description"
                       id="heroDescription">

                        Access Authority delivers custom
                        websites, enterprise software, and
                        intelligent products that scale with
                        your business — from MVP to enterprise.

                    </p>



                    <!-- BUTTONS -->

                    <div class="d-flex flex-wrap gap-2 hero-buttons">

                        <a asp-action="FreeConsultation"
                           class="btn consultation-btn">

                            <i class="bi bi-arrow-right me-2">
                            </i>

                            Free Consultation

                        </a>


                        <a asp-action="Product"
                           class="btn work-btn">

                            View Our Work

                        </a>

                    </div>



                    <!-- ================= STATS ================= -->

                    <div class="stats-box">


                        <div class="row g-0">


                            <!-- STAT 1 -->

                            <div class="col-4 stat-item">

                                <div class="stat-number">

                                    <span class="counter"
                                          id="projectCounter">

                                        0

                                    </span>+

                                </div>


                                <div class="stat-title">

                                    PROJECTS DELIVERED

                                </div>

                            </div>



                            <!-- STAT 2 -->

                            <div class="col-4 stat-item">

                                <div class="stat-number">

                                    <span class="counter"
                                          id="clientCounter">

                                        0

                                    </span>+

                                </div>


                                <div class="stat-title">

                                    ENTERPRISE CLIENTS

                                </div>

                            </div>



                            <!-- STAT 3 -->

                            <div class="col-4 stat-item last-stat">

                                <div class="stat-number">

                                    <span class="counter"
                                          id="satisfactionCounter">

                                        0

                                    </span>%

                                </div>


                                <div class="stat-title">

                                    SATISFACTION RATE

                                </div>

                            </div>


                        </div>

                    </div>


                </div>



                <!-- ================= RIGHT ================= -->

                <div class="col-lg-6 hero-right">


                    <div class="hero-image-box">


                        <!-- IMAGE -->

                        <img id="heroImage"
                             src="https://static.vecteezy.com/system/resources/thumbnails/023/056/329/small_2x/programmer-people-working-laptops-or-smartphones-with-ai-artificial-intelligence-software-engineer-coding-on-laptop-computers-with-technology-icons-and-binary-code-big-data-ai-bot-digital-machine-photo.jpg"
                             class="hero-image"
                             alt="Development Team">



                        <!-- PARTNER -->

                        <div class="partner-badge">

                            <i class="bi bi-shield-check">
                            </i>

                            Trusted Partner

                        </div>



                        <!-- PROJECT CARD -->

                        <div class="project-card">


                            <div class="project-icon">

                                <i class="bi bi-rocket-takeoff"
                                   id="projectIcon">
                                </i>

                            </div>


                            <div>

                                <div class="project-small">

                                    LATEST PROJECT

                                </div>


                                <div class="project-name"
                                     id="projectName">

                                    ERP Platform Live

                                </div>

                            </div>


                        </div>


                    </div>

                </div>


            </div>


        </div>



        <!-- =================================================
             SCROLL
        ================================================== -->

        <div class="scroll-container">

            <div class="scroll-title">

                SCROLL

            </div>


            <div class="scroll-mouse">

                <span></span>

            </div>

        </div>


    </div>

</section>



