                        image: "https://t4.ftcdn.net/jpg/05/54/46/89/240_F_554468927_iwU3VYIjsaeopAb0WPYxVf21TloEhTEj.jpg",
                        businesses: 200,
                        projects: 200,
                        clients: 80,
                        satisfaction: 99,
                        projectName: "Smart ERP Platform"
                    }

                ];

                let currentSlide = 0;

                const heroContent = document.getElementById("heroContent");
                const heroTitle = document.getElementById("heroTitle");
                const heroDescription = document.getElementById("heroDescription");
                const heroImage = document.getElementById("heroImage");
                const businessCounter = document.getElementById("businessCounter");
                const projectCounter = document.getElementById("projectCounter");
                const clientCounter = document.getElementById("clientCounter");
                const satisfactionCounter = document.getElementById("satisfactionCounter");
                const projectName = document.getElementById("projectName");

                function runCounter(element, target) {

                    let current = 0;
                    const duration = 1500;
                    const stepTime = 20;
                    const increment = target / (duration / stepTime);

                    element.textContent = "0";

                    const timer = setInterval(() => {

                        current += increment;

                        if (current >= target) {
                            current = target;
                            clearInterval(timer);
                        }

                        element.textContent = Math.floor(current);

                    }, stepTime);
                }

                function startAllCounters(slide) {

                    runCounter(businessCounter, slide.businesses);
                    runCounter(projectCounter, slide.projects);
                    runCounter(clientCounter, slide.clients);
                    runCounter(satisfactionCounter, slide.satisfaction);
                }

                function changeHeroContent() {

                    heroContent.classList.remove("fade-in");
                    heroContent.classList.add("fade-out");

                    setTimeout(() => {

                        currentSlide++;

                        if (currentSlide >= heroSlides.length) {
                            currentSlide = 0;
                        }

                        const slide = heroSlides[currentSlide];

                        heroTitle.innerHTML = slide.title;
                        heroDescription.innerHTML = slide.description;
                        heroImage.src = slide.image;
                        projectName.textContent = slide.projectName;

                        businessCounter.textContent = "0";
                        projectCounter.textContent = "0";
                        clientCounter.textContent = "0";
                        satisfactionCounter.textContent = "0";

                        heroContent.classList.remove("fade-out");
                        heroContent.classList.add("fade-in");

                        startAllCounters(slide);

                    }, 700);
                }

                startAllCounters(heroSlides[0]);

                setInterval(changeHeroContent, 5000);
