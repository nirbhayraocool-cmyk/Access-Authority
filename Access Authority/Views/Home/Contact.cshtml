                                    <option value="Erp Development">ERP Development</option>
                                    <option value="Software Devlopment">Custom Software</option>
                                    <option value="Mobile App Devlopment">Mobile App Development</option>
                                    <option value="uiux Design">UI/UX Design</option>
                                    <option value="Video Production">Video Production</option>

                                </select>

                            </div>

                            <!-- Project Details -->
                            <div class="col-12">

                                <label class="form-label-custom">
                                    PROJECT DETAILS <span class="required">*</span>
                                </label>

                                <textarea asp-for="ProjectDetails"
                                          class="form-control-custom textarea"
                                          placeholder="Tell us about your project, goals, timeline, and budget..."
                                          required></textarea>

                            </div>

                            <!-- Privacy Policy Checkbox -->
                            <div class="col-12">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           asp-for="PrivacyAccepted"
                                           type="checkbox"
                                           id="privacyCheck">

                                    <label class="form-check-label" for="privacyCheck">
                                        I agree to the
                                        <a href="#">Privacy Policy</a>
                                        and consent to being contacted.
                                    </label>

                                </div>

                            </div>

                            <!-- Submit Button -->
                            <div class="col-12">

                                <button type="submit" class="btn-submit">
                                    <i class="bi bi-send-fill"></i>
                                    Send Message
                                </button>

