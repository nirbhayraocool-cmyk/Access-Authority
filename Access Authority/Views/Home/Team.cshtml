<section class="working-section">

    ```
    <div class="container px-5">

        <div class="text-center">

            <div class="section-label justify-content-center">
                <span></span>
                HOW WE WORK
            </div>

            <h2>
                From Idea to <span>Digital Solution</span>
            </h2>

            <p class="section-sub">
                Our teams work together through a clear and practical process
                to turn business ideas into reliable technology.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="working-card">

                    <div class="working-number">
