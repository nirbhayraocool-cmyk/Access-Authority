@{
    ViewData["Title"] = "Our Team";
}
<style>
    /* ===== TEAM PAGE HERO ===== */ 

    .page-hero-custom {
        background: #f7f7f7;
        padding: 55px 0 40px;
        border-bottom: 1px solid #e8e8e8;
    }
    /* Breadcrumb */

    .breadcrumb-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 14px;
    }

        .breadcrumb-custom a {
            color: #d62828;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s ease;
        }

            .breadcrumb-custom a:hover {
                color: #a91f1f;
            }

        .breadcrumb-custom span {
            color: #777;
            font-weight: 500;
        }
    /* Heading */

    .page-hero-custom h1 {
        font-size: 46px;
        line-height: 1.2;
        font-weight: 800;
        color: #171717;
        margin-bottom: 12px;
    }
    /* Description */

    .page-hero-custom p {
        max-width: 700px;
        font-size: 16px;
        line-height: 1.7;
        color: #666;
        margin-bottom: 0;
    }
    /* Responsive */

    @@media (max-width: 767px) {
        .page-hero-custom {
            padding: 45px 0 35px;
        }

            .page-hero-custom h1 {
                font-size: 36px;
            }

            .page-hero-custom p {
                font-size: 15px;
            }
    }
</style>

<style>

    /* ===== TEAM SECTION =========== */
    .team-section {
        background: #ffffff;
        padding: 60px 0;
    }

        .team-section .section-label,
        .expertise-section .section-label,
        .working-section .section-label,
        .technology-section .section-label,
        .values-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .team-section .section-label span,
            .expertise-section .section-label span,
            .working-section .section-label span,
            .technology-section .section-label span,
            .values-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .team-section h2,
        .expertise-section h2,
        .working-section h2,
        .technology-section h2,
        .values-section h2 {
            font-size: 30px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
        }

            .team-section h2 span,
            .expertise-section h2 span,
            .working-section h2 span,
            .technology-section h2 span,
            .values-section h2 span {
                color: #ed0026;
            }

        .team-section .team-sub,
        .expertise-section .section-sub,
        .working-section .section-sub,
        .technology-section .section-sub,
        .values-section .section-sub {
            font-size: 13px;
            color: #555;
            margin-bottom: 30px;
        }


    /* =====================================================
                           TEAM CARDS
        ===================================================== */

    .team-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        padding: 28px 22px 26px;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
        border-radius: 6px;
    }

        .team-card:hover {
            border-color: #ed0026;
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
        }

        .team-card .team-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: #ed0026;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            margin: 0 auto 14px;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .team-card:hover .team-avatar {
            transform: scale(1.05);
        }

        .team-card .team-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .team-card .team-avatar.two {
            background: #2563eb;
        }

        .team-card .team-avatar.three {
            background: #0ea5e9;
        }

        .team-card .team-avatar.four {
            background: #8b5cf6;
        }

        .team-card h4 {
            font-size: 16px;
            font-weight: 700;
            color: #111;
            margin: 0 0 2px 0;
        }

        .team-card .team-role {
            font-size: 11px;
            color: #ed0026;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .team-card p {
            font-size: 11px;
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        .team-card .team-skills {
            display: flex;
            justify-content: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

            .team-card .team-skills span {
                font-size: 8px;
                font-weight: 600;
                color: #555;
                background: #f0f0f0;
                padding: 2px 12px;
                letter-spacing: 0.3px;
                border-radius: 3px;
                transition: all 0.3s ease;
            }

        .team-card:hover .team-skills span {
            background: #fdecee;
            color: #ed0026;
        }


    /* =====================================================
                        TEAM EXPERTISE SECTION
        ===================================================== */

    .expertise-section {
        background: #f7f7f7;
        padding: 60px 0;
    }

    .expertise-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        padding: 28px 24px;
        height: 100%;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .expertise-card:hover {
            border-color: #ed0026;
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

    .expertise-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fdecee;
        color: #ed0026;
        border-radius: 5px;
        font-size: 21px;
        margin-bottom: 16px;
    }

    .expertise-card h4 {
        font-size: 16px;
        font-weight: 700;
        color: #111;
        margin-bottom: 8px;
    }

    .expertise-card p {
        font-size: 12px;
        color: #555;
        line-height: 1.7;
        margin: 0;
    }


    /* =====================================================
                        HOW OUR TEAM WORKS
        ===================================================== */

    .working-section {
        background: #ffffff;
        padding: 60px 0;
    }

    .working-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 25px 22px;
        height: 100%;
        border-radius: 6px;
        transition: all 0.3s ease;
        position: relative;
    }

        .working-card:hover {
            border-color: #ed0026;
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

    .working-number {
        font-size: 32px;
        font-weight: 800;
        color: #ed0026;
        line-height: 1;
        margin-bottom: 12px;
    }

    .working-card h4 {
        font-size: 16px;
        font-weight: 700;
        color: #111;
        margin-bottom: 7px;
    }

    .working-card p {
        font-size: 12px;
        color: #555;
        line-height: 1.7;
        margin: 0;
    }


    /* =====================================================
                        TECHNOLOGY & DELIVERY
        ===================================================== */

    .technology-section {
        background: #f7f7f7;
        padding: 60px 0;
    }

    .technology-box {
        background: #0b0b0b;
        border: 1px solid #202020;
        padding: 35px 30px;
        border-radius: 6px;
        height: 100%;
    }

        .technology-box h4 {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
        }

            .technology-box h4 span {
                color: #ed0026;
            }

        .technology-box p {
            font-size: 12px;
            color: #888;
            line-height: 1.7;
            margin-bottom: 20px;
        }

    .technology-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .technology-list span {
            font-size: 9px;
            font-weight: 600;
            color: #ddd;
            border: 1px solid #333;
            padding: 5px 12px;
            border-radius: 3px;
        }

    .delivery-box {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        padding: 35px 30px;
        border-radius: 6px;
        height: 100%;
    }

    .delivery-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 17px;
    }

        .delivery-item:last-child {
            margin-bottom: 0;
        }

        .delivery-item i {
            color: #ed0026;
            font-size: 18px;
            margin-top: 2px;
        }

        .delivery-item h5 {
            font-size: 13px;
            font-weight: 700;
            color: #111;
            margin: 0 0 3px;
        }

        .delivery-item p {
            font-size: 11px;
            color: #666;
            margin: 0;
            line-height: 1.5;
        }


    /* =====================================================
                        TEAM VALUES
        ===================================================== */

    .values-section {
        background: #ffffff;
        padding: 60px 0;
    }

    .value-card {
        text-align: center;
        padding: 25px 20px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        height: 100%;
        transition: all 0.3s ease;
    }

        .value-card:hover {
            border-color: #ed0026;
            transform: translateY(-4px);
        }

    .value-icon {
        font-size: 32px;
        color: #ed0026;
        margin-bottom: 12px;
    }

    .value-card h4 {
        font-size: 15px;
        font-weight: 700;
        color: #111;
        margin-bottom: 7px;
    }

    .value-card p {
        font-size: 11px;
        color: #555;
        line-height: 1.6;
        margin: 0;
    }


    /* =====================================================
                           TESTIMONIALS
        ===================================================== */

    .testimonials-section {
        background: #f7f7f7;
        padding: 60px 0;
    }

        .testimonials-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .testimonials-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .testimonials-section h2 {
            font-size: 30px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
        }

            .testimonials-section h2 span {
                color: #ed0026;
            }

    .testimonial-card {
        background: #ffffff;
        padding: 32px 36px;
        border-left: 4px solid #ed0026;
        border-radius: 4px;
        transition: all 0.3s ease;
        height: 100%;
    }

        .testimonial-card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
            transform: translateY(-2px);
        }

        .testimonial-card .quote-icon {
            font-size: 36px;
            color: #ed0026;
            opacity: 0.12;
            line-height: 1;
            margin-bottom: 4px;
        }

        .testimonial-card blockquote {
            font-size: 15px;
            font-weight: 400;
            color: #111;
            line-height: 1.7;
            margin: 0 0 16px 0;
        }

        .testimonial-card .client-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .testimonial-card .client-review-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            overflow: hidden;
            background: #ed0026;
            flex-shrink: 0;
        }

            .testimonial-card .client-review-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .testimonial-card .client-name {
            font-size: 14px;
            font-weight: 700;
            color: #111;
            margin: 0;
        }

        .testimonial-card .client-title {
            font-size: 12px;
            color: #777;
            margin: 0;
        }


    /* =====================================================
                           CTA SECTION
        ===================================================== */

    .cta-section {
        background: #0b0b0b;
        padding: 50px 0;
        color: #fff;
        border-top: 1px solid #202020;
        border-bottom: 1px solid #202020;
    }

        .cta-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .cta-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .cta-section h2 {
            font-size: 30px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

            .cta-section h2 span {
                color: #ed0026;
            }

        .cta-section p {
            font-size: 13px;
            color: #888;
            max-width: 520px;
            margin: 0 auto 24px auto;
            line-height: 1.6;
        }

        .cta-section .btn-cta-primary {
            background: #ed0026;
            color: #fff;
            padding: 10px 28px;
            font-size: 11px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.3s ease;
            display: inline-block;
        }

            .cta-section .btn-cta-primary:hover {
                background: #c9001f;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(237, 0, 38, 0.25);
            }

            .cta-section .btn-cta-primary i {
                margin-right: 6px;
            }

        .cta-section .btn-cta-outline {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 10px 28px;
            font-size: 11px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.3s ease;
            display: inline-block;
        }

            .cta-section .btn-cta-outline:hover {
                border-color: #ed0026;
                color: #ed0026;
                transform: translateY(-2px);
            }

            .cta-section .btn-cta-outline i {
                margin-right: 6px;
            }

        .cta-section .cta-buttons {
            display: flex;
            gap: 14px;
            justify-content: center;
            flex-wrap: wrap;
        }


    /* =====================================================
                           TRUSTED BOTTOM
        ===================================================== */

    .trusted-bottom {
        background: #0b0b0b;
        padding: 16px 0;
        border-bottom: 1px solid #202020;
    }

    .trusted-by-text {
        color: #555;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .trusted-item {
        color: #777;
        font-size: 8px;
        font-weight: 600;
    }

        .trusted-item i {
            color: #ed0026;
            font-size: 9px;
            margin-right: 4px;
        }


    /* =====================================================
                           RESPONSIVE
        ===================================================== */

    @@media (max-width: 991px) {

        .team-section h2,
        .expertise-section h2,
        .working-section h2,
        .technology-section h2,
        .values-section h2,
        .testimonials-section h2 {
            font-size: 26px;
        }
    }

    @@media (max-width: 575px) {

        .team-section,
        .expertise-section,
        .working-section,
        .technology-section,
        .values-section,
        .testimonials-section {
            padding: 40px 0;
        }

            .team-section h2,
            .expertise-section h2,
            .working-section h2,
            .technology-section h2,
            .values-section h2,
            .testimonials-section h2 {
                font-size: 22px;
            }

        .team-card .team-avatar {
            width: 64px;
            height: 64px;
            font-size: 22px;
        }

        .testimonial-card {
            padding: 20px 16px;
        }

            .testimonial-card blockquote {
                font-size: 14px;
            }

        .cta-section {
            padding: 40px 0;
        }

            .cta-section h2 {
                font-size: 22px;
            }

            .cta-section .cta-buttons {
                flex-direction: column;
                align-items: center;
            }
    }

</style>
<section class="page-hero-custom bg-black"> 
    <div class="container px-5"> 
        <div class="row">
        <div class="col-lg-12"> 
            <div class="breadcrumb-custom"> 
                <a asp-controller="Home" 
