                </div>

            </div>


            <!-- Android -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="technology-box">

                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/android/android-original.svg"
                         alt="Android">

                </div>

            </div>


            <!-- Apple -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="technology-box">

