@* @{
    ViewData["Title"] = "About Us";
}
<style>
    /* new style  */
    .aa-section-label {
        display: flex;
        align-items: center;
        font-size: 10px;
        font-weight: 700;
        color: #ed0026;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

        .aa-section-label span {
            width: 20px;
            height: 2px;
            background: #ed0026;
            margin-right: 8px;
            display: inline-block;
        }

    .aa-main-heading {
        font-size: 30px;
        font-weight: 700;
        color: #111;
        margin: 0 0 7px;
    }

        .aa-main-heading span, .aa-who-section h2 span, .aa-tech-section h2 span {
            color: #ed0026;
        }

    .aa-section-sub {
        font-size: 13px;
        color: #666;
        line-height: 1.7;
        max-width: 600px;
        margin: 0 auto;
    }
    /* =============================== WHO WE ARE =============================== */

    .aa-who-section {
        background: #fff;
        padding: 70px 0;
    }

        .aa-who-section h2 {
            font-size: 31px;
            line-height: 1.25;
            font-weight: 700;
            color: #111;
            margin-bottom: 18px;
        }

    .aa-who-text {
        font-size: 13px;
        color: #555;
        line-height: 1.8;
        margin-bottom: 12px;
    }

    .aa-who-points {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

        .aa-who-points div {
            font-size: 10px;
            font-weight: 600;
            color: #333;
        }

        .aa-who-points i {
            color: #ed0026;
            margin-right: 5px;
        }

    .aa-who-visual {
        position: relative;
        overflow: hidden;
        border-radius: 6px;
    }

        .aa-who-visual img {
            width: 100%;
            height: 390px;
            object-fit: cover;
            display: block;
        }

    .aa-visual-card {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(11,11,11,.94);
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-left: 3px solid #ed0026;
    }

    .aa-visual-icon {
        width: 38px;
        height: 38px;
        background: #ed0026;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    .aa-visual-card strong {
        color: #fff;
        font-size: 12px;
        display: block;
    }

    .aa-visual-card small {
        color: #888;
        font-size: 9px;
    }
    /* =============================== SERVICES =============================== */

    .aa-services-section {
        background: #f7f7f7;
        padding: 65px 0;
    }

    .aa-service-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 27px 22px 24px;
        min-height: 220px;
        position: relative;
        transition: .3s ease;
        border-radius: 5px;
        overflow: hidden;
    }

        .aa-service-card:hover {
            border-color: #ed0026;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,.06);
        }

    .aa-service-icon {
        width: 43px;
        height: 43px;
        background: #fdecee;
        color: #ed0026;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        border-radius: 4px;
        margin-bottom: 18px;
    }

    .aa-service-card h4 {
        font-size: 15px;
        font-weight: 700;
        color: #111;
        margin-bottom: 8px;
    }

    .aa-service-card p {
        font-size: 11px;
        color: #666;
        line-height: 1.7;
        margin: 0;
    }

    .aa-service-card > span {
        position: absolute;
        right: 15px;
        bottom: 12px;
        font-size: 25px;
        font-weight: 800;
        color: #f1f1f1;
    }
    /* =============================== APPROACH =============================== */

    .aa-approach-section {
        background: #fff;
        padding: 65px 0;
    }

    .aa-process-card {
        min-height: 240px;
        padding: 28px 22px;
        border: 1px solid #e5e7eb;
        position: relative;
        transition: .3s ease;
    }

        .aa-process-card:hover {
            border-color: #ed0026;
            background: #fafafa;
        }

    .aa-process-number {
        position: absolute;
        top: 15px;
        right: 17px;
        font-size: 28px;
        font-weight: 800;
        color: #f0f0f0;
    }

    .aa-process-icon {
        color: #ed0026;
        font-size: 27px;
        margin-bottom: 15px;
    }

    .aa-process-card h4 {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #111;
    }

    .aa-process-card p {
        font-size: 11px;
        color: #666;
        line-height: 1.7;
        margin: 0;
    }
    /* =============================== TECHNOLOGY =============================== */

    .aa-tech-section {
        background: #0b0b0b;
        color: #fff;
        padding: 65px 0;
    }

        .aa-tech-section h2 {
            font-size: 30px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 15px;
        }

        .aa-tech-section p {
            font-size: 12px;
            color: #888;
            line-height: 1.8;
            max-width: 500px;
        }

    .aa-tech-button {
        display: inline-block;
        margin-top: 10px;
        background: #ed0026;
        color: #fff;
        padding: 9px 19px;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 4px;
        transition: .3s ease;
    }

        .aa-tech-button:hover {
            background: #c9001f;
            color: #fff;
            transform: translateY(-2px);
        }

        .aa-tech-button i {
            margin-left: 7px;
        }

    .aa-tech-card {
        background: #151515;
        border: 1px solid #252525;
        padding: 19px;
        min-height: 92px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: .3s ease;
    }

        .aa-tech-card:hover {
            border-color: #ed0026;
            transform: translateY(-3px);
        }

        .aa-tech-card > i {
            font-size: 24px;
            color: #ed0026;
        }

        .aa-tech-card strong {
            display: block;
            color: #fff;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .aa-tech-card small {
            display: block;
            color: #777;
            font-size: 8px;
        }
    /* =============================== WHY ACCESS AUTHORITY =============================== */

    .aa-why-section {
        background: #f7f7f7;
        padding: 65px 0;
    }

    .aa-why-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 25px 22px;
        height: 100%;
        transition: .3s ease;
        border-radius: 5px;
    }

        .aa-why-card:hover {
            border-color: #ed0026;
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0,0,0,.05);
        }

    .aa-why-icon {
        color: #ed0026;
        font-size: 25px;
        margin-bottom: 14px;
    }

    .aa-why-card h4 {
        font-size: 15px;
        font-weight: 700;
        color: #111;
        margin-bottom: 7px;
    }

    .aa-why-card p {
        font-size: 11px;
        color: #666;
        line-height: 1.7;
        margin: 0;
    }
    /* =============================== JOURNEY =============================== */

    .timeline-vertical {
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .timeline-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .timeline-item {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        overflow: hidden;
        transition: .3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .timeline-item:hover {
            border-color: #ed0026;
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,.07);
        }

        .timeline-item .timeline-content {
            padding: 20px 22px 18px;
            flex: 1;
        }

        .timeline-item .timeline-year {
            font-size: 21px;
            font-weight: 800;
            color: #ed0026;
            display: block;
            margin-bottom: 7px;
        }

        .timeline-item .timeline-title {
            font-size: 16px;
            font-weight: 700;
            color: #111;
            margin-bottom: 7px;
        }

        .timeline-item .timeline-desc {
            font-size: 12px;
            color: #555;
            line-height: 1.7;
            margin: 0;
        }

        .timeline-item .timeline-tag {
            display: inline-block;
            font-size: 8px;
            font-weight: 700;
            color: #ed0026;
            background: #fdecee;
            padding: 4px 12px;
            margin-top: 10px;
            border-radius: 3px;
        }

        .timeline-item .timeline-image {
            width: 100%;
            height: 175px;
            object-fit: cover;
            display: block;
            transition: transform .4s ease;
        }

        .timeline-item:hover .timeline-image {
            transform: scale(1.025);
        }

    .journey-highlight {
        margin-top: 25px;
        text-align: center;
        font-size: 11px;
        color: #777;
    }

        .journey-highlight i {
            color: #ed0026;
            margin-right: 5px;
        }

        .journey-highlight strong {
            color: #333;
        }
    /* =============================== RESPONSIVE =============================== */

    @@media (max-width: 991px) {
        .aa-who-section, .aa-services-section, .aa-approach-section, .aa-tech-section, .aa-why-section {
            padding: 50px 0;
        }

            .aa-who-section h2, .aa-tech-section h2 {
                font-size: 27px;
            }

        .aa-main-heading {
            font-size: 27px;
        }
    }

    @@media (max-width: 767px) {
        .aa-who-points {
            grid-template-columns: 1fr;
        }

        .aa-who-visual img {
            height: 300px;
        }

        .timeline-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .aa-process-card {
            min-height: auto;
        }
    }

    @@media (max-width: 575px) {
        .aa-who-section, .aa-services-section, .aa-approach-section, .aa-tech-section, .aa-why-section {
            padding: 40px 0;
        }

            .aa-main-heading, .aa-who-section h2, .aa-tech-section h2 {
                font-size: 22px;
            }

        .aa-section-sub {
            font-size: 12px;
        }

        .aa-who-visual img {
            height: 240px;
        }

        .aa-visual-card {
            bottom: 12px;
            left: 12px;
            right: 12px;
        }

        .aa-tech-card {
            padding: 14px;
            min-height: 80px;
        }

            .aa-tech-card > i {
                font-size: 20px;
            }

            .aa-tech-card strong {
                font-size: 9px;
            }

            .aa-tech-card small {
                font-size: 7px;
            }

        .timeline-item .timeline-image {
            height: 155px;
        }
    }
    /* new style end */
  .page-hero-custom {
        background: #f7f7f7;
        padding: 55px 0 40px;
        border-bottom: 1px solid #eaeaea;
    }

        .page-hero-custom .breadcrumb-custom {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.8px;
            color: #fff;
            margin-bottom: 14px;
        }

            .page-hero-custom .breadcrumb-custom a {
                color: #fff;
                text-decoration: none;
                transition: color 0.2s;
            }

                .page-hero-custom .breadcrumb-custom a:hover {
                    color: #ed0026;
                }

            .page-hero-custom .breadcrumb-custom .separator {
                color: #fff;
                margin: 0 8px;
            }

            .page-hero-custom .breadcrumb-custom .active {
                color: #ed0026;
            }

        .page-hero-custom .est-badge {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .page-hero-custom h1 {
            font-size: 38px;
            font-weight: 800;
            color: #fff;
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

            .page-hero-custom h1 span {
                color: #ed0026;
            }

        .page-hero-custom .subtitle {
            font-size: 14px;
            color: #555;
            margin: 0;
            max-width: 520px;
            line-height: 1.6;
        }

        .page-hero-custom .hero-buttons {
            margin-top: 18px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .page-hero-custom .btn-primary-custom {
            background: #ed0026;
            color: #fff;
            padding: 9px 24px;
            font-size: 10px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

            .page-hero-custom .btn-primary-custom:hover {
                background: #c9001f;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(237, 0, 38, 0.25);
            }

            .page-hero-custom .btn-primary-custom i {
                margin-right: 6px;
            }

        .page-hero-custom .btn-outline-custom {
            background: transparent;
            color: #f2f2f2;
            border: 1px solid #ccc;
            padding: 9px 24px;
            font-size: 10px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

            .page-hero-custom .btn-outline-custom:hover {
                border-color: #ed0026;
                color: #ed0026;
                transform: translateY(-2px);
            }

            .page-hero-custom .btn-outline-custom i {
                margin-right: 6px;
            }

    /* =====================================================
               MINI STATS
            ===================================================== */

    .mini-stats-custom {
        
        color: #fff;
        padding: 22px 0;
        border-bottom: 1px solid #202020;
    }

        .mini-stats-custom .stat-block {
            border-right: 1px solid #292929;
            padding: 5px 15px;
            text-align: center;
        }

            .mini-stats-custom .stat-block:last-child {
                border-right: none;
            }

        .mini-stats-custom .stat-number {
            color: #ed0026;
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

            .mini-stats-custom .stat-number .suffix {
                color: #ed0026;
            }

        .mini-stats-custom .stat-label {
            color: #686868;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.8px;
            margin-top: 5px;
        }

    /* =====================================================
               MISSION SECTION
            ===================================================== */

    .mission-section {
        background: #ffffff;
        padding: 10px 0;
    }

        .mission-section .mission-icon {
            font-size: 42px;
            color: #ed0026;
            opacity: 0.15;
            margin-bottom: 10px;
            line-height: 1;
        }

        .mission-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .mission-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .mission-section h2 {
            font-size: 30px;
            font-weight: 700;
            color: #111;
            margin: 0 0 12px 0;
        }

            .mission-section h2 span {
                color: #ed0026;
            }

        .mission-section .mission-desc {
            font-size: 14px;
            color: #555;
            line-height: 1.8;
            max-width: 600px;
            margin: 0 auto;
        }

            .mission-section .mission-desc strong {
                color: #111;
                font-weight: 600;
            }

        .mission-section .mission-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 28px;
            flex-wrap: wrap;
        }

            .mission-section .mission-stats div {
                text-align: center;
            }

            .mission-section .mission-stats strong {
                display: block;
                font-size: 28px;
                font-weight: 700;
                color: #ed0026;
            }

            .mission-section .mission-stats span {
                font-size: 10px;
                color: #777;
                font-weight: 600;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

    /* =====================================================
               JOURNEY SECTION - VERTICAL TIMELINE
               TEXT UPAR, IMAGE NICHE (PURE ROW COVER)
            ===================================================== */

    .journey-section {
        background: #f7f7f7;
        padding: 60px 0 70px 0;
    }

        .journey-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .journey-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .journey-section h2 {
            font-size: 30px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
        }

            .journey-section h2 span {
                color: #ed0026;
            }

        .journey-section .journey-sub {
            font-size: 13px;
            color: #555;
            margin-bottom: 35px;
        }

    /* Vertical Timeline - One item per row, text upar, image niche */
    .timeline-vertical {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .timeline-item {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-item:hover {
            border-color: #ed0026;
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        /* Content - Upar */
        .timeline-item .timeline-content {
            padding: 18px 24px 14px;
            
        }

        .timeline-item .timeline-year {
            font-size: 22px;
            font-weight: 800;
            color: #ed0026;
            display: block;
            line-height: 1;
            margin-bottom: 2px;
        }

        .timeline-item .timeline-title {
            font-size: 16px;
            font-weight: 700;
            color: #111;
            margin: 0 0 4px 0;
        }

        .timeline-item .timeline-desc {
            font-size: 13px;
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        .timeline-item .timeline-tag {
            display: inline-block;
            font-size: 9px;
            font-weight: 700;
            color: #ed0026;
            background: #fdecee;
            padding: 3px 14px;
            margin-top: 6px;
            letter-spacing: 0.3px;
            border-radius: 3px;
        }

        /* Image - Niche (Full width row cover) */
        .timeline-item .timeline-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
        }

        .timeline-item:hover .timeline-image {
            transform: scale(1.02);
        }

    /* =====================================================
               TEAM SECTION
            ===================================================== */

    .team-section {
        background: #ffffff;
        padding: 60px 0;
    }

        .team-section .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #ed0026;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

            .team-section .section-label span {
                display: inline-block;
                width: 20px;
                height: 2px;
                background: #ed0026;
                vertical-align: middle;
                margin-right: 8px;
            }

        .team-section h2 {
            font-size: 30px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
        }

            .team-section h2 span {
                color: #ed0026;
            }

        .team-section .team-sub {
            font-size: 13px;
            color: #555;
            margin-bottom: 30px;
        }

    .team-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        padding: 28px 22px 26px;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
        border-radius: 6px;
    }

        .team-card:hover {
            border-color: #ed0026;
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
        }

        .team-card .team-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: #ed0026;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            margin: 0 auto 14px;
            transition: all 0.3s ease;
        }

        .team-card:hover .team-avatar {
            transform: scale(1.05);
        }

        .team-card .team-avatar.two {
            background: #2563eb;
        }

        .team-card .team-avatar.three {
            background: #0ea5e9;
        }

        .team-card .team-avatar.four {
            background: #8b5cf6;
        }

        .team-card h4 {
            font-size: 16px;
            font-weight: 700;
            color: #111;
            margin: 0 0 2px 0;
        }

        .team-card .team-role {
            font-size: 11px;
            color: #ed0026;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .team-card p {
            font-size: 11px;
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        .team-card .team-skills {
            display: flex;
            justify-content: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

            .team-card .team-skills span {
                font-size: 8px;
                font-weight: 600;
                color: #555;
                background: #f0f0f0;
                padding: 2px 12px;
                letter-spacing: 0.3px;
                border-radius: 3px;
                transition: all 0.3s ease;
            }

        .team-card:hover .team-skills span {
            background: #fdecee;
            color: #ed0026;
        }

    /* =====================================================
               TESTIMONIALS
      ===================================================== */

    .testimonials-section {
        background: #f7f7f7;
        padding: 60px 0;
    }

        .testimonials-section .section-label {
            font-size: 10px;
            font-weight: 700;
