                        </li>

                    </ul>


                    <ul class="feature-list">

                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Responsive interface design
                        </li>

                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Usability testing
                        </li>

                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            Design systems & UI libraries
                        </li>

                    </ul>

                </div>


                <!-- STATS -->

                <div class="row stats">

                    <div class="col-4">

                        <div class="stat-number">
                            40+
                        </div>

                        <div class="stat-text">
                            Interfaces Designed
                        </div>

                    </div>


                    <div class="col-4">

                        <div class="stat-number">
                            95%
                        </div>

                        <div class="stat-text">
                            User Satisfaction
                        </div>

                    </div>


                    <div class="col-4">

                        <div class="stat-number">
                            2x
                        </div>

                        <div class="stat-text">
                            Faster User Journeys
                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT IMAGE -->

            <div class="col-lg-6">

                <img src="https://images.unsplash.com/photo-1559028012-481c04fa702d?w=900&q=80&auto=format&fit=crop"
                     class="work-image"
                     alt="UI UX Design Workspace">

                @* <a href="#" class="work-link">

                    Explore Our Designs
                    <i class="bi bi-arrow-right"></i>

                </a> *@

            </div>

        </div>

    </div>

</section>


<div class="red-divider">
    ✦ ✦ ✦
</div>


<!-- =====================================================
     DESIGN INTELLIGENCE
===================================================== -->

<section class="section design-section" id="design-process">

    <div class="container px-5">

        <div class="text-center">

            <div class="section-title-small">
                Design Intelligence
            </div>

            <h2 class="section-title mt-3">
                From Insight to Experience
            </h2>

            <p class="section-text mt-3">
                A thoughtful approach that turns user problems
                into simple and meaningful digital experiences.
            </p>

        </div>


        <div class="row g-4 mt-4">


            <!-- RESEARCH -->

            <div class="col-md-6 col-lg-3">

                <div class="design-card">

                    <div class="design-number">
                        01
                    </div>

                    <div class="design-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h4>
                        Research
                    </h4>

                    <p>
                        We study users, business goals, behaviours,
                        pain points, and existing experiences to
                        uncover meaningful design opportunities.
                    </p>

                </div>

            </div>


            <!-- JOURNEY -->

            <div class="col-md-6 col-lg-3">

                <div class="design-card">

