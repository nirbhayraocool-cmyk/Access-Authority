<style>

    .breadcrumb-section {
        background: #0d0d0d;
        height: 50px;
        display: flex;
        align-items: center;
    }

    .breadcrumb {
        margin: 0;
    }

    .breadcrumb-item {
        font-size: 14px;
    }

        .breadcrumb-item a {
            color: #fff;
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color:red;
            font-weight: 600;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: #fff;
        }

    /* ================= HERO ================= */

    .hero {
        min-height: 435px;
        background: radial-gradient( circle at 75% 45%, rgba(55, 0, 5, 0.30), transparent 38% ), linear-gradient( 110deg, #0b090a 0%, #11090b 55%, #12090b 100% );
        color: white;
        padding: 55px 0 60px;
    }

    .back-link {
        color: #ed001c;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .back-link:hover {
            color: #ff3348;
        }

    .hero-icon {
        margin-top: 22px;
        width: 70px;
        height: 70px;
        background: #20090d;
        display: flex;
        align-items: center;
        justify-content: center;
        clip-path: polygon( 0 0, 82% 0, 100% 20%, 100% 100%, 20% 100%, 0 80% );
    }

        .hero-icon i {
            color: #ed001c;
            font-size: 31px;
        }

    .hero h1 {
        font-size: 54px;
        font-weight: 700;
        margin-top: 18px;
        line-height: 1.1;
    }

        .hero h1 span {
            color: #ed001c;
        }

    .hero-description {
        color: #9b9b9b;
        font-size: 18px;
        line-height: 1.65;
        max-width: 600px;
        margin-top: 14px;
    }

    .hero-buttons {
        margin-top: 25px;
    }

    .quote-btn {
        background: #ed001c;
        color: white;
        border: none;
        padding: 14px 26px;
        font-weight: 600;
        margin-right: 8px;
        clip-path: polygon( 0 0, 94% 0, 100% 20%, 100% 100%, 6% 100%, 0 80% );
    }

        .quote-btn:hover {
            background: #c90018;
            color: white;
        }

    .process-btn {
        background: transparent;
        color: white;
        border: 1px solid #4b4b4b;
        padding: 13px 25px;
    }

        .process-btn:hover {
            border-color: #ed001c;
            color: #ed001c;
        }

    /* ================= COMMON ================= */

    .section {
        padding: 90px 0;
    }

    .section-title-small {
        color: #ed001c;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .section-title {
        font-size: 38px;
        font-weight: 700;
        line-height: 1.15;
    }

    .section-text {
        color: #666;
        font-size: 16px;
        line-height: 1.8;
    }

    /* ================= WHAT WE DO ================= */

    .what-we-do {
        background: #fff;
    }

        .what-we-do .section-title-small {
            color: #ed001c;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 0;
        }

        .what-we-do .section-title {
            font-size: 36px;
            font-weight: 700;
            line-height: 1.2;
            color: #111;
            margin-top: 12px !important;
            margin-bottom: 0;
            max-width: 520px;
        }

        .what-we-do .section-text {
            color: #666;
            font-size: 15px;
            font-weight: 400;
            line-height: 1.75;
            max-width: 560px;
            margin-top: 18px !important;
            margin-bottom: 0;
        }


        /* ================= FEATURE LIST ================= */

        .what-we-do .feature-list {
            list-style: none;
            padding: 0;
            margin: 22px 0 0 0;
            width: 100%;
        }

            .what-we-do .feature-list li {
                margin-bottom: 13px;
                color: #333;
                font-size: 13px;
                font-weight: 500;
                line-height: 1.5;
                white-space: nowrap;
            }

            .what-we-do .feature-list i {
                color: #ed001c;
                font-size: 12px;
                margin-right: 8px;
            }


        /* ================= STATS ================= */

        .what-we-do .stats {
            margin-top: 28px;
        }

        .what-we-do .stat-number {
            font-size: 18px;
            font-weight: 700;
            color: #111;
            line-height: 1.2;
        }

        .what-we-do .stat-text {
            color: #777;
            font-size: 11px;
            font-weight: 400;
            line-height: 1.4;
            margin-top: 4px;
        }

    .work-image {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 3px;
    }

    .work-link {
        color: red;
        text-decoration: none;
        font-size: 14px;
        padding:10px 26px;
        font-weight: 600;
        display: inline-block;
        border:1px solid red;
        margin-top: 18px;
    }

        .work-link:hover{
         background:red;
         color:#fff;
        }

    /* ================= DIVIDER ================= */

    .red-divider {
        text-align: center;
        color: #ed001c;
        letter-spacing: 7px;
        font-size: 12px;
        margin: 0 auto;
    }

    /* ================= PROCESS ================= */

    .process-section {
        background: #f7f7f7;
    }

    .process-card {
        background: white;
        border: 1px solid #e5e5e5;
        padding: 30px;
        height: 100%;
        transition: .3s;
    }

        .process-card:hover {
            transform: translateY(-5px);
            border-color: #ed001c;
        }

    .process-number {
        color: #ed001c;
        font-size: 14px;
        font-weight: bold;
    }

    .process-card h4 {
        font-size: 21px;
        margin-top: 20px;
        font-weight: 700;
    }

    .process-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin-top: 12px;
    }

    /* ================= TECHNOLOGY ================= */
    .technology {
        padding: 80px 0;
        background: #f8fafc;
    }


    /* Technology Box */

    .technology-box {
        position: relative;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        font-size: 17px;
        font-weight: 600;
        color: #1e293b;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.35s ease;
    }


        /* Top Gradient Line */

        .technology-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 3px;
            background: linear-gradient( 90deg, #2563eb, #7c3aed );
            transition: width 0.35s ease;
        }


    /* Icon Circle */

    .technology-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #f1f5ff;
        color: #2563eb;
        font-size: 25px;
        transition: all 0.35s ease;
    }


    /* Hover */

    .technology-box:hover {
        transform: translateY(-8px);
        border-color: #c7d2fe;
        box-shadow: 0 15px 35px rgba(37, 99, 235, 0.12);
        background: #ffffff;
    }


        .technology-box:hover::before {
            width: 100%;
        }


        .technology-box:hover .technology-icon {
            transform: rotate(-5deg) scale(1.1);
            background: #2563eb;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
        }


    .technology-box span {
        transition: all 0.3s ease;
    }


    .technology-box:hover span {
        color: #2563eb;
    }
    /* ================= WHY US ================= */

    .why-section {
        background: #fff;
    }

    .why-box {
        padding: 25px 0;
    }

        .why-box h4 {
            font-size: 19px;
            font-weight: 700;
        }

        .why-box p {
            color: #777;
            font-size: 14px;
            line-height: 1.7;
            margin-top: 10px;
        }

    /* ================= TESTIMONIAL ================= */
    .testimonial {
        background: #dbd4d6;
        color: #141313;
        margin: 0;
        padding: 70px 60px;
        width: 100%;
        text-align: center;
    }

    .testimonial-text {
        color: #222;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.8;
        font-style: italic;
        max-width: 850px;
        margin: 0 auto;
    }

    .profile {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 28px;
    }

        .profile img {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 15px;
        }

    .profile-name {
        font-size: 14px;
        font-weight: 700;
        color: #111;
    }

    .profile-role {
        color: #777;
        font-size: 12px;
        font-weight: 400;
        margin-top: 3px;
    }


    /* ================= TESTIMONIAL RESPONSIVE ================= */

    @@media (max-width: 576px) {

        .testimonial {
            padding: 50px 25px;
        }

        .testimonial-text {
            font-size: 14px;
            line-height: 1.7;
        }

        .profile {
            margin-top: 22px;
        }

            .profile img {
                width: 48px;
                height: 48px;
                margin-right: 12px;
            }
    }

   
    /* ================= CTA ================= */

    .cta-section {
        background: #0d0d0d;
        padding: 85px 0;
        color: white;
        text-align: center;
    }

        .cta-section h2 {
            font-size: 42px;
            font-weight: 700;
        }

        .cta-section p {
            color: #999;
            font-size: 17px;
            margin-top: 12px;
        }

    .cta-buttons {
        margin-top: 25px;
    }

    .services-btn {
        color: white;
        border: 1px solid #555;
        padding: 13px 25px;
        text-decoration: none;
        margin-left: 8px;
    }

        .services-btn:hover {
            color: white;
            border-color: #ed001c;
        }

    /* ================= WHATSAPP ================= */

    .whatsapp {
        position: fixed;
        right: 27px;
        bottom: 25px;
        width: 49px;
        height: 49px;
        background: #20d366;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 25px;
        z-index: 1000;
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
    }

    /* ================= RESPONSIVE ================= */

    @@media(max - width: 991px) {
        .navbar {
            height: auto;
            padding: 12px 0;
        }

        .navbar-nav {
            margin-top: 15px;
        }

            .navbar-nav .nav-link {
                margin: 5px 0;
            }

        .consult-btn {
            display: inline-block;
            margin-top: 8px;
        }

        .hero h1 {
            font-size: 45px;
        }

        .work-image {
            margin-top: 40px;
        }
    }

    @@media(max - width: 576px) {
        .hero {
            padding: 40px 0 50px;
        }

            .hero h1 {
                font-size: 38px;
            }

        .hero-description {
            font-size: 16px;
        }

        .quote-btn,
        .process-btn {
            margin-bottom: 10px;
        }

        .section {
            padding: 60px 0;
        }

        .section-title {
            font-size: 32px;
        }

        .cta-section h2 {
            font-size: 32px;
        }

        .testimonial {
            padding: 30px 20px;
        }
    }
</style>


