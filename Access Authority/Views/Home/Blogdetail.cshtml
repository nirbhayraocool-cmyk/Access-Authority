@model Access_Authority.Models.CreateBlog

@{
    ViewData["Title"] = Model.Title;

    var recentPosts = ViewBag.RecentPosts as List<Access_Authority.Models.CreateBlog>;

    var plainText = System.Text.RegularExpressions.Regex.Replace(Model.Content ?? "", "<.*?>", " ");
    var wordCount = plainText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    var readingMinutes = Math.Max(1, (int)Math.Ceiling(wordCount / 200.0));

    var heroBg = !string.IsNullOrEmpty(Model.FeaturedImage)
        ? Model.FeaturedImage
        : "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1600&q=80";

    var fallbackThumb = "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=200&h=150&fit=crop";

    // Real share links for THIS article
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var encUrl = Uri.EscapeDataString(pageUrl);
    var encTitle = Uri.EscapeDataString(Model.Title ?? "");
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />

<style>
    :root {
        --brand: #ed102b;
        --brand-dark: #c60c22;
        --ink: #16181d;
        --body: #2c2f36;
        --muted: #6b7079;
        --line: #e6e7ea;
        --paper: #ffffff;
        --bg: #f3f4f6;
        --ui-font: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
        --read-font: "Source Serif 4", Georgia, "Times New Roman", serif;
    }

    .blog-page {
        background: var(--bg);
        min-height: 100vh;
        font-family: var(--ui-font);
    }

    /* ---------- Reading progress ---------- */
    .read-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0;
        background: var(--brand);
        z-index: 2000;
        transition: width .1s linear;
    }

    /* ---------- Hero ---------- */
    .blog-hero {
        position: relative;
        min-height: 220px;
        display: flex;
        align-items: flex-end;
        color: #fff;
        overflow: hidden;
        background: #14161a;
    }

    .blog-hero-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
    }

    .blog-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(180deg, rgba(10,11,14,.35) 0%, rgba(10,11,14,.55) 40%, rgba(10,11,14,.92) 100%);
    }

    .blog-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 20px 64px;
        width: 100%;
        box-sizing: border-box;
    }

    .blog-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
        font-size: 13px;
        font-weight: 500;
        color: rgba(255,255,255,.75);
    }

        .blog-breadcrumb a {
            color: rgba(255,255,255,.75);
            text-decoration: none;
        }

            .blog-breadcrumb a:hover {
                color: #fff;
                text-decoration: underline;
            }

        .blog-breadcrumb i {
            font-size: 10px;
            opacity: .6;
        }

        .blog-breadcrumb .current {
            color: #fff;
            max-width: 340px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .blog-hero .category {
        display: inline-block;
        padding: 6px 14px;
        margin-bottom: 20px;
        background: var(--brand);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        border-radius: 3px;
    }

    .blog-hero h1 {
        max-width: 840px;
        margin: 0;
        font-size: clamp(30px, 4.6vw, 50px);
        line-height: 1.12;
        font-weight: 800;
        letter-spacing: -1px;
        color: #fff;
        text-wrap: balance;
    }

    .blog-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px 26px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid rgba(255,255,255,.22);
    }

    .blog-meta-item {
        display: flex;
        align-items: center;
        gap: 9px;
        color: rgba(255,255,255,.88);
        font-size: 14px;
        font-weight: 500;
    }

        .blog-meta-item i {
            color: #fff;
            opacity: .7;
        }

    .author-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
    }

    /* ---------- Layout ---------- */
    .blog-wrapper {
        max-width: 1080px;
        margin: 0 auto;
        padding: 30px 0 72px;
    }

    .blog-main-row {
        align-items: flex-start;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
        padding: 9px 16px;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: background .2s, color .2s, border-color .2s;
    }

        .back-btn:hover {
            background:#ed102b;
            border-color: var(--ink);
            color: #fff;
        }

    /* ---------- Article ---------- */
    .blog-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
    }

    .blog-content {
        padding: 44px 48px 40px;
        font-family: var(--read-font);
        font-size: 18px;
        line-height: 1.8;
        color: var(--body);
        overflow-wrap: anywhere;
    }

        .blog-content p {
            margin: 0 0 1.35em;
        }

            /* first paragraph reads as the intro */
            .blog-content p:first-of-type {
                font-size: 20px;
                line-height: 1.7;
                color: var(--ink);
            }

        .blog-content h1,
        .blog-content h2,
        .blog-content h3,
        .blog-content h4,
        .blog-content h5,
        .blog-content h6 {
            font-family: var(--ui-font);
            color: var(--ink);
            font-weight: 800;
            line-height: 1.25;
            letter-spacing: -.4px;
            margin: 2em 0 .6em;
        }

        .blog-content h1 {
            font-size: 32px;
        }

        .blog-content h2 {
            font-size: 27px;
        }

        .blog-content h3 {
            font-size: 22px;
        }

        .blog-content h4 {
            font-size: 19px;
        }

        .blog-content h2 {
            padding-top: .9em;
            border-top: 1px solid var(--line);
        }

        .blog-content ul,
        .blog-content ol {
            padding-left: 1.4em;
            margin: 0 0 1.4em;
        }

        .blog-content li {
            margin-bottom: .5em;
            padding-left: .2em;
        }

            .blog-content li::marker {
                color: var(--brand);
                font-weight: 700;
            }

        .blog-content blockquote {
            margin: 2em 0;
            padding: 6px 0 6px 24px;
            border-left: 4px solid var(--brand);
            color: var(--ink);
            font-size: 21px;
            line-height: 1.6;
            font-style: italic;
        }

            .blog-content blockquote p:last-child {
                margin-bottom: 0;
            }

        .blog-content img {
            display: block;
            max-width: 100%;
            height: auto;
            border-radius: 6px;
            margin: 2em auto;
        }

        .blog-content a {
            color: var(--brand-dark);
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 3px;
            text-decoration-thickness: 1px;
        }

            .blog-content a:hover {
                text-decoration-thickness: 2px;
            }

        .blog-content pre {
            background: #14161a;
            color: #eceef2;
            padding: 18px 20px;
            border-radius: 6px;
            overflow-x: auto;
            font-size: 14px;
            line-height: 1.6;
        }

        .blog-content code {
            font-size: .9em;
        }

        .blog-content table {
            display: block;
            max-width: 100%;
            overflow-x: auto;
            border-collapse: collapse;
            margin: 2em 0;
            font-family: var(--ui-font);
            font-size: 15px;
        }

        .blog-content th,
        .blog-content td {
            padding: 10px 14px;
            border: 1px solid var(--line);
            text-align: left;
        }

        .blog-content th {
            background: #f7f7f8;
            color: var(--ink);
        }

        .blog-content strong {
            color: var(--ink);
        }

    /* ---------- Tags + share ---------- */
    .article-footer {
        margin-top: 44px;
        padding-top: 26px;
        border-top: 1px solid var(--line);
        font-family: var(--ui-font);
    }

    .footer-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        font-size: 14px;
        font-weight: 800;
        color: var(--ink);
    }

        .footer-label i {
            color: var(--brand);
        }

    .article-footer + .article-footer {
        margin-top: 28px;
    }

    .blog-tag {
        display: inline-block;
        padding: 6px 14px;
        margin: 0 8px 8px 0;
        background: #f4f5f7;
        border-radius: 999px;
        color: #3a3e46;
        font-size: 13px;
        font-weight: 600;
    }

    .share-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

        .share-buttons a,
        .share-buttons button {
            height: 40px;
            min-width: 40px;
            padding: 0 12px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            background: #f4f5f7;
            color: var(--ink);
            border: 0;
            border-radius: 999px;
            font: 700 13px var(--ui-font);
            text-decoration: none;
            cursor: pointer;
            transition: background .2s, color .2s;
        }

            .share-buttons a:hover,
            .share-buttons button:hover {
                background: var(--brand);
                color: #fff;
            }

            .share-buttons button.copied {
                background: #16a34a;
                color: #fff;
            }

    /* ---------- Sidebar ---------- */
    .sidebar-sticky {
        position: sticky;
        top: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .recent-posts-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 22px 22px 8px;
    }

    .recent-posts-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 14px;
        border-bottom: 2px solid var(--brand);
        margin-bottom: 4px;
    }

        .recent-posts-heading h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: -.2px;
        }

        .recent-posts-heading i {
            color: var(--brand);
            font-size: 18px;
        }

    .recent-post {
        display: flex;
        gap: 14px;
        padding: 16px 0;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
    }

        .recent-post:last-child {
            border-bottom: none;
        }

    .recent-post-thumb {
        width: 84px;
        height: 68px;
        flex-shrink: 0;
        border-radius: 5px;
        overflow: hidden;
        background: #e9eaee;
    }

    .recent-post-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .3s ease;
    }

    .recent-post:hover .recent-post-image {
        transform: scale(1.06);
    }

    .recent-post-content {
        min-width: 0;
    }

    .recent-post-category {
        display: block;
        color: var(--brand-dark);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .recent-post-content h3 {
        color: var(--ink);
        font-size: 14px;
        line-height: 1.4;
        font-weight: 700;
        margin: 0 0 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color .2s;
    }

    .recent-post:hover .recent-post-content h3 {
        color: var(--brand-dark);
    }

    .recent-post-date {
        color: var(--muted);
        font-size: 12px;
    }

    /* ---------- Accessibility ---------- */
    .back-btn:focus-visible,
    .recent-post:focus-visible,
    .share-buttons a:focus-visible,
    .share-buttons button:focus-visible,
    .blog-breadcrumb a:focus-visible {
        outline: 3px solid var(--brand);
        outline-offset: 2px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .read-progress,
        .recent-post-image {
            transition: none;
        }
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 991px) {
        .blog-wrapper {
            max-width: 94%;
        }

        .sidebar-sticky {
            position: static;
        }

        .blog-hero {
            min-height: 420px;
        }
    }

    @@media (max-width: 768px) {
        .blog-hero {
            min-height: 360px;
        }

        .blog-hero-inner {
            padding: 0 16px 40px;
        }

        .blog-breadcrumb .current {
            max-width: 180px;
        }

        .blog-meta {
            gap: 8px 20px;
            margin-top: 20px;
            padding-top: 16px;
        }

        .blog-content {
            padding: 28px 22px 26px;
            font-size: 17px;
        }

            .blog-content p:first-of-type {
                font-size: 18px;
            }

            .blog-content h2 {
                font-size: 23px;
            }

            .blog-content h3 {
                font-size: 20px;
            }

            .blog-content blockquote {
                font-size: 18px;
            }
    }
</style>

<div class="read-progress" id="readProgress" aria-hidden="true"></div>

<div class="blog-page">

    <!-- BLOG HERO -->
    <header class="blog-hero">

        <img src="@heroBg" class="blog-hero-img" alt="" />

        <div class="blog-hero-inner">

            <nav class="blog-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <a asp-controller="Home" asp-action="Blog">Blog</a>
                <i class="bi bi-chevron-right"></i>
                <span class="current">@Model.Title</span>
            </nav>

            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <span class="category">@Model.Category</span>
            }

            <h1>@Model.Title</h1>

            <div class="blog-meta">

                <div class="blog-meta-item">
                    <div class="author-avatar">A</div>
                    Admin
                </div>

                <div class="blog-meta-item">
                    <i class="bi bi-calendar3"></i>
                    @Model.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy")
                </div>

                <div class="blog-meta-item">
                    <i class="bi bi-clock"></i>
                    @readingMinutes min read
                </div>

            </div>

        </div>

    </header>


    <!-- MAIN BLOG AREA -->
    <div class="container px-3 px-md-5">

        <div class="blog-wrapper">

            <a asp-controller="Home" asp-action="Blog" class="back-btn">
                <i class="bi bi-arrow-left"></i>
                Back to blog
            </a>

            <div class="row g-4 blog-main-row">

                <!-- LEFT : ARTICLE -->
                <div class="col-lg-8">

                    <article class="blog-card" id="articleBody">

                        <div class="blog-content">

                            @Html.Raw(Model.Content)

                            @if (!string.IsNullOrEmpty(Model.Tags))
                            {
                                <div class="article-footer">
                                    <div class="footer-label">
                                        <i class="bi bi-tags"></i>
                                        Tags
                                    </div>

                                    <div>
                                        @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="blog-tag">#@tag</span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="article-footer">
                                <div class="footer-label">
                                    <i class="bi bi-share"></i>
                                    Share this article
                                </div>

                                <div class="share-buttons">
                                    <a href="https://www.facebook.com/sharer/sharer.php?u=@encUrl" target="_blank" rel="noopener" aria-label="Share on Facebook"><i class="bi bi-facebook"></i></a>
                                    <a href="https://twitter.com/intent/tweet?url=@encUrl&text=@encTitle" target="_blank" rel="noopener" aria-label="Share on X"><i class="bi bi-twitter-x"></i></a>
                                    <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encUrl" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><i class="bi bi-linkedin"></i></a>
                                    <a href="https://wa.me/?text=@encTitle%20@encUrl" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><i class="bi bi-whatsapp"></i></a>
                                    <button type="button" id="copyLinkBtn" data-url="@pageUrl">
                                        <i class="bi bi-link-45deg"></i>
                                        <span>Copy link</span>
                                    </button>
                                </div>
                            </div>

                        </div>

                    </article>

                </div>


                <!-- RIGHT : SIDEBAR -->
                <div class="col-lg-4">

                    <div class="sidebar-sticky">

                        <aside class="recent-posts-card" aria-labelledby="recentHeading">

                            <div class="recent-posts-heading">
                                <h2 id="recentHeading">Recent posts</h2>
                                <i class="bi bi-journal-text"></i>
                            </div>

                            @if (recentPosts != null && recentPosts.Any())
                            {
                                foreach (var recent in recentPosts)
                                {
                                    <a asp-controller="Home"
                                       asp-action="Blogdetail"
                                       asp-route-id="@recent.Id"
                                       class="recent-post">

                                        <div class="recent-post-thumb">
                                            <img src="@(string.IsNullOrEmpty(recent.FeaturedImage) ? fallbackThumb : recent.FeaturedImage)"
                                                 class="recent-post-image"
                                                 loading="lazy"
                                                 alt="" />
                                        </div>

                                        <div class="recent-post-content">
                                            @if (!string.IsNullOrEmpty(recent.Category))
                                            {
                                                <span class="recent-post-category">@recent.Category</span>
                                            }

                                            <h3>@recent.Title</h3>

                                            <div class="recent-post-date">
                                                @recent.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                            </div>
                                        </div>

                                    </a>
                                }
                            }
                            else
                            {
                                <div class="py-3">
                                    <span class="text-muted small">No recent posts available.</span>
                                </div>
                            }

                        </aside>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    (function () {
        // Reading progress bar
        var bar = document.getElementById('readProgress');
        var article = document.getElementById('articleBody');
        function updateProgress() {
            if (!bar || !article) return;
            var rect = article.getBoundingClientRect();
            var total = rect.height - window.innerHeight;
            var done = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
            bar.style.width = (total > 0 ? (done / total) * 100 : 100) + '%';
        }
        window.addEventListener('scroll', updateProgress, { passive: true });
        window.addEventListener('resize', updateProgress);
        updateProgress();

        // Copy link
        var btn = document.getElementById('copyLinkBtn');
        if (btn) {
            btn.addEventListener('click', function () {
                var url = btn.getAttribute('data-url');
                var label = btn.querySelector('span');
                function ok() {
                    btn.classList.add('copied');
                    label.textContent = 'Link copied';
                    setTimeout(function () {
                        btn.classList.remove('copied');
                        label.textContent = 'Copy link';
                    }, 2000);
                }
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url).then(ok);
                } else {
                    var t = document.createElement('textarea');
                    t.value = url;
                    document.body.appendChild(t);
                    t.select();
                    document.execCommand('copy');
                    document.body.removeChild(t);
                    ok();
                }
            });
        }
    })();
</script>
