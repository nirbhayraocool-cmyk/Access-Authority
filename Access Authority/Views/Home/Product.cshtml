
@{
    
    ViewData["Title"] = "Product";
}

    <style>
         .page-hero-custom {
            background: #f7f7f7;
            padding: 55px 0 40px;
            border-bottom: 1px solid #eaeaea;
        }

           .page-hero-custom .breadcrumb-custom {
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.8px;
                color: #999;
                margin-bottom: 14px;
            }

        .page-hero-custom .breadcrumb-custom a {
                    color: #fff;
                    text-decoration: none;
                    transition: color 0.2s;
                }

                   .page-hero-custom .breadcrumb-custom a:hover {
                        color: #ed0026;
                    }

                .page-hero-custom .breadcrumb-custom .separator {
                    color: #ccc;
                    margin: 0 8px;
                }

                .page-hero-custom .breadcrumb-custom .active {
                    color: #ed0026;
                }

            .page-hero-custom h1 {
                font-size: 38px;
                font-weight: 800;
                color: #fff;
                margin: 0 0 6px 0;
                letter-spacing: -0.5px;
            }

                .page-hero-custom h1 span {
                    color: #ed0026;
                }

            .page-hero-custom .subtitle {
                font-size: 14px;
                color: #555;
                margin: 0;
                max-width: 520px;
                line-height: 1.6;
            }

        /* Mini Stats */
        .mini-stats-custom {
            background: #0b0b0b;
            color: #fff;
            padding: 22px 0;
            border-bottom: 1px solid #202020;
        }

            .mini-stats-custom .stat-block {
                border-right: 1px solid #292929;
                padding: 5px 15px;
                text-align: center;
            }

                .mini-stats-custom .stat-block:last-child {
                    border-right: none;
                }

            .mini-stats-custom .stat-number {
                color: #ed0026;
                font-size: 28px;
                font-weight: 700;
                line-height: 1;
            }

                .mini-stats-custom .stat-number .suffix {
                    color: #ed0026;
                }

            .mini-stats-custom .stat-label {
                color: #686868;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 0.8px;
                margin-top: 5px;
            }

        /* Product Cards */
        .product-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            padding: 28px 26px 26px;
            transition: all 0.3s ease;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

            .product-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: #ed0026;
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.4s ease;
            }

            .product-card:hover::before {
                transform: scaleX(1);
            }

            .product-card:hover {
                border-color: #ed0026;
                transform: translateY(-4px);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
            }

            .product-card .product-badge {
                display: inline-block;
                font-size: 8px;
                font-weight: 700;
                color: #ed0026;
                background: #fdecee;
                padding: 2px 14px;
                letter-spacing: 1px;
                text-transform: uppercase;
                margin-bottom: 12px;
            }

            .product-card .product-icon {
                width: 52px;
                height: 52px;
                background: #fdecee;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ed0026;
                font-size: 24px;
                margin-bottom: 14px;
                transition: all 0.3s ease;
            }

            .product-card:hover .product-icon {
                background: #ed0026;
                color: #fff;
                transform: scale(1.06);
            }

            .product-card h3 {
                font-size: 18px;
                font-weight: 700;
                color: #111;
                margin: 0 0 4px 0;
            }

            .product-card .product-tagline {
                font-size: 12px;
                color: #ed0026;
                font-weight: 600;
                margin-bottom: 10px;
            }

            .product-card p {
                font-size: 12px;
                color: #555;
                line-height: 1.7;
                margin: 0 0 14px 0;
            }

            .product-card .feature-list {
                list-style: none;
                padding: 0;
                margin: 0 0 16px 0;
            }

                .product-card .feature-list li {
                    font-size: 11px;
                    color: #333;
                    padding: 4px 0;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                    .product-card .feature-list li i {
                        color: #ed0026;
                        font-size: 10px;
                    }

            .product-card .product-actions {
                display: flex;
                align-items: center;
                gap: 14px;
                padding-top: 14px;
                border-top: 1px solid #eee;
                flex-wrap: wrap;
            }

            .product-card .btn-demo {
                background: #ed0026;
                color: #fff;
                padding: 6px 18px;
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
                clip-path: polygon(0 0, 94% 0, 100% 25%, 100% 100%, 6% 100%, 0 75%);
                transition: background 0.2s;
            }

                .product-card .btn-demo:hover {
                    background: #c9001f;
                    color: #fff;
                }

            .product-card .btn-learn {
                color: #111;
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 4px;
                transition: color 0.2s;
            }

                .product-card .btn-learn:hover {
                    color: #ed0026;
                }

                .product-card .btn-learn i {
                    font-size: 12px;
                    transition: transform 0.2s;
                }

                .product-card .btn-learn:hover i {
                    transform: translateX(4px);
                }

        /* Why Products */
        .why-products-section {
            background: #f7f7f7;
            padding: 60px 0;
        }

        .why-product-card {
            background: #ffffff;
            padding: 28px 24px;
            border: 1px solid #e5e7eb;
            text-align: center;
            transition: all 0.3s ease;
            height: 100%;
        }

            .why-product-card:hover {
                border-color: #ed0026;
                transform: translateY(-4px);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
            }

            .why-product-card .why-icon {
                width: 48px;
                height: 48px;
                margin: 0 auto 14px;
                background: #fdecee;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ed0026;
                font-size: 20px;
                transition: all 0.3s ease;
            }

            .why-product-card:hover .why-icon {
                background: #ed0026;
                color: #fff;
                transform: scale(1.06);
            }

            .why-product-card h4 {
                font-size: 15px;
                font-weight: 700;
                color: #111;
                margin: 0 0 6px 0;
            }

            .why-product-card p {
                font-size: 12px;
                color: #555;
                line-height: 1.7;
                margin: 0;
            }

        /* Compare Table */
        .compare-section {
            background: #ffffff;
            padding: 60px 0;
        }

        .compare-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

            .compare-table th,
            .compare-table td {
                padding: 14px 18px;
                text-align: center;
                border: 1px solid #e5e7eb;
            }

            .compare-table th {
                background: #f7f7f7;
                font-weight: 700;
                color: #111;
                font-size: 13px;
            }

                .compare-table th:first-child {
                    text-align: left;
                    background: transparent;
                    font-size: 12px;
                    color: #555;
                }

            .compare-table td:first-child {
                text-align: left;
                font-weight: 600;
                color: #333;
                font-size: 12px;
            }

            .compare-table .check {
                color: #ed0026;
                font-size: 18px;
            }

            .compare-table .cross {
                color: #ccc;
                font-size: 18px;
            }

            .compare-table .highlight {
                background: #fdecee;
            }

        /* Responsive */
        @@media (max-width: 991px) {
            .page-hero-custom h1 {
                font-size: 30px;
            }

            .mini-stats-custom .stat-block {
                border-right: none;
                padding: 5px 8px;
            }

            .compare-table {
                font-size: 10px;
            }

                .compare-table th,
                .compare-table td {
                    padding: 10px 12px;
                }
        }

        @@media (max-width: 575px) {
            .page-hero-custom {
                padding: 35px 0 25px;
            }

                .page-hero-custom h1 {
                    font-size: 24px;
                }

                .page-hero-custom .subtitle {
                    font-size: 12px;
                }

            .mini-stats-custom .stat-number {
                font-size: 22px;
            }

            .product-card {
                padding: 20px 16px;
            }

                .product-card h3 {
                    font-size: 16px;
                }

            .compare-table {
                font-size: 9px;
            }

                .compare-table th,
                .compare-table td {
                    padding: 8px 6px;
                }

                .compare-table .check,
                .compare-table .cross {
                    font-size: 14px;
                }
        }
    </style>
