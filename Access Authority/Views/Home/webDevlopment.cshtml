        linear-gradient(
            110deg,
            #0b090a 0%,
            #11090b 55%,
            #12090b 100%
        );
    color: #fff;
    padding: 60px 0 65px;
}

.back-link {
    color: #ed001c;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
}

.back-link:hover {
    color: #ff3348;
}

.hero-icon {
    margin-top: 15px;
    width: 70px;
    height: 70px;
    background: #20090d;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(
        0 0,
        82% 0,
        100% 20%,
        100% 100%,
        20% 100%,
        0 80%
    );
}

.hero-icon i {
    color: #ed001c;
    font-size: 31px;
}

.hero h1 {
    font-size: 52px;
    font-weight: 700;
    margin-top: 20px;
    margin-bottom: 0;
    line-height: 1.1;
    letter-spacing: -0.7px;
}

.hero h1 span {
    color: #ed001c;
}

.hero-description {
    color: #a2a2a2;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.7;
