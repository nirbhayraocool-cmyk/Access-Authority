}

.consultation-btn:hover {
    background: #c90018;
    border-color: #c90018;
    color: #fff;
    transform: translateY(-1px);
}

.work-btn {
    background: transparent;
    color: #fff;
    border: 1px solid #555;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 2px;
    transition: all 0.25s ease;
}

.work-btn:hover {
    color: #fff;
    border-color: #ed001c;
    background: rgba(237, 0, 28, 0.08);
}


/* =========================================================
   COMMON SECTIONS
========================================================= */

