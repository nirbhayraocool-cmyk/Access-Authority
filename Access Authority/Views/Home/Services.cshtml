
@{
    ViewData["Title"] = "Services";
}
<style>


    .page-hero-custom {
        background: #f7f7f7;
        padding: 55px 0 40px;
        border-bottom: 1px solid #eaeaea;
    }

        .page-hero-custom .breadcrumb-custom {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.8px;
            color: #999;
            margin-bottom: 14px;
        }

            .page-hero-custom .breadcrumb-custom a {
                color: #fff;
                text-decoration: none;
                transition: color 0.2s;
            }

                .page-hero-custom .breadcrumb-custom a:hover {
                    color: #ed0026;
                }

            .page-hero-custom .breadcrumb-custom .separator {
                color: #ccc;
                margin: 0 8px;
            }

            .page-hero-custom .breadcrumb-custom .active {
                color: #ed0026;
            }

        .page-hero-custom h1 {
            font-size: 38px;
            font-weight: 800;
            color: #fff;
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

            .page-hero-custom h1 span {
                color: #ed0026;
            }

        .page-hero-custom .subtitle {
            font-size: 14px;
            color: #555;
            margin: 0;
            max-width: 520px;
            line-height: 1.6;
        }

    /* Mini Stats */
    .mini-stats-custom {
        
        color: #fff;
        padding: 22px 0;
        border-bottom: 1px solid #202020;
    }

        .mini-stats-custom .stat-block {
            border-right: 1px solid #292929;
            padding: 5px 15px;
            text-align: center;
        }

            .mini-stats-custom .stat-block:last-child {
                border-right: none;
            }

        .mini-stats-custom .stat-number {
            color: #ed0026;
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

            .mini-stats-custom .stat-number .suffix {
                color: #ed0026;
            }

        .mini-stats-custom .stat-label {
            color: #686868;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.8px;
            margin-top: 5px;
        }

    /* Service card polish */
    .service-card-enhanced {
        min-height: 195px;
        background: #fff;
        border-right: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        padding: 24px 22px 22px;
        position: relative;
        transition: transform .3s ease, box-shadow .3s ease, background .3s ease;
    }

        .service-card-enhanced:hover {
            background: #fff;
            border-left: 2px solid #ed0026;
            z-index: 5;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        }

        .service-card-enhanced .service-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff0f2;
            color: #ed0026;
            margin-bottom: 14px;
            transition: background .3s ease, color .3s ease, transform .3s ease;
        }

        .service-card-enhanced:hover .service-icon {
            background: #ed0026;
            color: #fff;
            transform: scale(1.06);
        }

        .service-card-enhanced .service-icon i {
            font-size: 17px;
        }

        .service-card-enhanced .service-badge {
            font-size: 8px;
            font-weight: 700;
            color: #ed0026;
            background: #fdecee;
            padding: 2px 12px;
            display: inline-block;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .service-card-enhanced h3 {
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 8px;
            color: #111;
        }

        .service-card-enhanced p {
            font-size: 11px;
            line-height: 1.7;
            color: #333;
            max-width: 290px;
            margin: 0 0 10px;
        }

        .service-card-enhanced .feature-list {
            list-style: none;
            padding: 0;
            margin: 0 0 14px 0;
        }

            .service-card-enhanced .feature-list li {
                font-size: 11px;
                color: #333;
                padding: 3px 0;
                display: flex;
                align-items: center;
                gap: 7px;
            }

                .service-card-enhanced .feature-list li i {
                    color: #ed0026;
                    font-size: 10px;
                }

        .service-card-enhanced .service-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            padding-top: 12px;
            border-top: 1px solid #eee;
        }

        .service-card-enhanced .btn-get-started {
            background: #ed0026;
            color: #fff;
            padding: 6px 18px;
            font-size: 10px;
            font-weight: 700;
            text-decoration: none;
            clip-path: polygon(0 0, 94% 0, 100% 25%, 100% 100%, 6% 100%, 0 75%);
            transition: background 0.2s;
        }

            .service-card-enhanced .btn-get-started:hover {
                background: #c9001f;
                color: #fff;
            }

        .service-card-enhanced .service-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #ed0026;
            text-decoration: none;
            font-size: 10px;
            font-weight: 700;
            opacity: 0;
            transform: translateY(5px);
            transition: opacity .3s ease, transform .3s ease;
        }

        .service-card-enhanced:hover .service-link {
            opacity: 1;
            transform: translateY(0);
        }

        .service-card-enhanced .service-link i {
            font-size: 11px;
            transition: transform 0.2s;
        }

        .service-card-enhanced .service-link:hover i {
            transform: translateX(4px);
        }

    /* Why card polish */
    .why-card-enhanced {
        position: relative;
        min-height: 167px;
        padding: 29px 22px 25px;
        border-right: 1px solid #222;
        border-bottom: 1px solid #222;
        background: transparent;
        overflow: hidden;
        transition: background .35s ease, transform .35s ease;
    }

        .why-card-enhanced::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: 0;
            height: 2px;
            background: #ed0026;
            transform: translateX(-50%);
            transition: width .45s ease;
        }

        .why-card-enhanced:hover {
            background: #21191b;
            transform: translateY(-2px);
        }

            .why-card-enhanced:hover::before {
                width: 100%;
            }

        .why-card-enhanced .why-number {
            color: #ed0026;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 13px;
        }

        .why-card-enhanced h3 {
            margin: 0 0 11px;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
        }

        .why-card-enhanced p {
            margin: 0;
            color: #8f8f8f;
            font-size: 11px;
            line-height: 1.7;
            max-width: 310px;
        }

    /* Testimonial polish */
    .testimonial-enhanced {
        background: #f7f7f7;
        padding: 38px 42px;
        border-left: 4px solid #ed0026;
        border-radius: 2px;
        transition: box-shadow 0.3s ease;
    }

        .testimonial-enhanced:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        }

        .testimonial-enhanced .quote-icon {
            font-size: 42px;
            color: #ed0026;
            opacity: 0.12;
            line-height: 1;
            margin-bottom: 4px;
        }

        .testimonial-enhanced blockquote {
            font-size: 17px;
            font-weight: 400;
            color: #111;
            line-height: 1.7;
            margin: 0 0 18px 0;
        }

        .testimonial-enhanced .client-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #ed0026;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            flex-shrink: 0;
        }

        .testimonial-enhanced .client-name {
            font-size: 14px;
            font-weight: 700;
            color: #111;
            margin: 0;
        }

        .testimonial-enhanced .client-title {
            font-size: 12px;
            color: #777;
            margin: 0;
        }

    /* Responsive */
    @@media (max-width: 991px) {
        .page-hero-custom h1

    {
        font-size: 30px;
    }

    .mini-stats-custom .stat-block {
        border-right: none;
        padding: 5px 8px;
    }

    .service-card-enhanced {
        border: 1px solid #ddd !important;
        margin-bottom: 10px;
        min-height: auto;
    }

        .service-card-enhanced .service-link {
            opacity: 1;
            transform: none;
        }

    .why-card-enhanced {
        min-height: auto;
        border: 1px solid #222 !important;
        margin-bottom: 8px;
    }

    .testimonial-enhanced {
        padding: 25px 20px;
    }

    }

    @@media (max-width: 575px) {
        .page-hero-custom

    {
        padding: 35px 0 25px;
    }

    .page-hero-custom h1 {
        font-size: 24px;
    }

    .page-hero-custom .subtitle {
        font-size: 12px;
    }

    .mini-stats-custom .stat-number {
        font-size: 22px;
    }

    .testimonial-enhanced blockquote {
        font-size: 14px;
    }

    .service-card-enhanced .service-actions {
        flex-wrap: wrap;
    }

    }
</style>


    <section class="page-hero-custom bg-black">

